/* components/ticket-card/index.wxss */
/* M4.5：左滑容器（原卡片外边距上移到容器） */
.swipe-root {
  position: relative;
  margin: 0 32rpx 26rpx;
  border-radius: 28rpx;
}

/* 快捷动作层：藏在卡片下，右滑露出 */
.sw-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
}
.sw-act {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.sw-act:first-child { border-radius: 28rpx 0 0 28rpx; }
.sw-act:last-child { border-radius: 0 28rpx 28rpx 0; }
.sw-act.card-act { background: #E0532F; } /* 4.9.7 固定品牌橘红：B 下 var(--accent) 变亮粉会吞白字 */
.sw-act.del-act { background: #C94424; }
.sw-i { font-size: 34rpx; line-height: 1.1; }
.sw-t {
  font-size: 18rpx;
  color: #FFF7EA;
  letter-spacing: 2rpx;
}

.ticket {
  position: relative;
  display: flex;
  background: var(--card, #FFFDF8);
  border-radius: var(--r-card, 28rpx);
  overflow: visible;
  box-shadow: var(--card-shadow, 0 6rpx 18rpx rgba(44, 44, 44, 0.08));
  transition: transform 250ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 150ms ease-out;
}
/* 4.10：首卡胶带（A 米黄 / C 蜜桃 / B 透明隐藏），压在票卡顶部 */
.tape {
  position: absolute;
  top: -16rpx;
  left: 50%;
  width: 190rpx;
  height: 38rpx;
  margin-left: -95rpx;
  background: var(--tape, transparent);
  transform: rotate(-2deg);
  z-index: 3;
  border-radius: 6rpx;
  opacity: 0.9;
  pointer-events: none;
}
/* 4.10：类型标签 → 细描边印文章（rotate 手盖感，字色区分类型） */
.tag {
  display: inline-block;
  font-size: 18rpx;
  line-height: 1;
  padding: 7rpx 13rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--line-strong, #D4C8B8);
  letter-spacing: 2rpx;
  transform: rotate(-2deg);
  background: transparent;
}
.tag-show   { color: var(--accent, #C4623A); }
.tag-movie  { color: var(--blue, #4A6A7A); }
.tag-traffic{ color: var(--gold-deep, #96713A); }
/* 跟手拖动中：去掉过渡，transform 即时响应 */
.ticket.dragging { transition: box-shadow 150ms ease-out; }
/* M4.5 按压反馈：微缩 + 阴影染上强调色 */
.t-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(var(--accent-rgb), 0.15);
}

/* 撕票线打孔：用页面底色圆盖住卡片左右边缘，制造「撕裂缺口」 */
.hole {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--paper, #F4EFE6);
  top: 50%;
  margin-top: -15rpx;
  z-index: 2;
  box-shadow: inset 0 3rpx 6rpx rgba(43, 36, 32, 0.08);
}
.hole-l { left: -15rpx; }
.hole-r { right: -15rpx; }

/* 左：票面 */
.t-main {
  flex: 1;
  padding: 26rpx 8rpx 24rpx 30rpx;
  min-width: 0;
}
.t-title {
  font-size: 33rpx;
  margin: 14rpx 0 10rpx;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.t-meta {
  font-size: 21rpx;
  color: var(--ink-soft, #6B5F52);
  line-height: 1.7;
}
.t-ai {
  font-size: 20rpx;
  color: var(--accent, #E0532F);
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}
.t-enh {
  font-size: 20rpx;
  color: var(--gold-deep, #8A6D2F);
  margin-top: 14rpx;
}

/* 右：副券（虚线撕开） */
.t-stub {
  width: 168rpx;
  border-left: 3rpx dashed var(--line, #E5DCCB);
  background: var(--stub-bg, #FBF6EB);
  border-radius: 0 28rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 14rpx;
}
.t-stub .date {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink, #2B2420);
  letter-spacing: 2rpx;
}
.t-stub .seat {
  font-size: 18rpx;
  color: var(--ink-soft, #6B5F52);
  letter-spacing: 1rpx;
}
.barcode.sm { width: 112rpx; height: 26rpx; opacity: 0.7; }

/* —— M4.8 列表入场：卡片依次浮现（delay 由 stagger 属性传入） —— */
.card-in { animation: card-in 320ms cubic-bezier(0.32, 0.72, 0, 1) both; }
@keyframes card-in {
  from { opacity: 0; transform: translateY(14rpx) scale(0.985); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* —— 4.14.0 整理模式：浮起态与让位过渡 —— */
.swipe-root.lifted {
  z-index: 60;
  box-shadow: 0 18rpx 50rpx rgba(33, 28, 21, 0.30);
}
.swipe-root.shifting {
  transition: transform 200ms var(--ease-smooth);
}
