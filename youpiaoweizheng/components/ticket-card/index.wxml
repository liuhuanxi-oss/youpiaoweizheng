<view
  class="swipe-root card-in {{reorder ? 'reorderable' : ''}} {{lifted ? 'lifted' : ''}} {{reorder && !lifted && offset ? 'shifting' : ''}}"
  style="animation-delay: {{stagger}}; transform: translateX({{swipeX}}px) {{reorder ? 'translateY(' + (lifted ? dragDy : offset) + 'px)' + (lifted ? ' scale(1.04)' : '') : ''}} rotate({{reorder ? 0 : tilt}}deg)"
  bind:touchstart="onTS" bind:touchmove="onTM" bind:touchend="onTE" bind:touchcancel="onTE" bindlongpress="onLongPress"
>
  <!-- 左滑露出的快捷动作（藏在卡片下层，右侧常驻） -->
  <view class="sw-actions">
    <view class="sw-act card-act" catchtap="onCardAct">
      <text class="sw-i">🎴</text><text class="sw-t">卡片</text>
    </view>
    <view class="sw-act del-act" catchtap="onDelAct">
      <text class="sw-i">🗑️</text><text class="sw-t">删除</text>
    </view>
  </view>

  <view class="ticket {{dragging ? 'dragging' : ''}}" style="transform: translateX({{swipeX}}px) rotate({{tilt}}deg)" hover-class="t-hover" hover-stay-time="120" bindtap="onTap">
    <!-- 4.10：首卡胶带（拟物固定贴纸，B 主题 var(--tape) 透明自动隐藏） -->
    <view class="tape" wx:if="{{tape}}"></view>
    <!-- 撕票线两侧的打孔（背景色圆盖在卡片边缘） -->
    <view class="hole hole-l"></view>
    <view class="hole hole-r"></view>

    <!-- 左：票面主体 -->
    <view class="t-main">
      <text class="tag tag-{{ticket.type}}">{{ticket.typeText}}</text>
      <view class="t-title serif">{{ticket.title}}</view>
      <view class="t-meta">
        {{stubDate}} {{ticket.weekday}} {{ticket.time}} · {{ticket.venue}}
      </view>
      <view class="t-meta" wx:if="{{ticket.seat}}">{{ticket.seat}}<text wx:if="{{ticket.note}}" decode="{{false}}"> · {{ticket.note}}</text></view>
      <view class="t-ai" wx:if="{{ticket.aiCaption}}">✦ AI 纪念文案已生成</view>
      <view class="t-enh" wx:elif="{{ticket.note === '老票有些褪色'}}">✧ 已做图像增强</view>
    </view>

    <!-- 右：副券 -->
    <view class="t-stub">
      <view class="date">{{stubDate}}</view>
      <view class="seat" wx:if="{{ticket.seat}}">{{ticket.seatShort}}</view>
      <view class="barcode sm"></view>
    </view>
  </view>
</view>
