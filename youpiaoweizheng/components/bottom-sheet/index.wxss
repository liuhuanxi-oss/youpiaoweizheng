/* components/bottom-sheet/index.wxss */
.bs {
  position: fixed;
  inset: 0;
  z-index: 900;
}

/* —— 遮罩 —— */
.bs-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  animation: bs-fade 200ms ease-out;
}
.bs-mask.out { animation: bs-fadeout 200ms ease-out forwards; }

/* —— 面板 —— */
.bs-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* 4.9.7：固定米白 → 卡片变量（B 深色主题下弹层变深底，标题不再白字隐形） */
  background: var(--sheet, #FFFEF7);
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 32rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: bs-in 300ms cubic-bezier(0.32, 0.72, 0, 1);
}
.bs-panel.out {
  animation: bs-out 250ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
}

/* —— 拖拽手柄 —— */
.bs-grip {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 6rpx;
}
.bs-bar {
  width: 64rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--line-strong, #D4C8B8);
}

/* —— 标题 —— */
.bs-title {
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--ink, #2B2420);
  text-align: center;
  padding: 6rpx 0 18rpx;
}

/* —— 内容区（超高内部滚动） —— */
.bs-body {
  overflow-y: auto;
  min-height: 0;
}

@keyframes bs-in  { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes bs-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes bs-fade    { from { opacity: 0; } to { opacity: 1; } }
@keyframes bs-fadeout { from { opacity: 1; } to { opacity: 0; } }
