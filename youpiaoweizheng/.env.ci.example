# ============================================================
# 有票为证 CI 环境变量模板
# 用法：复制本文件为 .env，填入真实值；.env 已被 .gitignore 忽略，绝不入库
# ============================================================

# ---- 小程序基础信息 ----
# AppID（已知，无需改）
WX_APPID=wx42ef98dfb4ecab23
# AppSecret：微信公众平台 → 开发管理 → 开发设置 → AppSecret(生成后只显示一次)
WX_APPSECRET=请填写
# 小程序代码上传密钥文件路径：公众平台 → 开发管理 → 开发设置 → 小程序代码上传密钥 下载
# 建议放到项目外或 secret/ 目录（已被 gitignore）
WX_PRIVATE_KEY_PATH=./secret/private.wx42ef98dfb4ecab23.key

# ---- 云开发 ----
# 云开发环境ID（已知）
TCB_ENV_ID=cloud1-d5gpnyzjw64a60ac7
# 腾讯云API密钥：腾讯云控制台 → 访问管理CAM → API密钥管理（用于CI非交互部署云函数）
TCB_SECRET_ID=请填写
TCB_SECRET_KEY=请填写
# 需要部署的云函数，逗号分隔；留空=自动部署 cloudfunctions/ 下全部
TCB_FUNCTIONS=recognizeTicket,saveTicket

# ---- 上传版本 ----
# 上传版本号，必须为 数字.数字.数字；留空则取 package.json 的 version
UPLOAD_VERSION=
# 上传备注（会拼上时间与git提交）
UPLOAD_REMARK=自动化上传
# miniprogram-ci 机器人编号 1~30，用于区分不同来源（1=本地豆包，2=CI流水线）
CI_ROBOT=1

# ---- 提审 ----
# 提审类目ID（公众平台「设置-基本设置-服务类目」里已配置类目的id，首次提审建议先在后台手动提一次确认）
AUDIT_CATEGORY_ID=
# 提审版本描述（对外不可见，给审核员看）
AUDIT_DESC=
# 审核通过后是否自动发布：true=全自动；false=只通知，人工执行 npm run release（推荐首阶段用false）
AUTO_RELEASE=false

# ---- 通知（可选）----
# 企业微信群机器人 webhook，用于上传/提审/审核结果通知；不用就留空
NOTIFY_WEBHOOK=
