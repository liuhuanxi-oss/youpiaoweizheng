<view class="page theme-{{theme}} fade-up">


  <!-- 4.10.1 重装饰层：纸面噪点（全主题）/ C 水彩晕染头 -->
  <view class="grain"></view>
  <!-- ===== 足迹地图 ===== -->
  <view class="map-wrap">
    <map
      id="theMap"
      class="the-map"
      markers="{{markers}}"
      polyline="{{polyline}}"
      include-points="{{focusPts}}"
      enable-poi="{{true}}"
      show-compass="{{false}}"
      show-scale="{{false}}"
    ></map>

    <!-- 统计浮牌 -->
    <view class="stat-bar card" wx:if="{{ticketCount > 0}}">
      <view class="sb"><view class="n serif">{{totalKm}}</view><view class="k">足迹 km</view></view>
      <view class="sb"><view class="n serif">{{cities.length}}</view><view class="k">座城市</view></view>
      <view class="sb"><view class="n serif">{{ticketCount}}</view><view class="k">张票根</view></view>
    </view>
  </view>

  <!-- ===== 城市筛选 ===== -->
  <scroll-view scroll-x class="city-chips" enhanced show-scrollbar="{{false}}" wx:if="{{cities.length}}">
    <view
      wx:for="{{cities}}"
      wx:key="name"
      class="chip pressable {{activeCity === item.name ? 'on' : ''}}"
      hover-class="press-hover"
      bindtap="onCityTap"
      data-name="{{item.name}}"
    >📍{{item.name}} · {{item.count}}</view>
  </scroll-view>

  <!-- ===== 选中城市的票根 ===== -->
  <view class="ct" wx:if="{{activeCity}}">
    <view class="sec-title">
      <text class="t serif">{{activeCity}}的时光</text>
      <text class="s">{{cityTickets.length}} 张</text>
    </view>
    <view
      class="ct-row pressable"
      hover-class="press-item-hover"
      wx:for="{{cityTickets}}"
      wx:key="id"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <text class="tag tag-{{item.type || 'show'}}">{{item.typeText}}</text>
      <view class="ct-main">
        <view class="ct-title serif">{{item.title}}</view>
        <view class="ct-date">{{item.date}}</view>
      </view>
      <view class="ct-go">›</view>
    </view>
  </view>

  <!-- ===== 引导态 ===== -->
  <view class="empty" wx:if="{{!cities.length}}">
    <view class="big">🗺️</view>
    <view>还没有可点亮的足迹</view>
    <view>收一张带城市的票根，地图就开始生长</view>
  </view>
  <view class="geo-tip" wx:if="{{cities.length && !hasGeo}}">部分票根缺坐标（旧数据），新收的票根会自动配对城市坐标</view>

  <view class="safe-bottom"></view>
</view>
