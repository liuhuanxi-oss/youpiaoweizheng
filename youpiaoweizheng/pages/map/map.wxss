/* pages/map/map.wxss —— M4.5 足迹地图（v6 六主题变量化） */
.page {
  padding-top: 16rpx;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
}

/* 标题衬线随主题字体分化（paper/collage/literary 衬线，glass/film/minimal 无衬线） */
.serif { font-family: var(--font-title); }

/* —— 地图区（统计浮牌压在地图下沿） —— */
.map-wrap {
  position: relative;
  margin: 0 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(var(--text-rgb), 0.12);
}
.the-map {
  width: 100%;
  height: 58vh;
}

.stat-bar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  padding: 18rpx 0;
  /* 浮在地图之上：用不透明卡底保证可读（其余卡片走 card-bg 语义底） */
  background: var(--card);
  border-radius: var(--card-r, 32rpx);
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, none);
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
.stat-bar .sb {
  flex: 1;
  text-align: center;
}
.stat-bar .n {
  font-size: 34rpx;
  color: var(--primary);
  line-height: 1.2;
}
.stat-bar .k {
  font-size: 19rpx;
  color: var(--text2);
  letter-spacing: 2rpx;
}

/* —— 城市 chips（横滑） —— */
.city-chips {
  white-space: nowrap;
  padding: 26rpx 24rpx 6rpx;
}
.city-chips .chip {
  display: inline-block;
  margin-right: 14rpx;
  font-size: 23rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--soft);
  color: var(--text2);
  letter-spacing: 1rpx;
}
.city-chips .chip.on {
  background: var(--primary);
  color: var(--on-primary);
}

/* —— 选中城市的票根列表 —— */
.ct {
  margin: 22rpx 36rpx 0;
}
.ct-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, 20rpx);
  border: var(--card-border, none);
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--card-shadow, none);
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
.ct-main { flex: 1; min-width: 0; }
.ct-title {
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ct-date { font-size: 20rpx; color: var(--text2); margin-top: 4rpx; }
.ct-go { color: var(--text2); font-size: 30rpx; }

/* —— 类型标签：v6 六主题下统一为可读中性胶囊 —— */
.tag-show, .tag-movie, .tag-traffic {
  background: var(--chip);
  color: var(--text);
}

/* —— 引导 —— */
.empty { color: var(--text2); }
.geo-tip {
  margin: 20rpx 36rpx 0;
  font-size: 20rpx;
  color: var(--text2);
  letter-spacing: 1rpx;
  text-align: center;
}

.safe-bottom { height: 60rpx; }
