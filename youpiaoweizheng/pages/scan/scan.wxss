/* pages/scan/scan.wxss —— 扫描票根（品牌全案 · 稿屏3 一比一）
   布局：装饰带 → 内嵌取景框（玫瑰 L 角标）→ 相册/快门/翻转三钮
        → 撕边纸的「AI 智能处理中」四步卡 → 页脚装饰
   颜色一律读 --*；品牌固定色（四步圆底 / 白图标）由 scan.js 下发，
   和 utils/icons.js 顶部说的一样：SVG 是独立文档，wxml 里写 var() 会失效。 */

.sc-page { min-height: 100vh; background: var(--cream, #FAF5EE); }

/* ============================================================
   取景态 / 处理态：整屏纵向 flex（取景框吃掉剩余高度）
   ============================================================ */
.cam-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cream, #FAF5EE);
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  box-sizing: border-box;
}

/* ═══ ① 装饰带：邮戳 / 小粉心 / 星点 / 邮票 ═══ */
.sc-deco {
  position: relative;
  flex-shrink: 0;
  height: 152rpx;
  margin: 0 24rpx;
}
.sc-deco image { position: absolute; }
.sc-postmark { left: 4rpx; top: 6rpx; width: 172rpx; height: 140rpx; transform: rotate(-4deg); }
.sc-deco-heart { left: 45%; top: 52rpx; width: 38rpx; height: 38rpx; }
.sc-deco-spark { left: 66%; top: 30rpx; width: 40rpx; height: 40rpx; }
.sc-deco-stamp { right: 12rpx; top: 0; width: 122rpx; height: 134rpx; transform: rotate(4deg); }

/* ═══ ② 取景框：内嵌圆角框（不是全屏相机）═══ */
.sc-frame {
  position: relative;
  flex: 1;
  min-height: 460rpx;
  margin: 0 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--soft, #E9E2D4);
  box-shadow: 0 10rpx 30rpx rgba(var(--text-rgb, 107, 91, 80), 0.12);
}
.sc-cam { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sc-shot { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* —— 相机不可用降级（权限拒绝/被占用）—— */
.sc-fb {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 70rpx;
  text-align: center;
  background: linear-gradient(170deg, var(--bg, #F5F0E6), var(--soft, #E9E2D4));
}
.sc-fb-ic { width: 92rpx; height: 92rpx; }
.sc-fb-t { font-size: 30rpx; font-weight: 700; color: var(--text, #6B5B50); }
.sc-fb-s { font-size: 23rpx; color: var(--text2, #A5968A); line-height: 1.7; }
.sc-fb-btn {
  margin-top: 16rpx;
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: var(--rose, #D9A0A6);
  color: var(--on-primary, #FFFFFF);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.sc-fb-set { margin-top: 8rpx; display: flex; align-items: center; gap: 4rpx; }
.sc-fb-set-t { font-size: 23rpx; color: var(--text2, #A5968A); text-decoration: underline; }
.sc-fb-set-ic { width: 22rpx; height: 22rpx; }

/* —— 处理态：扫描光条 —— */
.sc-scanline {
  position: absolute;
  left: 6%; right: 6%;
  height: 6rpx;
  top: 18%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, transparent, var(--butter, #F6DFA8), transparent);
  box-shadow: 0 0 36rpx 8rpx var(--butter, #F6DFA8);
  animation: sc-scan 2.2s ease-in-out infinite;
  z-index: 3;
}
@keyframes sc-scan {
  0%, 100% { top: 14%; }
  50% { top: 84%; }
}
@media (prefers-reduced-motion: reduce) {
  .sc-scanline { animation: none; top: 50%; }
}

/* —— 框内顶部一行：提示胶囊 + 闪光灯/技巧 ——
   稿里 ⚡/? 在导航栏右侧，真机那个位置是微信胶囊按钮，放不下，
   故挪进取景框内的同一行；胶囊占满剩余宽度、文字居中。 */
.sc-topbar {
  position: absolute;
  left: 20rpx; right: 20rpx; top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 5;
}
.sc-capsule {
  flex: 1;
  min-width: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(58, 48, 42, 0.62);
  color: var(--on-primary, #FFFFFF);
  font-size: 23rpx;
  letter-spacing: 1rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sc-tool {
  flex: 0 0 56rpx;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(var(--text-rgb, 107, 91, 80), 0.2);
  /* 本类自带 transition（.on 的闪光灯底色切换），会盖掉全局 .pressable——
     按压回弹要生效，transform/opacity 两段必须在这里补写 */
  transition: background 160ms ease,
              transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 150ms ease-out;
}
.sc-tool.on { background: var(--butter, #F6DFA8); }
.sc-tool-ic { width: 30rpx; height: 30rpx; }

/* —— 四角玫瑰 L 角标（稿内是实心粗角，不是白虚线框）—— */
.sc-corner {
  position: absolute;
  width: 60rpx; height: 60rpx;
  border: 7rpx solid var(--rose, #D9A0A6);
  z-index: 4;
}
.sc-frame .c1 { top: 14rpx; left: 14rpx;     border-right: none; border-bottom: none; border-radius: 16rpx 0 0 0; }
.sc-frame .c2 { top: 14rpx; right: 14rpx;    border-left: none;  border-bottom: none; border-radius: 0 16rpx 0 0; }
.sc-frame .c3 { bottom: 14rpx; left: 14rpx;  border-right: none; border-top: none;    border-radius: 0 0 0 16rpx; }
.sc-frame .c4 { bottom: 14rpx; right: 14rpx; border-left: none;  border-top: none;    border-radius: 0 0 16rpx 0; }

/* ═══ ③ 三钮排：相册 / 快门 / 翻转 ═══ */
.sc-ctrl {
  position: relative;
  flex-shrink: 0;
  height: 208rpx;
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
}
.sc-btn {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: var(--soft, #E9E2D4);
  display: flex; align-items: center; justify-content: center;
  transition: transform 160ms ease;
}
.sc-btn-ic { width: 44rpx; height: 44rpx; }

/* 快门：玫瑰大圆。按下 0.94/100ms，抬起 250ms 弹性回冲 + 呼吸阴影 */
.sc-shutter {
  width: 180rpx; height: 180rpx;
  border-radius: 50%;
  background: var(--rose, #D9A0A6);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(var(--text-rgb, 107, 91, 80), 0.22);
  transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: sc-breath 2.6s ease-in-out 1s infinite;
}
.sc-shutter-ic { width: 84rpx; height: 84rpx; }
.sc-shutter:active { transform: scale(0.94); }
.shutter-hover {
  transform: scale(0.94);
  box-shadow: 0 4rpx 10rpx rgba(var(--text-rgb, 107, 91, 80), 0.24);
  transition: transform 100ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 100ms ease-out;
  animation: none;
}
@keyframes sc-breath {
  0%, 100% { box-shadow: 0 12rpx 30rpx rgba(var(--text-rgb, 107, 91, 80), 0.22); }
  50% { box-shadow: 0 14rpx 38rpx rgba(var(--text-rgb, 107, 91, 80), 0.28); }
}
@media (prefers-reduced-motion: reduce) {
  .sc-shutter { animation: none; transition: box-shadow 150ms ease-out; }
  .shutter-hover { transform: none; }
}

/* 两侧点缀：左＝星点＋花枝，右＝虚线圈＋小粉心 */
.sc-ctrl-l, .sc-ctrl-r {
  position: absolute;
  top: 0; bottom: 0;
  width: 190rpx;
  pointer-events: none;
}
.sc-ctrl-l { left: 0; }
.sc-ctrl-r { right: 0; }
.sc-ctrl-l image, .sc-ctrl-r image { position: absolute; }
.sc-ctrl-spark { left: 34rpx; top: 34rpx; width: 40rpx; height: 40rpx; }
.sc-ctrl-sprig { left: 6rpx; top: 84rpx; width: 104rpx; height: 70rpx; }
.sc-ctrl-dots {
  position: absolute; right: 26rpx; top: 78rpx;
  display: flex; gap: 8rpx;
}
.sc-ctrl-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: var(--rose, #D9A0A6); opacity: 0.55;
}
.sc-ctrl-heart { right: 40rpx; top: 30rpx; width: 36rpx; height: 36rpx; }

/* ═══ ④ AI 处理面板：撕边纸卡 ═══ */
.sc-ai {
  position: relative;
  flex-shrink: 0;
  margin: 0 24rpx;
  padding: 30rpx 32rpx 26rpx;
  background: var(--card-bg, var(--card));
  border-radius: 28rpx;
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb, 107, 91, 80), 0.08));
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
/* 上沿齿孔：一排页面底色的小圆咬口。
   稿子里是手撕边，真撕边得现拼一条 SVG 路径 —— 为一条装饰边养一个生成器不值，
   这里回落到品牌本来的「邮票齿孔」语言（与票根详情页的邮票框同一套）。 */
.sc-ai-tear {
  position: absolute;
  /* 左右让开卡片自身的 28rpx 圆角，否则齿孔会把圆角「切方」 */
  left: 30rpx; right: 30rpx; top: -1rpx;
  height: 16rpx;
  background-image: radial-gradient(circle at 16rpx 0, var(--cream, #FAF5EE) 15rpx, transparent 15rpx);
  background-size: 32rpx 16rpx;
  background-repeat: repeat-x;
}
.sc-ai-head {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding-top: 8rpx;
}
.sc-ai-spark { width: 28rpx; height: 28rpx; opacity: 0.9; }
.sc-ai-title {
  font-size: 30rpx; font-weight: 700; color: var(--text, #6B5B50);
  letter-spacing: 2rpx;
}

/* 四步：识别 →（点）→ 修复 →（›）→ 重绘 →（点）→ 入档 */
.sc-ai-steps {
  margin-top: 26rpx;
  display: flex;
  align-items: flex-start;
}
/* 分隔（点 / ›）与步骤同为直接子元素：分隔吃满剩余宽度，四步被均匀撑开 */
.sc-ai-sep {
  flex: 1;
  height: 84rpx;                     /* 与图标圆同高，点/箭头对齐圆心 */
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.sc-ai-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: var(--text2, #A5968A); opacity: 0.5;
}
.sc-ai-sep-ic { width: 26rpx; height: 26rpx; }

.sc-ai-step {
  flex: 0 0 104rpx;
  display: flex; flex-direction: column; align-items: center;
  gap: 14rpx;
}
.sc-ai-ico {
  width: 84rpx; height: 84rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: transform 200ms ease, box-shadow 200ms ease;
}
.sc-ai-ico-img { width: 40rpx; height: 40rpx; }
/* 走到这一步：放大 + 品牌描边。稿内四步全彩常显，on 只是状态层 */
.sc-ai-step.on .sc-ai-ico {
  transform: scale(1.06);
  box-shadow: 0 0 0 4rpx var(--card-bg, var(--card)), 0 0 0 7rpx var(--rose, #D9A0A6);
}
.sc-ai-lb { font-size: 22rpx; color: var(--text2, #A5968A); letter-spacing: 2rpx; }
.sc-ai-step.on .sc-ai-lb { color: var(--text, #6B5B50); font-weight: 700; }

.sc-ai-cap {
  margin-top: 22rpx;
  text-align: center;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--text2, #A5968A);
}
.sc-demo {
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--text2, #A5968A);
  opacity: 0.85;
}
.sc-manual {
  margin-top: 18rpx;
  display: flex; align-items: center; justify-content: center; gap: 4rpx;
}
.sc-manual-t { font-size: 23rpx; color: var(--text2, #A5968A); letter-spacing: 1rpx; }
.sc-manual-ic { width: 22rpx; height: 22rpx; }

/* ═══ ⑤ 页脚装饰 ═══ */
.sc-foot {
  position: relative;
  flex-shrink: 0;
  height: 124rpx;
  margin: 0 24rpx;
}
.sc-foot image { position: absolute; }
.sc-foot-wave { left: 10rpx; bottom: 16rpx; width: 128rpx; height: 60rpx; opacity: 0.7; }
.sc-foot-sprig { left: 118rpx; bottom: 22rpx; width: 96rpx; height: 64rpx; }
.sc-foot-heart { left: 214rpx; bottom: 26rpx; width: 34rpx; height: 34rpx; }
.sc-foot-stamp { right: 0; bottom: 4rpx; width: 128rpx; height: 138rpx; transform: rotate(5deg); }

/* ============================================================
   确认表单态（稿外必要态，沿用既有结构）
   ============================================================ */
.frame {
  margin: 24rpx 32rpx 0;
  height: 460rpx;
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--soft, #F5EDE2), var(--soft, #F5EDE2) 55%, var(--chip, #F7EBE3));
  display: flex;
  align-items: center;
  justify-content: center;
}
.frame.slim { height: 320rpx; margin-top: 8rpx; }
.shot { width: 100%; height: 100%; }

/* 四角对焦框（品牌邮政红点缀） */
.corner { position: absolute; width: 44rpx; height: 44rpx; border: 5rpx solid var(--stamp, #C26B5E); }
.frame .c1 { top: 28rpx; left: 28rpx; border-right: none; border-bottom: none; border-radius: 12rpx 0 0 0; }
.frame .c2 { top: 28rpx; right: 28rpx; border-left: none; border-bottom: none; border-radius: 0 12rpx 0 0; }
.frame .c3 { bottom: 28rpx; left: 28rpx; border-right: none; border-top: none; border-radius: 0 0 0 12rpx; }
.frame .c4 { bottom: 28rpx; right: 28rpx; border-left: none; border-top: none; border-radius: 0 0 12rpx 0; }

/* —— 表单 —— */
.form {
  margin: 24rpx 32rpx;
  padding: 8rpx 32rpx;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, var(--radius, 20px));
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, none);
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
.f-head {
  font-size: 21rpx;
  color: var(--text2, #A5968A);
  padding: 20rpx 0 2rpx;
  letter-spacing: 2rpx;
}
.f-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border, #EFE5D8);
}
.f-row:last-child { border-bottom: none; }
.f-row .k { font-size: 25rpx; color: var(--text2, #A5968A); flex-shrink: 0; }
.f-row .v {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text, #6B5B50);
  text-align: right;
  max-width: 440rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.f-row .v.blank { color: var(--text2, #A5968A); font-weight: 400; }
/* 类型行末尾的细箭头（原来是字符 ▾，换成线性图标） */
.f-go { flex: 0 0 24rpx; width: 24rpx; height: 24rpx; margin-left: -8rpx; }

/* —— 类型选择弹出层选项 —— */
.type-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: var(--chip, #F7EBE3);
}
.type-opt.on { background: var(--soft); }
.type-opt .t-ico {
  flex: 0 0 64rpx; width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--card-bg, var(--card));
  display: flex; align-items: center; justify-content: center;
}
.type-opt .t-ico-img { width: 34rpx; height: 34rpx; }
.type-opt .t-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text, #6B5B50);
  letter-spacing: 2rpx;
}
.type-opt.on .t-label { color: var(--primary, #D9A0A6); font-weight: 700; }
.type-opt .t-check { flex: 0 0 30rpx; width: 30rpx; height: 30rpx; }

/* —— 识别完成盖戳（盖下→停留→淡出） —— */
.stamp-over {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  pointer-events: none;
}
.stamp-in {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--primary, #D9A0A6);
  background: var(--soft);
  border: 3rpx solid var(--primary, #D9A0A6);
  border-radius: 10rpx;
  padding: 10rpx 26rpx 10rpx 30rpx;
  animation: stamp-in 1.7s var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) forwards;
}
@keyframes stamp-in {
  0%   { opacity: 0; transform: scale(1.8) rotate(16deg); }
  16%  { opacity: 1; transform: scale(1) rotate(-5deg); }
  78%  { opacity: 1; transform: scale(1.02) rotate(-5deg); }
  100% { opacity: 0; transform: scale(1.06) rotate(-5deg); }
}

/* —— 保存成功「入档」浮层（Canvas 对勾+粒子 → 上移淡出） —— */
.stamp-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  background: var(--bg);
}
.stamp-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}
.stamp-inner.lift-off {
  animation: lift-fade 200ms ease-out both;
}
@keyframes lift-fade {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-48rpx); }
}
@media (prefers-reduced-motion: reduce) {
  .stamp-inner.lift-off { animation-name: lift-fade-rm; }
  @keyframes lift-fade-rm {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(0); }
  }
}
/* 对勾画布（Canvas 2D：圆环 0→满 + 一笔对勾 + 三色粒子，js 驱动 400ms） */
.check-wrap {
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-cv {
  width: 260rpx;
  height: 260rpx;
}
.stamp-text {
  font-size: 28rpx;
  color: var(--text, #6B5B50);
  letter-spacing: 4rpx;
  animation: st-fade 300ms 260ms ease-out both;
}
@keyframes st-fade {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* —— A2 撕票：整张票立在中央 → 沿撕票线裂开 → 副券飞进收藏册（存根留在原地） —— */
.tear {
  position: fixed;
  left: 50%; top: 44%;
  width: 320rpx; height: 200rpx;
  margin-left: -160rpx; margin-top: -100rpx;
  animation: tear-in 140ms ease-out both;
  pointer-events: none;
}
@keyframes tear-in {
  from { opacity: 0; transform: translateY(40rpx) scale(1.25) rotate(-3deg); }
  to   { opacity: 1; transform: none; }
}
/* 存根（上）与副券（下）各裁一半照片，撕开前拼成一整张 */
.tear-half {
  position: absolute; left: 0;
  width: 320rpx; height: 120rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 4rpx solid var(--cream, #FAF5EE);
  border-radius: 14rpx 14rpx 0 0;
  background: var(--card-bg, var(--card));
}
.tear-img { width: 100%; height: 200rpx; display: block; }
/* 撕开的一下：存根被带得沉一下（200ms），副券先翘起再回弹，然后整枚飞走 */
.tear-stub {
  top: 0;
  animation: tear-stub 200ms 140ms ease-out both;
}
@keyframes tear-stub {
  0%   { transform: none; }
  35%  { transform: translateY(4rpx) rotate(-0.9deg); }
  100% { transform: translateY(2rpx) rotate(-0.5deg); }
}
.tear-coupon {
  top: 120rpx; height: 80rpx;
  border-radius: 0 0 14rpx 14rpx;
  box-shadow: 0 10rpx 26rpx rgba(44, 44, 44, 0.22);
  animation: tear-off 440ms 140ms cubic-bezier(0.42, 0, 0.85, 0.32) both;
}
.tear-coupon .tear-img { margin-top: -124rpx; }
@keyframes tear-off {
  0%   { transform: none; }
  14%  { transform: translate(2rpx, -6rpx) rotate(-1.8deg); }
  28%  { transform: translate(4rpx, 2rpx) rotate(0.8deg); }
  100% { opacity: 0; transform: translate(170rpx, 1020rpx) scale(0.16) rotate(24deg); }
}
/* 撕票线：与页面背景同色的齿孔，压在两张票的交界上（撕开后就是存根的下缘） */
.tear-line { position: absolute; left: 0; top: 120rpx; width: 100%; margin-top: -11rpx; }
@media (prefers-reduced-motion: reduce) {
  .tear, .tear-stub { animation: none; }
  .tear-coupon { animation: tear-rm 200ms 140ms both; }
  @keyframes tear-rm {
    from { opacity: 1; transform: none; }
    to   { opacity: 0; transform: none; }
  }
}

/* 保存失败 → 主按钮红色抖动一次（不播成功浮层） */
.btn-main.shake-err {
  animation: shake-err 300ms ease-out 1;
  background: var(--stamp, #C26B5E);
}
@media (prefers-reduced-motion: reduce) {
  .btn-main.shake-err { animation: none; background: var(--stamp, #C26B5E); }
}
