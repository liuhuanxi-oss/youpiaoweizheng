/* pages/scan/scan.wxss —— 6.4.0 品牌稿第三屏「拍照上传」
   布局：相机全屏舞台 + 白虚线取景框四角白角标 + 相册/快门/翻转三钮
        + 底部白面板「✦ AI智能处理中」识别→修复→重绘→入档四步        */

.sc-page { min-height: 100vh; background: var(--cream, #FAF5EE); }

/* ============================================================
   取景态 / 处理态：相机舞台（100vh 纵向 flex：舞台 + 白面板）
   ============================================================ */
.cam-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cream, #FAF5EE);
}
.cam-stage {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 0;
}
.cam { position: absolute; inset: 0; width: 100%; height: 100%; }

/* —— 相机不可用降级（权限拒绝/被占用）—— */
.cam-fb {
  background: linear-gradient(170deg, var(--bg), var(--soft));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 80rpx;
  text-align: center;
}
.fb-ico { font-size: 84rpx; line-height: 1; opacity: 0.85; }
.fb-t { font-size: 32rpx; font-weight: 700; color: var(--brown, #6B5B50); }
.fb-s { font-size: 24rpx; color: var(--text2, #A5968A); line-height: 1.7; }
.fb-btn {
  margin-top: 18rpx;
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: var(--rose, #D9A0A6);
  color: var(--on-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx var(--rose);
}
.fb-set { margin-top: 6rpx; font-size: 23rpx; color: var(--text2, #A5968A); text-decoration: underline; }

/* —— 稿内：白色虚线取景框 + 四角白角标 —— */
.vf {
  position: absolute;
  left: 50%;
  top: 20%;
  transform: translateX(-50%);
  width: 580rpx;
  height: 400rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 0 0 8rpx rgba(var(--text-rgb), 0.08);
}
.vf-c {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  border: 6rpx solid #FFFFFF;
}
.c1 { top: -6rpx; left: -6rpx;  border-right: none;  border-bottom: none; border-radius: 20rpx 0 0 0; }
.c2 { top: -6rpx; right: -6rpx; border-left: none;   border-bottom: none; border-radius: 0 20rpx 0 0; }
.c3 { bottom: -6rpx; left: -6rpx;  border-right: none; border-top: none;  border-radius: 0 0 0 20rpx; }
.c4 { bottom: -6rpx; right: -6rpx; border-left: none;  border-top: none;  border-radius: 0 0 20rpx 0; }

/* —— 处理态：照片盖进取景框 + 扫描光条 —— */
.vf-photo { overflow: hidden; background: var(--brown, #6B5B50); }
.vf-img { width: 100%; height: 100%; }
.scanline {
  position: absolute;
  left: 6%;
  right: 6%;
  height: 6rpx;
  top: 18%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, transparent, var(--butter, #F6DFA8), transparent);
  box-shadow: 0 0 36rpx 8rpx var(--butter);
  animation: scan 2.2s ease-in-out infinite;
  z-index: 3;
}
@keyframes scan {
  0%, 100% { top: 14%; }
  50% { top: 84%; }
}

/* —— 稿内导航栏右侧 ⚡/?：闪光灯 + 拍摄技巧 —— */
.cam-tools {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  display: flex;
  gap: 16rpx;
  z-index: 5;
}
.tool-dot {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(var(--text-rgb), 0.18);
}
.tool-dot.on { background: var(--butter, #F6DFA8); }
.fl-ico {
  width: 22rpx;
  height: 36rpx;
  background: var(--brown, #6B5B50);
  clip-path: polygon(62% 0, 16% 56%, 44% 56%, 34% 100%, 86% 36%, 55% 36%, 84% 0);
}
.tool-dot.on .fl-ico { background: #B98F2E; }
.tool-q { font-size: 36rpx; font-weight: 700; color: var(--brown, #6B5B50); line-height: 1; }

/* ============================================================
   三钮排：相册 / 快门（灰玫粉大圆）/ 翻转
   ============================================================ */
.ctrl-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 92rpx;
  z-index: 5;
}
.ctrl-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(var(--text-rgb), 0.22);
}
.ctrl-btn:active { transform: scale(0.92); }
/* v6.6.0 动效2：快门凸起圆钮——按下 0.94/100ms，抬起 250ms 弹性回冲 + box-shadow 呼吸实感 */
.shutter {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--rose, #D9A0A6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx var(--rose);
  transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  /* idle 极淡呼吸（悬起时阴影微微起伏），hover 按下时打断、抬起后重启=「回弹叠加呼吸」 */
  animation: shutter-breath 2.6s ease-in-out 1s infinite;
}
.shutter:active { transform: scale(0.94); }
.shutter-hover {
  transform: scale(0.94);
  /* 按下：阴影收紧贴底，模拟「压下去」的实感 */
  box-shadow: 0 4rpx 10rpx var(--rose);
  transition: transform 100ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 100ms ease-out;
  animation: none;
}
@keyframes shutter-breath {
  0%, 100% { box-shadow: 0 12rpx 30rpx var(--rose); }
  50% { box-shadow: 0 14rpx 38rpx var(--rose); }
}
@media (prefers-reduced-motion: reduce) {
  .shutter { animation: none; transition: box-shadow 150ms ease-out; }
  .shutter-hover { transform: none; }
}

/* 快门内白色描线相机（CSS 绘制） */
.sh-ico {
  width: 48rpx;
  height: 34rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 9rpx;
  position: relative;
}
.sh-ico::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 4rpx 4rpx 0 0;
}
.sh-ico::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
}

/* 相册钮描线图标（CSS 绘制：方框+太阳+山） */
.ab-ico {
  width: 42rpx;
  height: 34rpx;
  border: 4rpx solid var(--brown, #6B5B50);
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
}
.ab-sun {
  position: absolute;
  top: 5rpx;
  left: 7rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--rose, #D9A0A6);
}
.ab-mtn {
  position: absolute;
  bottom: -3rpx;
  right: 2rpx;
  width: 0;
  height: 0;
  border-left: 15rpx solid transparent;
  border-right: 15rpx solid transparent;
  border-bottom: 16rpx solid var(--sage, #A9C3A6);
}
.flip-ico { font-size: 44rpx; line-height: 1; color: var(--brown, #6B5B50); font-weight: 600; }

/* ============================================================
   底部白色面板：✦ AI智能处理中 + 四步流程（识别/修复/重绘/入档）
   ============================================================ */
.ai-panel {
  flex-shrink: 0;
  background: var(--card-bg, var(--card));
  border-radius: 44rpx 44rpx 0 0;
  padding: 34rpx 44rpx calc(env(safe-area-inset-bottom) + 40rpx);
  box-shadow: 0 -10rpx 34rpx rgba(var(--text-rgb), 0.10);
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
.ai-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brown, #6B5B50);
  letter-spacing: 1rpx;
}
.ai-spark { color: #E8C87E; font-size: 28rpx; } /* 稿内 ✦ 暖金（鹅黄体系深化，保证白底可读） */
.ai-title { flex: 1; }
.ai-manual {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--text2, #A5968A);
  letter-spacing: 1rpx;
  padding: 6rpx 0 6rpx 12rpx;
}

/* 四步：图标方块（rose/butter/sage/brown 浅底）+ 步骤名 + → 箭头 */
.ai-steps {
  margin-top: 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.ai-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: 104rpx;
}
.ai-ico {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  transition: transform 200ms ease, box-shadow 200ms ease;
}
.ico-rose   { background: var(--rose); }
.ico-butter { background: var(--butter); }
.ico-sage   { background: var(--sage); }
.ico-brown  { background: rgba(var(--text-rgb), 0.10); }
/* 当前进行中步骤：轻微放大 + 品牌描边强调（稿内四步全彩常显，on 为状态层） */
.ai-step.on .ai-ico {
  transform: scale(1.08);
  box-shadow: 0 0 0 4rpx var(--card-bg, var(--card)), 0 0 0 7rpx var(--rose);
}
.ai-lb { font-size: 22rpx; color: var(--text2, #A5968A); letter-spacing: 2rpx; }
.ai-step.on .ai-lb { color: var(--brown, #6B5B50); font-weight: 700; }
.ai-arrow {
  flex: 1;
  text-align: center;
  line-height: 92rpx;
  font-size: 26rpx;
  color: var(--brown, #6B5B50);
  opacity: 0.55;
}
.ai-cap {
  margin-top: 24rpx;
  text-align: center;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--text2, #A5968A);
  min-height: 30rpx;
}
.demo-note {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--text2, #A5968A);
  line-height: 1.6;
  text-align: center;
  opacity: 0.85;
}

/* ============================================================
   done · 确认表单态（稿外必要态，沿用既有结构）
   ============================================================ */
.frame {
  margin: 24rpx 32rpx 0;
  height: 460rpx;
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, var(--soft, #F5EDE2), var(--soft, #F5EDE2) 55%, var(--chip, #F7EBE3));
  display: flex;
  align-items: center;
  justify-content: center;
}
.frame.slim { height: 320rpx; margin-top: 8rpx; }
.shot { width: 100%; height: 100%; }

/* 四角对焦框（品牌邮政红点缀） */
.corner { position: absolute; width: 44rpx; height: 44rpx; border: 5rpx solid var(--stamp, #C26B5E); }
.frame .c1 { top: 28rpx; left: 28rpx; border-right: none; border-bottom: none; border-radius: 12rpx 0 0 0; }
.frame .c2 { top: 28rpx; right: 28rpx; border-left: none; border-bottom: none; border-radius: 0 12rpx 0 0; }
.frame .c3 { bottom: 28rpx; left: 28rpx; border-right: none; border-top: none; border-radius: 0 0 0 12rpx; }
.frame .c4 { bottom: 28rpx; right: 28rpx; border-left: none; border-top: none; border-radius: 0 0 12rpx 0; }

/* —— 表单 —— */
.form {
  margin: 24rpx 32rpx;
  padding: 8rpx 32rpx;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, var(--radius, 20px));
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, none);
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
.f-head {
  font-size: 21rpx;
  color: var(--text2, #A5968A);
  padding: 20rpx 0 2rpx;
  letter-spacing: 2rpx;
}
.f-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border, #EFE5D8);
}
.f-row:last-child { border-bottom: none; }
.f-row .k { font-size: 25rpx; color: var(--text2, #A5968A); flex-shrink: 0; }
.f-row .v {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text, #6B5B50);
  text-align: right;
  max-width: 440rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.f-row .v.blank { color: var(--text2, #A5968A); font-weight: 400; }

.safe-bottom { height: 80rpx; }

/* —— M4.5 类型选择弹出层选项 —— */
.type-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: var(--chip, #F7EBE3);
}
.type-opt.on { background: var(--soft); }
.type-opt .t-icon { font-size: 36rpx; }
.type-opt .t-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text, #6B5B50);
  letter-spacing: 2rpx;
}
.type-opt.on .t-label { color: var(--primary, #D9A0A6); font-weight: 700; }
.type-opt .t-check { color: var(--primary, #D9A0A6); font-size: 30rpx; font-weight: 700; }

/* —— 识别完成盖戳（盖下→停留→淡出） —— */
.stamp-over {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  pointer-events: none;
}
.stamp-in {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--primary, #D9A0A6);
  background: var(--soft);
  border: 3rpx solid var(--primary, #D9A0A6);
  border-radius: 10rpx;
  padding: 10rpx 26rpx 10rpx 30rpx;
  animation: stamp-in 1.7s var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) forwards;
}
@keyframes stamp-in {
  0%   { opacity: 0; transform: scale(1.8) rotate(16deg); }
  16%  { opacity: 1; transform: scale(1) rotate(-5deg); }
  78%  { opacity: 1; transform: scale(1.02) rotate(-5deg); }
  100% { opacity: 0; transform: scale(1.06) rotate(-5deg); }
}

/* —— 保存成功「入档」浮层（v6.6.0 动效4：Canvas 对勾+粒子 → 上移淡出） —— */
.stamp-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  background: var(--bg);
}
/* 内层负责上移淡出（外层类名保持 4.13 断言口径）；200ms ease-out */
.stamp-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}
.stamp-inner.lift-off {
  animation: lift-fade 200ms ease-out both;
}
@keyframes lift-fade {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-48rpx); }
}
@media (prefers-reduced-motion: reduce) {
  .stamp-inner.lift-off { animation-name: lift-fade-rm; }
  @keyframes lift-fade-rm {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(0); }
  }
}
/* 对勾画布（Canvas 2D：圆环 0→满 + 一笔对勾 + 三色粒子，js 驱动 400ms） */
.check-wrap {
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-cv {
  width: 260rpx;
  height: 260rpx;
}
.stamp-text {
  font-size: 28rpx;
  color: var(--text, #6B5B50);
  letter-spacing: 4rpx;
  animation: st-fade 300ms 260ms ease-out both;
}
@keyframes st-fade {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* —— 票根飞入收藏册 —— */
.fly-ticket {
  position: fixed;
  left: 50%; top: 44%;
  width: 320rpx; height: 200rpx;
  margin-left: -160rpx; margin-top: -100rpx;
  border-radius: 14rpx;
  border: 4rpx solid var(--cream, #FAF5EE);
  box-shadow: 0 16rpx 44rpx rgba(44, 44, 44, 0.28);
  background: var(--card-bg, var(--card));
  animation: fly-home 400ms 120ms cubic-bezier(0.55, 0, 0.85, 0.36) both; /* v6.6.0：适配新时序（600ms 处浮层开始上移淡出） */
  pointer-events: none;
}
@keyframes fly-home {
  0%   { opacity: 0; transform: translate(0, 40rpx) scale(1.25) rotate(-3deg); }
  18%  { opacity: 1; transform: translate(0, 0) scale(1) rotate(-2deg); }
  70%  { opacity: 1; transform: translate(60rpx, 380rpx) scale(0.62) rotate(5deg); }
  100% { opacity: 0; transform: translate(150rpx, 980rpx) scale(0.14) rotate(16deg); }
}

/* v6.6.0 动效4：保存失败 → 主按钮红色抖动一次（不播成功浮层） */
.btn-main.shake-err {
  animation: shake-err 300ms ease-out 1;
  background: var(--stamp, #C26B5E);
}
@media (prefers-reduced-motion: reduce) {
  .btn-main.shake-err { animation: none; background: var(--stamp, #C26B5E); }
}
