<!-- 7.3.0 S1：朋友圈单页模式落地（无身份、不能跳页）→ 换品牌卡，见 templates/sp.wxml -->
<import src="/templates/sp.wxml" />
<block wx:if="{{sp}}"><template is="spGate" data="{{theme: theme, tip: '这是别人这一年的回忆报告'}}" /></block>

<view class="page theme-{{theme}} fade-up" wx:if="{{!sp}}">
  <!-- 4.10.1 重装饰层：纸面噪点 -->
  <view class="grain"></view>

  <!-- 加载中 -->
  <view class="state" wx:if="{{loading}}">
    <image class="st-ic" src="{{ic.clock}}" mode="aspectFit" aria-hidden="true" />
    <view class="st-t">正在整理你的票根年报…</view>
  </view>

  <!-- 0 票根：无字可写（v5.0 空态同款出路） -->
  <view class="empty" wx:elif="{{empty}}">
    <image class="big-ic" src="{{ic.emptyIc}}" mode="aspectFit" aria-hidden="true" />
    <view class="e-title">还没有票根，年报暂时无字可写</view>
    <view class="e-sub">收进第一张票根，时光才有故事</view>
    <view class="nf-btn pressable" hover-class="press-hover" bindtap="goScan" aria-role="button" aria-label="去收第一张票">去收第一张票</view>
  </view>

  <!-- 拉取失败：重试 -->
  <view class="empty" wx:elif="{{error}}">
    <image class="big-ic" src="{{ic.cloud}}" mode="aspectFit" aria-hidden="true" />
    <view class="e-title">网络好像不太好，年报没取回来</view>
    <view class="nf-btn pressable" hover-class="press-hover" bindtap="reload" aria-role="button" aria-label="重试">重试</view>
  </view>

  <!-- 正常态：品牌行 → 大标题 → 两张水彩统计卡 → 年度精选拼贴 → AI 年度结语 → 两枚按钮 -->
  <block wx:else>
    <!-- ⓪ 云故障 / 超上限横幅（同 album 的 tm-net）——年报里每个数字都来自票根，
         兜底成演示数据时整页都是编的，必须让用户看见这句 -->
    <view wx:if="{{netBar}}" class="an-net pressable" hover-class="press-item-hover" bindtap="onNetBarTap"
          aria-role="button" aria-label="{{netBar.text}}">
      <text class="an-net-t">{{netBar.text}}</text>
    </view>

    <!-- ① 品牌行：玫瑰票根标 + 有票为证 + No.年份 标签 + 注销波浪 -->
    <view class="an-brand">
      <view class="an-logo">
        <image class="an-logo-ic" src="{{ic.logo}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <text class="an-name">有票为证</text>
      <view class="an-no"><text class="an-no-t">No.{{y}}</text></view>
      <image class="an-cancel" src="{{art.wave}}" mode="aspectFit" aria-hidden="true" />
    </view>

    <!-- ② 大标题 + 玫瑰笔触（两侧各一枝花） -->
    <view class="an-tt">
      <image class="an-tt-sprig is-l" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      <image class="an-tt-sprig is-r" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      <text class="an-tt-t serif">我的 {{y}} 时光档案</text>
      <view class="an-tt-brush"></view>
    </view>

    <!-- ③ 两张水彩统计卡：珍藏票根 / 走过城市 -->
    <view class="an-stats">
      <view class="an-stat is-rose">
        <image class="an-stat-bg" src="{{art.panRose}}" mode="aspectFit" aria-hidden="true" />
        <view class="an-stat-lab">
          <image class="an-stat-sp" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
          <text class="an-stat-lab-t">珍藏票根</text>
        </view>
        <view class="an-stat-n">
          <text class="an-stat-v">{{s.total}}</text>
          <text class="an-stat-u">张</text>
        </view>
        <image class="an-stat-do" src="{{ic.ticket}}" mode="aspectFit" aria-hidden="true" />
        <image class="an-stat-sprig" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      </view>

      <view class="an-stat is-sage">
        <image class="an-stat-bg" src="{{art.panSage}}" mode="aspectFit" aria-hidden="true" />
        <view class="an-stat-lab">
          <image class="an-stat-sp" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
          <text class="an-stat-lab-t">走过城市</text>
        </view>
        <view class="an-stat-n">
          <text class="an-stat-v is-sage">{{s.cities}}</text>
          <text class="an-stat-u is-sage">座</text>
        </view>
        <image class="an-stat-do" src="{{ic.plane}}" mode="aspectFit" aria-hidden="true" />
        <image class="an-stat-sprig is-r" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <!-- ④ 年度精选：玫瑰标签压在拼贴左上角 -->
    <view class="an-sec">
      <image class="an-sec-sp" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
      <view class="an-sec-tag"><text class="an-sec-tag-t">年度精选</text></view>
      <image class="an-sec-sp is-r" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
      <image class="an-sec-heart" src="{{art.heart}}" mode="aspectFit" aria-hidden="true" />
    </view>

    <!-- ⑤ 照片拼贴：四张齿边白框 + 两枚邮戳 + 编号标签 + 花枝 -->
    <view class="an-collage">
      <view class="an-grid">
        <view
          wx:for="{{picks}}"
          wx:key="id"
          wx:for-item="p"
          class="an-cell"
          style="transform:rotate({{p.tilt}}deg);"
        >
          <view class="an-frame">
            <image class="an-frame-bg" src="{{p.bg}}" mode="aspectFit" aria-hidden="true" />
            <view class="an-frame-in">
              <image wx:if="{{p.img}}" class="an-frame-img" src="{{p.img}}" mode="aspectFill" />
              <view wx:else class="an-frame-fb">
                <image class="an-frame-fb-ic" src="{{p.ico}}" mode="aspectFit" aria-hidden="true" />
                <text class="an-frame-fb-t">{{p.typeText}}</text>
              </view>
            </view>
            <image class="an-frame-tape" src="{{p.tape}}" mode="aspectFit" aria-hidden="true" />
          </view>
        </view>
      </view>

      <!-- 邮戳：圆环与注销波浪是图形，城市与日期是真文本（同时光机页） -->
      <!-- wx:key 用 index 不用 city：两枚戳可能落在同一座城市，就会撞 key -->
      <view
        wx:for="{{pm}}"
        wx:key="index"
        wx:for-item="k"
        class="an-pm {{index === 0 ? 'is-1' : 'is-2'}}"
      >
        <image class="an-pm-ring" src="{{art.pm.ring}}" mode="aspectFit" aria-hidden="true" />
        <image class="an-pm-wave" src="{{art.pm.wave}}" mode="aspectFit" aria-hidden="true" />
        <view class="an-pm-in">
          <text class="an-pm-city">{{k.city}}</text>
          <text class="an-pm-l">{{k.dd}}</text>
          <text class="an-pm-l">{{k.mm}}</text>
          <text class="an-pm-l">{{k.yy}}</text>
        </view>
      </view>

      <!-- 编号标签（票根编号后六位） -->
      <view class="an-tag-no"><text class="an-tag-no-t">No. {{no}}</text></view>

      <image class="an-spot is-a" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      <image class="an-spot is-b" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
    </view>

    <!-- ⑥ AI 年度结语 -->
    <view class="an-ai">
      <image class="an-ai-bg" src="{{art.panCream}}" mode="aspectFit" aria-hidden="true" />
      <view class="an-ai-band"></view>
      <image class="an-ai-band-sp" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      <view class="an-ai-body">
        <view class="an-ai-h">
          <text class="an-ai-h-t">AI 年度结语</text>
          <view class="an-ai-h-brush"></view>
        </view>
        <text class="an-ai-p" wx:for="{{ai}}" wx:key="index">{{item}}</text>
      </view>
      <view class="an-ai-stamp">
        <image class="an-ai-stamp-ic" src="{{art.stamp}}" mode="aspectFit" aria-hidden="true" />
        <image class="an-ai-stamp-wave" src="{{art.stampWave}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <!-- ⑦ 两枚按钮：重新生成（描边）/ 生成分享海报（玫瑰实底） -->
    <view class="an-acts">
      <view class="an-act is-redo pressable" hover-class="press-item-hover" bindtap="redoAi" aria-role="button" aria-label="重新生成年度结语">
        <image class="an-act-ic" src="{{ic.refresh}}" mode="aspectFit" aria-hidden="true" />
        <text class="an-act-t">{{closing ? '正在重写…' : '重新生成'}}</text>
      </view>
      <view class="an-poster-row">
        <view class="an-sparks is-l">
          <view class="an-spark"></view>
          <view class="an-spark is-2"></view>
          <view class="an-spark is-3"></view>
        </view>
        <view class="an-act is-poster pressable" hover-class="press-item-hover" bindtap="save" aria-role="button" aria-label="生成分享海报并存入相册">
          <image class="an-act-ic" src="{{ic.send}}" mode="aspectFit" aria-hidden="true" />
          <text class="an-act-t">{{exporting ? '正在生成…' : '生成分享海报'}}</text>
        </view>
        <view class="an-sparks is-r">
          <view class="an-spark"></view>
          <view class="an-spark is-2"></view>
          <view class="an-spark is-3"></view>
        </view>
      </view>
    </view>
    <view class="hint">9:16 竖版长图 · 存进相册，右下角已带品牌水印</view>
    <view class="safe-bottom"></view>
  </block>

  <!-- 导出用画布：放在屏外，不占版面（wx:if 包住就取不到节点，卡面会永远空白） -->
  <canvas type="2d" id="annualCanvas" class="an-canvas" aria-hidden="true"></canvas>
</view>

<!-- M5 隐私授权弹窗（saveImageToPhotosAlbum 相册写入；与 card/art 一致） -->
<privacy-sheet />
