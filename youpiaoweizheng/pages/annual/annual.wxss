/* pages/annual/annual.wxss —— v5.1 G1 我的时光年报（v6.5 六主题令牌变量化）
   注：年报海报由 annual.js 的 Canvas 绘制，颜色不走 CSS 变量，本文件只改 UI 部分。 */
page { background: var(--bg, var(--paper)); }
.page {
  padding-top: 30rpx;
  background: var(--bg, var(--paper));
  color: var(--text, var(--ink));
}

/* 加载/空态通用 */
.empty { color: var(--text2); }
.state {
  padding: 200rpx 60rpx;
  text-align: center;
  color: var(--text2);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.st-ico { font-size: 80rpx; margin-bottom: 24rpx; }
.nf-btn {
  margin: 40rpx auto 0;
  width: 320rpx;
  padding: 20rpx 0;
  border-radius: 44rpx;
  background: var(--accent);
  color: var(--on-primary);
  font-size: 27rpx;
  letter-spacing: 2rpx;
  text-align: center;
  box-shadow: var(--card-shadow, 0 10rpx 26rpx rgba(var(--text-rgb), 0.3));
}

/* —— 顶部四格摘要 —— */
.sum-row {
  display: flex;
  gap: 16rpx;
  margin: 10rpx 32rpx 8rpx;
}
.sum {
  flex: 1;
  background: var(--card-bg, var(--card));
  border: var(--card-border, 1rpx solid var(--border));
  border-radius: var(--card-r, 20rpx);
  padding: 22rpx 8rpx 18rpx;
  text-align: center;
  box-shadow: var(--card-shadow, 0 6rpx 18rpx rgba(var(--text-rgb), 0.07));
}
.sum .n {
  font-family: var(--font-title, serif);
  /* v6.6.0 动效1口径：40pt(≈76rpx@393pt画布) Bold 玫粉 #D9A0A6；tabular-nums 位数变化不抖动 */
  font-size: 76rpx;
  font-weight: 700;
  color: #D9A0A6;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  line-height: 1.15;
}
.sum .k {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text2);
  letter-spacing: 1rpx;
}
.sum-cap {
  margin: 14rpx 32rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text2);
  letter-spacing: 1rpx;
}

/* —— 9:16 年报海报舞台 —— */
.stage {
  margin: 34rpx 32rpx 0;
  border-radius: var(--card-r, 24rpx);
  overflow: hidden;
  box-shadow: var(--card-shadow, 0 18rpx 50rpx rgba(var(--text-rgb), 0.22));
}
.annual-canvas { width: 686rpx; height: 1219rpx; display: block; }
.hint {
  margin: 16rpx 32rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--text2);
  letter-spacing: 1rpx;
}

/* —— 操作 —— */
.btn-share {
  margin: 20rpx 32rpx 0;
  background: transparent;
  border: 2rpx solid var(--border);
  border-radius: 28rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  color: var(--text2);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
.btn-share::after { border: none; }
.safe-bottom { height: 80rpx; }
