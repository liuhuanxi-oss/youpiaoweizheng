<!-- pages/detail/detail.wxml —— v6.4 票根详情时光卡（品牌全案 · 稿屏2 一比一）
     主卡：鹅黄胶带 + 封面照片 + 出血邮戳 + 标题/类型chip + 地点时间 + 场馆 + 票号行(红心) + 底缘齿孔
     其下：手写风 AI 文案（打字机）+ 信息面板 + 「修复/重绘/分享」三胶囊
     业务保留：周年彩蛋 / 演示票提示 / 同场印记 / 广告位 / notFound 空态 -->

<!-- M4.5 骨架屏 -->
<view class="tk-page theme-{{theme}}" wx:if="{{skeleton}}">
  <view class="sk-photo skeleton-bone"></view>
  <view class="sk-card skeleton-bone"></view>
  <view class="sk-card short skeleton-bone"></view>
</view>

<view class="tk-page theme-{{theme}} dtc-page" wx:elif="{{t}}">

  <!-- 4.15.0 周年彩蛋（品牌稿外既有功能，保留） -->
  <view class="egg-layer" wx:if="{{eggShow}}" aria-hidden="true">
    <view
      class="confetti"
      wx:for="{{confetti}}"
      wx:key="i"
      style="left:{{item.l}}%; width:{{item.w}}rpx; height:{{item.h}}rpx; border-radius:{{item.r}}rpx; background:{{item.c}}; animation-delay:{{item.d}}ms;"
    ></view>
    <view class="anniv-badge">
      <view class="anniv-seal">
        <view class="anniv-ring"></view>
        <view class="anniv-core"><text class="anniv-n">{{anniv}}</text><text class="anniv-u">周年</text></view>
      </view>
      <view class="anniv-text">值得纪念的日子</view>
    </view>
  </view>

  <view class="demo-tip" wx:if="{{t.isDemo}}">演示票根 · 示例数据，收藏你自己的票后这里就是你的回忆</view>

  <!-- ===== 时光卡主卡 ===== -->
  <view class="dtc-card">
    <view class="b-tape dtc-tape"></view>

    <!-- 封面照片：装进一枚邮票（白边 + 四边齿孔，品牌全案·稿屏4）
         点击全屏预览；无图落纸票兜底 -->
    <view class="dtc-photo">
      <view class="dtc-stamp-frame">
        <image
          wx:if="{{t.img && !imgFail}}"
          class="dtc-img {{imgLoaded ? 'ld' : ''}}"
          src="{{t.img}}"
          mode="aspectFill"
          bindload="onImgLoad"
          binderror="onImgError"
          bindtap="previewPhoto"
          aria-role="button"
          aria-label="点击全屏查看票根原图"
        />
        <view class="dtc-img-fb" wx:else>
          <image class="dtc-fb-ic" src="{{icons.iTicketEmpty}}" mode="aspectFit" aria-hidden="true" />
          <text class="dtc-fb-title">{{t.title}}</text>
        </view>
      </view>
      <!-- 出血邮戳（b-stamp 公共类：虚线双环 + 城市/日/月年三行） -->
      <view class="b-stamp dtc-stamp">
        <view class="b-stamp-in">
          <text class="b-stamp-city">{{t.stampCity}}</text>
          <text class="b-stamp-date">{{t.stampD}}</text>
          <text class="b-stamp-date">{{t.stampMY}}</text>
        </view>
      </view>
      <view class="anniv-chip" wx:if="{{anniv}}">
        <text>今天 {{anniv}} 周年</text>
        <image class="anniv-chip-ic" src="{{icons.iSpark}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <!-- 标题 + 星点 + 类型 chip（灰玫粉实底） -->
    <view class="dtc-title-row">
      <text class="dtc-title">{{t.title}}</text>
      <image class="dtc-title-star" src="{{icons.iSpark}}" mode="aspectFit" aria-hidden="true" />
      <text class="dtc-chip">{{typeText}}</text>
    </view>

    <!-- 三行信息（品牌全案·稿屏4：线性图标 + 标签 + 值，票号落虚线小票框）
         7.0.0 修：原为 emoji（📍🏛🎫）当图标，且把地点/时间拆成两行、票号另起一块；
         现按设计稿合成三行，与 6 套主题的线性图标体系统一。 -->
    <view class="dtc-rows">
      <view class="dtc-row">
        <image class="dtc-row-ic" src="{{icons.iRowTime}}" mode="aspectFit" aria-hidden="true" />
        <text class="dtc-row-k">时间</text>
        <text class="dtc-row-v">{{t.date || '未记日期'}}{{t.time ? ' ' + t.time : ''}}</text>
      </view>
      <view class="dtc-row">
        <image class="dtc-row-ic" src="{{icons.iRowPlace}}" mode="aspectFit" aria-hidden="true" />
        <text class="dtc-row-k">地点</text>
        <text class="dtc-row-v">{{t.city || '未记地点'}}{{t.venue ? ' · ' + t.venue : ''}}</text>
      </view>
      <view class="dtc-row">
        <image class="dtc-row-ic" src="{{icons.iRowNo}}" mode="aspectFit" aria-hidden="true" />
        <text class="dtc-row-k">票号</text>
        <text class="b-serial dtc-row-serial">No. {{t.no}}</text>
        <image
          class="dtc-heart pressable"
          src="{{t.fav ? icons.iHeartOn : icons.iHeart}}"
          mode="aspectFit"
          catchtap="toggleFav"
          aria-role="button"
          aria-label="{{t.fav ? '取消收藏' : '收藏'}}"
        />
      </view>
    </view>

    <!-- 底缘齿孔撕裂线（b-perf：与页面背景同色形成半圆孔） -->
    <view class="b-perf dtc-perf"></view>
  </view>

  <!-- 同场印记（品牌稿外既有功能，保留为最小一行） -->
  <view class="dtc-same" wx:if="{{t.eventKey}}">
    <view class="b-dash-path dtc-same-dash"></view>
    <image class="dtc-same-ic" src="{{icons.iSpark}}" mode="aspectFit" aria-hidden="true" />
    <text class="dtc-same-txt">{{sameText}}</text>
  </view>

  <!-- ===== AI 时光手记（品牌全案·稿屏4：浅绿卡 + 左侧竖条 + 徽章；打字机保留）
       无文案时点按生成 ===== -->
  <view class="dtc-memo" bindtap="{{t.aiCaption ? '' : 'genCaption'}}">
    <view class="dtc-memo-bar"></view>
    <view class="dtc-memo-badge">
      <image class="dtc-memo-badge-ic" src="{{icons.iSpark}}" mode="aspectFit" aria-hidden="true" />
      <text>AI 时光手记</text>
    </view>
    <view class="dtc-memo-txt" wx:if="{{t.aiCaption}}">
      <text>{{captionShow || t.aiCaption}}</text><text class="cap-cursor" wx:if="{{captionTyping}}">|</text>
    </view>
    <view class="dtc-memo-txt dim" wx:else>
      <text>{{genLoading ? 'AI 正在为你落笔…' : 'AI 还没为这一页写字 · 点一下，让它替你记下那天'}}</text>
    </view>
  </view>

  <!-- ===== 补充信息（品牌稿外的既有字段：座位/票价/天气有则随行）
       7.0.0 修：原面板把时间/地点/票号又列了一遍，与卡内三行重复；现只留有值才出现的补充项 ===== -->
  <view class="dtc-fields" wx:if="{{t.seat || t.price || weatherText}}">
    <view class="dtc-f-row" wx:if="{{t.seat}}">
      <image class="dtc-f-ic" src="{{icons.iSeat}}" mode="aspectFit" aria-hidden="true" />
      <text class="dtc-f-k">座位</text>
      <text class="dtc-f-v">{{t.seat}}</text>
    </view>
    <view class="dtc-f-row" wx:if="{{t.price}}">
      <image class="dtc-f-ic" src="{{icons.iPrice}}" mode="aspectFit" aria-hidden="true" />
      <text class="dtc-f-k">票价</text>
      <text class="dtc-f-v">¥{{t.price}}<text wx:if="{{t.source}}" decode="{{false}}"> · {{t.source}}</text></text>
    </view>
    <view class="dtc-f-row" wx:if="{{weatherText}}">
      <image class="dtc-f-ic" src="{{icons.iWeather}}" mode="aspectFit" aria-hidden="true" />
      <text class="dtc-f-k">当晚天气</text>
      <text class="dtc-f-v">{{weatherText}}</text>
    </view>
  </view>

  <!-- ===== 底部操作：修复 / 重绘 / 分享（品牌稿屏2 三胶囊；7.0.0 换线性图标） ===== -->
  <view class="dtc-actions">
    <view class="dtc-btn ghost pressable" hover-class="press-hover" bindtap="goRepair" aria-role="button" aria-label="AI 修复">
      <image class="dtc-btn-ic" src="{{icons.iFix}}" mode="aspectFit" aria-hidden="true" />
      <text>修复</text>
    </view>
    <view class="dtc-btn sage pressable" hover-class="press-hover" bindtap="goArt" aria-role="button" aria-label="AI 重绘">
      <image class="dtc-btn-ic" src="{{icons.iArt}}" mode="aspectFit" aria-hidden="true" />
      <text>重绘</text>
    </view>
    <button class="dtc-btn solid share-hit" open-type="share" hover-class="none" aria-label="分享">
      <image class="dtc-btn-ic" src="{{icons.iShare}}" mode="aspectFit" aria-hidden="true" />
      <text>分享</text>
    </button>
  </view>

  <!-- 导航「···」更多（生成纪念卡片 / AI 文案） -->
  <view class="dtc-more pressable" bindtap="onMore" aria-role="button" aria-label="更多操作">···</view>

  <!-- 4.21.0 底部 Banner 广告位（品牌稿无此项，商业基建保留在页尾） -->
  <view class="ad-banner-wrap card" wx:if="{{adsBannerId}}">
    <view class="ad-cap">时光 · 赞助内容</view>
    <ad unit-id="{{adsBannerId}}" type="banner" binderror="onAdError"></ad>
  </view>
  <view class="tk-safe-bottom"></view>
</view>

<!-- 4.18.0 notFound 空态（分享落地/过期 id） -->
<view class="tk-page theme-{{theme}} dtc-page" wx:else>
  <view class="empty">
    <image class="nf-ic" src="{{icons.iTicketEmpty}}" mode="aspectFit" aria-hidden="true" />
    <view>这张时光券不在你的册子里</view>
    <view class="nf-sub">它可能正在别人的回忆里 · 收好自己的第一张，让时光有迹可循</view>
    <view class="nf-btn pressable" hover-class="press-hover" bindtap="goScan" aria-role="button" aria-label="去收第一张票">去收第一张票</view>
  </view>
</view>
