/* pages/detail/detail.wxss —— v6.4 票根详情时光卡（品牌全案 · 稿屏2 一比一）
   品牌令牌见 app.wxss .theme-paper；辅助图形公共类 b-tape/b-stamp/b-perf/b-serial/b-spark/b-dash-path 全局复用 */

.dtc-page { min-height: 100vh; }

/* ===== A3 顶栏毛玻璃渐变 =====
   内容滚到导航栏下方时淡出（透明度由 onPageScroll 给），不是一块硬边。
   底色/渐变由 JS 按主题编译成内联 style（本节点在根节点外，吃不到 --bg 变量），
   这里只管定位与模糊。pointer-events:none：它压在内容上，不能抢点击。 */
.dtc-topfx {
  position: fixed; left: 0; right: 0; top: 0;
  height: 120rpx;
  z-index: 9;
  pointer-events: none;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  opacity: 0;
}

/* ===== 时光卡主卡 ===== */
.dtc-card {
  position: relative;
  margin: 28rpx 32rpx 0;
  padding: 24rpx 24rpx 0;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, 32rpx);
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, 0 10rpx 36rpx rgba(var(--text-rgb), 0.08));
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
  overflow: visible;
}
.dtc-tape { left: 40rpx; top: -18rpx; }

/* 删除票根：主卡收拢淡出再跳页（260ms，与 detail.js 的 LEAVE_MS 必须同值）。
   原先删完干等 700ms 什么都不发生，用户会怀疑到底删没删掉，等的时候还容易再点一次。 */
.dtc-card.leaving { animation: dtc-leave 260ms var(--ease-smooth) forwards; }
@keyframes dtc-leave {
  to { opacity: 0; transform: translateY(24rpx) scale(0.94); }
}
@media (prefers-reduced-motion: reduce) {
  /* 位移收拢会让人不适：只留淡出，时长与 JS 的 LEAVE_MS 仍要对齐（否则跳页早于淡完） */
  @keyframes dtc-leave {
    to { opacity: 0; }
  }
}

/* 封面照片 */
.dtc-photo { position: relative; }
/* A3 视差裁剪框：照片比框高 12%（上缘 -12%），滚动时整框上移最多 20px（见 onPageScroll），
   上移的余量就是这 12%（440rpx × 12% ≈ 26px），所以永远露不出框底。
   位移挂在这一层而不是照片上：照片自己的 transform 要留给「按压缩放」的过渡。 */
.dtc-par {
  position: relative;
  width: 100%; height: 440rpx;
  border-radius: 4rpx;   /* 收进邮票白框内，跟着外框走小圆角 */
  overflow: hidden;
  background: var(--soft, #F5EDE2);
}
.dtc-img {
  width: 100%; height: 112%;
  margin-top: -12%;
  background: var(--soft, #F5EDE2);
  /* opacity 被「加载淡入」独用（0.4s），按压只能走 transform；
     页面级声明会盖掉全局 .pressable 的同名属性，缓动必须在这里补写 */
  opacity: 0;
  transition: opacity 0.4s, transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  display: block;
}
/* 前庭敏感：压掉视差位移（位移量在内联 style 上，故要 !important 才盖得住） */
@media (prefers-reduced-motion: reduce) {
  .dtc-par { transform: none !important; }
}
.dtc-img.ld { opacity: 1; }
/* 照片按压只缩不放暗——放暗会与加载淡入抢 opacity，呈现为慢半拍的滞后 */
.dtc-img-hover { transform: scale(0.97); }
/* 无图 / 加载失败兜底：**盖在** .dtc-par 上（同一块 440rpx 的票位），200ms 淡入。
   绝对定位 + 与邮票白框内边同值的 16rpx 内缩，正好贴住照片框；
   在文档流里的话它会把邮票撑高，换图那一下就会跳（旧版 400rpx vs 440rpx 正是这么跳的）。 */
.dtc-img-fb {
  position: absolute; left: 16rpx; top: 16rpx; right: 16rpx; bottom: 16rpx;
  border-radius: 4rpx;   /* 与 .dtc-par 同值，收进同一个白框 */
  background: linear-gradient(160deg, var(--bg), var(--soft));
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 18rpx;
  /* 淡入一律复用全局 .fade-in-200（wxml 上挂着），降级口径也就跟着它走，别另写一份 */
}
.dtc-fb-ic { width: 110rpx; height: 110rpx; }
.dtc-fb-title { font-size: 30rpx; font-weight: 700; color: var(--brown, #6B5B50); }

/* ===== 邮票外框（品牌全案·稿屏4：照片装进一枚邮票）=====
   白边 16rpx；四边齿孔用 radial-gradient 挖出页面底色的半圆。
   齿孔拆两片：::before 管上下（repeat-x）、::after 管左右（repeat-y）——
   单个元素没法同时按两个方向平铺。挖不干净时会退化成「白边照片」，不会破版。 */
.dtc-stamp-frame {
  position: relative;
  padding: 16rpx;
  background: var(--card, #FFFFFF);
  border-radius: 6rpx;
  box-shadow: 0 10rpx 28rpx rgba(var(--text-rgb, 107, 91, 80), 0.16);
}
.dtc-stamp-frame::before {
  content: '';
  position: absolute; left: 0; right: 0; top: -1rpx; bottom: -1rpx;
  background-image:
    radial-gradient(circle at 50% 0, var(--bg, #FAF5EE) 8rpx, transparent 8rpx),
    radial-gradient(circle at 50% 100%, var(--bg, #FAF5EE) 8rpx, transparent 8rpx);
  background-size: 26rpx 15rpx, 26rpx 15rpx;
  background-position: 0 0, 0 100%;
  background-repeat: repeat-x, repeat-x;
  pointer-events: none;
}
.dtc-stamp-frame::after {
  content: '';
  position: absolute; top: 0; bottom: 0; left: -1rpx; right: -1rpx;
  background-image:
    radial-gradient(circle at 0 50%, var(--bg, #FAF5EE) 8rpx, transparent 8rpx),
    radial-gradient(circle at 100% 50%, var(--bg, #FAF5EE) 8rpx, transparent 8rpx);
  background-size: 15rpx 26rpx, 15rpx 26rpx;
  background-position: 0 0, 100% 0;
  background-repeat: repeat-y, repeat-y;
  pointer-events: none;
}

/* 出血邮戳（比瀑布卡戳更大） */
.dtc-stamp {
  position: absolute; right: -12rpx; top: -18rpx;
  width: 116rpx; height: 116rpx;
  box-shadow: 0 6rpx 16rpx rgba(var(--text-rgb), 0.14);
}
.dtc-stamp .b-stamp-city { font-size: 17rpx; }
.dtc-stamp .b-stamp-date { font-size: 15rpx; }

.anniv-chip {
  position: absolute;
  top: 22rpx; left: 22rpx;
  display: flex; align-items: center; gap: 6rpx;
  font-size: 19rpx;
  color: var(--stamp, #C26B5E);
  background: var(--card-bg, var(--card));
  border: 1rpx solid var(--butter);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.anniv-chip-ic { width: 20rpx; height: 20rpx; }

/* 标题 + 类型 chip */
.dtc-title-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 26rpx;
}
.dtc-title {
  font-size: 40rpx; font-weight: 700;
  color: var(--brown, #6B5B50);
  flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dtc-chip {
  flex-shrink: 0;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: var(--rose, #D9A0A6);
  color: var(--on-primary);
  font-size: 22rpx; font-weight: 600;
}

.dtc-title-star { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; }

/* 三行信息（品牌全案·稿屏4：线性图标 + 标签 + 值）
   7.0.0 修：取代原「地点/场馆两行文本 + 票号独立色块」的写法 */
.dtc-rows { margin-top: 20rpx; }
.dtc-row { display: flex; align-items: center; gap: 16rpx; padding: 13rpx 0; }
.dtc-row-ic { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; }
.dtc-row-k {
  flex: 0 0 72rpx;
  font-size: 25rpx; color: var(--text2, #A5968A);
}
.dtc-row-v {
  flex: 1; min-width: 0;
  font-size: 27rpx; font-weight: 500;
  color: var(--brown, #6B5B50);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dtc-row-serial { flex: 0 0 auto; }
.dtc-heart { flex: 0 0 40rpx; width: 40rpx; height: 40rpx; margin-left: auto; }

/* 底缘齿孔撕裂线：负 margin 撑满卡宽 */
.dtc-perf { margin: 24rpx -24rpx 0; }

/* ===== 同场印记（最小一行） ===== */
.dtc-same {
  display: flex; align-items: center; gap: 14rpx;
  margin: 24rpx 44rpx 0;
}
.dtc-same-dash { flex: 1; }
.dtc-same-ic { flex: 0 0 24rpx; width: 24rpx; height: 24rpx; }
.dtc-same-txt {
  font-size: 22rpx; color: var(--rose, #D9A0A6);
  white-space: nowrap;
}

/* ===== 8.1.0 同场票根墙：看别人 / 放自己 ===== */
.dtc-wall {
  margin: 22rpx 32rpx 0;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
}
.dtc-wall-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 26rpx; }
.dtc-wall-row + .dtc-wall-row { border-top: 1rpx solid var(--border); }
.dtc-wall-ic { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; }
.dtc-wall-body { flex: 1; min-width: 0; }
.dtc-wall-name { font-size: 27rpx; color: var(--text); }
.dtc-wall-desc { margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: var(--text2); }
.dtc-wall-go { flex: 0 0 auto; font-size: 24rpx; color: var(--rose, #D9A0A6); }
.dtc-wall-switch { flex: 0 0 auto; transform: scale(.85); }

/* ===== AI 时光手记卡（品牌全案·稿屏4：浅绿底 + 左侧竖条 + 徽章） =====
   7.0.0 修：原为页面底色上直排的手写体 + 一颗 ✦，与设计稿的「卡」形态不符 */
.dtc-memo {
  position: relative;
  margin: 34rpx 32rpx 0;
  padding: 26rpx 26rpx 28rpx 30rpx;
  background: var(--sage-soft, #E8F0E6);
  border: 1rpx solid var(--sage-line, rgba(169, 195, 166, 0.45));
  border-radius: 22rpx;
  overflow: hidden;
}
.dtc-memo-bar {
  position: absolute; left: 0; top: 22rpx; bottom: 22rpx;
  width: 6rpx; border-radius: 0 6rpx 6rpx 0;
  background: var(--sage, #A9C3A6);
}
.dtc-memo-badge {
  display: inline-flex; align-items: center; gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--card, #FFFFFF);
  color: var(--brown, #6B5B50);
  font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx;
}
.dtc-memo-badge-ic { width: 28rpx; height: 28rpx; }
.dtc-memo-txt {
  margin-top: 18rpx;
  font-size: 31rpx; line-height: 1.85;
  color: var(--brown, #6B5B50);
}
.dtc-memo-txt.dim { color: var(--text2, #A5968A); font-size: 27rpx; }
/* 生成失败：手记卡红抖一次（关键帧在 app.wxss，页面自己挂类；抖完由 JS 摘掉类名）。
   本类**不写 transition** —— 写了会盖掉全局 .pressable 的按压回弹，卡片会变得按下去没反应。
   降级下抖动被压成 translateX(0)，红边与内圈留着，仍有一句「刚才那下失败了」。 */
.dtc-memo.shake-err {
  animation: shake-err 320ms ease-out 1;
  border-color: var(--stamp, #C26B5E);
  box-shadow: inset 0 0 0 3rpx var(--stamp, #C26B5E);
}

/* ===== 补充信息面板（座位/票价/天气；全空时整块不渲染） ===== */
.dtc-fields {
  margin: 28rpx 32rpx 0;
  padding: 10rpx 26rpx;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, 22rpx);
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, 0 6rpx 24rpx rgba(var(--text-rgb), 0.05));
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}
.dtc-f-row {
  display: flex; align-items: center; gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border, #EFE5D8);
}
.dtc-f-row:last-child { border-bottom: none; }
.dtc-f-ic { flex: 0 0 32rpx; width: 32rpx; height: 32rpx; }
.dtc-f-k { flex: 0 0 140rpx; font-size: 25rpx; color: var(--text2, #A5968A); }
.dtc-f-v {
  flex: 1; min-width: 0;
  font-size: 25rpx; color: var(--brown, #6B5B50); font-weight: 500;
  text-align: right;
}

/* ===== 底部操作三胶囊 ===== */
.dtc-actions {
  display: flex; gap: 18rpx;
  margin: 40rpx 32rpx 0;
}

/* L4 朋友圈引导行：画一颗微信右上角的胶囊，比写一句「点更多」好认
   （用 currentColor 取行内的 muted 色，不再单开一组变量） */
.dtc-tl {
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx;
  margin: 26rpx 32rpx 0;
  font-size: 23rpx;
  color: var(--text, #6B5B50);
  opacity: 0.5;
}
.dtc-tl-cap {
  display: flex; align-items: center; justify-content: center; gap: 5rpx;
  padding: 5rpx 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
}
.dtc-tl-dot { width: 6rpx; height: 6rpx; border-radius: 50%; background: currentColor; }
.dtc-btn {
  flex: 1; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx; font-weight: 600;
}
/* 6.4.0 TabBar/详情规范图口径：修复=鼠尾草绿浅底 / 重绘=鹅黄浅底 / 分享=灰玫粉实底 */
.dtc-btn.ghost {
  background: var(--sage);
  color: #5F7F5C;
}
.dtc-btn.sage {
  background: var(--butter);
  color: #8A6F3A;
}
.dtc-btn.solid {
  background: var(--rose, #D9A0A6);
  color: var(--on-primary);
  box-shadow: 0 8rpx 22rpx var(--rose);
}
/* 胶囊内图标（7.0.0：取代原 ✦ / 🎨 / 🔗 emoji） */
.dtc-btn-ic { width: 32rpx; height: 32rpx; margin-right: 12rpx; flex: 0 0 32rpx; }

/* 分享 button 样式重置（原生 button → 胶囊外观） */
.share-hit {
  margin: 0; padding: 0;
  border: none; border-radius: 999rpx;
  line-height: 88rpx;
  font-size: 28rpx; font-weight: 600;
}
.share-hit::after { border: none; display: none; }

/* 导航「···」更多（原生导航栏不可挂自定义按钮 → 右上浮动圆钮承接） */
.dtc-more {
  position: fixed; right: 28rpx; top: 20rpx; z-index: 30;
  width: 64rpx; height: 64rpx; line-height: 58rpx; text-align: center;
  border-radius: 50%;
  background: var(--card-bg, var(--card));
  color: var(--brown, #6B5B50);
  font-size: 34rpx; font-weight: 700; letter-spacing: 2rpx;
  box-shadow: 0 6rpx 18rpx rgba(var(--text-rgb), 0.14);
}

/* ===== 骨架 ===== */
.sk-photo { height: 320rpx; margin: 20rpx 32rpx 26rpx; border-radius: 28rpx; }
.sk-card { height: 260rpx; margin: 0 32rpx 26rpx; border-radius: 28rpx; }
.sk-card.short { height: 120rpx; }

/* ===== 演示票提示条 ===== */
.demo-tip {
  margin: 0 32rpx 18rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--card-bg, var(--card));
  border: 1rpx solid var(--border);
  color: var(--text2);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ===== 4.15.0 周年彩蛋（既有功能，样式保留） ===== */
.egg-layer {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 90;
  pointer-events: none;
  overflow: hidden;
}
.confetti {
  position: absolute;
  top: -48rpx;
  opacity: 0;
  animation: confetti-fall 2s cubic-bezier(0.32, 0.72, 0, 1) forwards;
}
@keyframes confetti-fall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
  80%  { opacity: 1; }
  100% { transform: translateY(110vh) rotate(680deg); opacity: 0; }
}
.anniv-badge {
  position: absolute;
  left: 50%;
  top: 33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: anniv-slam 3.2s var(--ease-spring) forwards;
}
@keyframes anniv-slam {
  0%   { transform: translate(-50%, -50%) scale(2.3) rotate(-20deg); opacity: 0; }
  12%  { transform: translate(-50%, -50%) scale(0.94) rotate(-7deg); opacity: 1; }
  18%  { transform: translate(-50%, -50%) scale(1.06) rotate(-8deg); }
  24%  { transform: translate(-50%, -50%) scale(1) rotate(-8deg); }
  82%  { opacity: 1; }
  100% { transform: translate(-50%, -56%) scale(0.98) rotate(-8deg); opacity: 0; }
}
.anniv-seal {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.anniv-ring {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border: 3rpx dashed var(--rose, #D9A0A6);
  border-radius: 50%;
  animation: anniv-ring-pop 0.9s var(--ease-spring) 0.1s both;
}
@keyframes anniv-ring-pop {
  0%   { transform: scale(0.4); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
/* 前庭敏感：三条全压成「直接到位」——
   · 纸屑纯装饰，且基础态就是 opacity:0，压掉动画即等于不出现；
   · 印章的基础态**没有**居中位移（居中量在关键帧里），所以压掉动画必须把它补回来，
     否则徽章会偏到右下角；eggShow 由 JS 的 3.2s 定时器收尾，不会赖着不走；
   · 圆环的基础态就是「最终样子」，直接不动即可。 */
@media (prefers-reduced-motion: reduce) {
  .confetti { animation: none; }
  .anniv-badge { animation: none; transform: translate(-50%, -50%); }
  .anniv-ring { animation: none; }
}
.anniv-core {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: var(--stamp, #C26B5E);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--on-primary);
}
.anniv-n { font-size: 64rpx; font-weight: 700; line-height: 1; }
.anniv-u { font-size: 22rpx; letter-spacing: 6rpx; margin-top: 4rpx; opacity: 0.92; }
.anniv-text {
  margin-top: 18rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--stamp, #C26B5E);
  background: var(--card-bg, var(--card));
  border: 1rpx solid var(--butter, #F6DFA8);
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(46, 42, 37, 0.1);
}

/* ===== notFound 空态 ===== */
.empty {
  padding: 140rpx 60rpx;
  text-align: center;
}
.empty .nf-ic { width: 128rpx; height: 128rpx; margin-bottom: 24rpx; }
.empty > view { font-size: 30rpx; font-weight: 700; color: var(--text); }
.empty .nf-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.7;
}
/* 单页模式（朋友圈打开）下的指路行：不是按钮，只是告诉用户去哪儿点 */
.empty .nf-sp {
  margin-top: 40rpx;
  font-weight: 600;
  color: var(--primary);
}
.empty .nf-btn {
  margin: 44rpx auto 0;
  width: 340rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--rose, #D9A0A6);
  color: var(--on-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 24rpx var(--rose);
}

/* ===== 广告位 ===== */
.ad-banner-wrap { margin: 28rpx 36rpx 0; padding: 16rpx 16rpx 10rpx; }

/* ===== 打字机光标 ===== */
.cap-cursor {
  color: var(--stamp, #C26B5E);
  font-weight: 700;
  animation: cap-blink 0.85s step-end infinite;
}

@keyframes cap-blink {
  50% { opacity: 0; }
}
