<!-- pages/card/card.wxml —— 纪念卡片（品牌全案 · 稿屏6 一比一）
     卡面本体由 card.js 的 Canvas 画出来（要能导出成图、要能进分享卡图）；
     这层只负责卡面舞台与底下那两枚按钮。
     稿屏6 顶栏那行（‹ 纪念卡片 ···）走的是原生导航栏（card.json），
     右侧「···」在真机上就是微信胶囊，故页面里不再重复画一个。
     ⚠️ 图形一律走 <image src="data:image/svg+xml;base64,...">：小程序 wxml 不渲染内联 <svg>，
        且 SVG 是独立文档、不认 CSS 变量，颜色由 buildArt() 按主题编译成实色。 -->
<!-- 7.3.0 S1：朋友圈单页模式落地（无身份、不能跳页）→ 换品牌卡，见 templates/sp.wxml -->
<import src="/templates/sp.wxml" />
<block wx:if="{{sp}}"><template is="spGate" data="{{theme: theme, tip: '这里是一张收藏在别人册子里的票根'}}" /></block>

<!-- ⓪ 加载态：票根还没取回来（弱网 / 云函数冷启动可达数秒）。
     此前这一段是整页白屏——只顶着一根导航栏，用户会以为页面坏了。
     骨架直接复用 .card-canvas 的盒子（同宽高、同圆角、同倾角），卡片落位时不跳。 -->
<view class="page theme-{{theme}} cd-page" wx:if="{{loading}}">
  <view class="grain"></view>
  <view class="cd-stage">
    <view class="cd-behind"></view>
    <view class="card-canvas tk-skeleton"></view>
    <image class="cd-deco is-sprig-l" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
    <image class="cd-deco is-star-t" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
    <image class="cd-deco is-heart-r" src="{{art.heart}}" mode="aspectFit" aria-hidden="true" />
    <image class="cd-deco is-sprig-r" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
  </view>
  <view class="cd-sk-t">正在生成卡片…</view>
</view>

<view class="page theme-{{theme}} cd-page" wx:elif="{{t}}">
  <view class="grain"></view>

  <!-- 7.4.0 动效：卡面 → 按钮 → 入口依 85ms 错开浮上来（.stagger，见 app.wxss）。
       外面这层 .cd-flow 是给 :nth-child 数位次用的**纯结构层**（自身无样式，同年报的 .an-flow）：
       .stagger 的延迟按同胞位次算，页面里的 .grain 与 .safe-bottom 混进来会把位次顶偏一档。
       ⚠️ 提示条（.cd-fail）不能挂在 .cd-flow 里：它是 wx:if，一出现就把后面全体顶后一档。 -->
  <view class="cd-flow">

    <!-- ① 卡面舞台：后面垫一张玫瑰卡、前面是画布 —— 稿里那叠「手边一摞明信片」的观感 -->
    <view class="cd-stage stagger">
      <view class="cd-behind"></view>
      <canvas type="2d" id="cardCanvas" class="card-canvas"
              aria-role="img" aria-label="这张票根的纪念卡片"></canvas>
      <image class="cd-deco is-sprig-l" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      <image class="cd-deco is-star-t" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
      <image class="cd-deco is-heart-r" src="{{art.heart}}" mode="aspectFit" aria-hidden="true" />
      <image class="cd-deco is-sprig-r" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
      <!-- 画布起不来时的兜底：盖住整个卡位。原先只在控制台 warn，
           用户看到的是一个空框，只会以为「还在生成」而干等 -->
      <view class="cd-fail pressable" wx:if="{{canvasFail}}" hover-class="press-item-hover"
            bindtap="retryCanvas" aria-role="button" aria-label="重新生成卡片">
        <text class="cd-fail-t">卡片没画出来</text>
        <text class="cd-fail-s">点一下重试 · 还不行就退出重进</text>
      </view>
    </view>

    <!-- ② 两枚按钮：保存图片（描边）/ 分享给好友（玫瑰实底） -->
    <view class="cd-acts stagger">
      <view class="cd-act is-save pressable" hover-class="press-item-hover" bindtap="save"
            aria-role="button" aria-label="保存卡片到相册">
        <image class="cd-act-ic is-ink" src="{{ic.download}}" mode="aspectFit" aria-hidden="true" />
        <text class="cd-act-t">{{exporting ? '导出中…' : '保存图片'}}</text>
      </view>
      <button class="cd-act is-share" open-type="share" aria-label="把这张卡片分享给好友">
        <image class="cd-act-ic is-on" src="{{ic.share}}" mode="aspectFit" aria-hidden="true" />
        <text class="cd-act-t">分享给好友</text>
      </button>
    </view>

    <!-- ③ 低频动作：稿里没有这一行，但它们也只是低频——藏进长按/手势等于砍功能，
           故留一行轻量文字入口，视觉重量压到最低（与主按钮拉开层级） -->
    <view class="cd-links stagger">
      <view class="cd-link pressable" hover-class="press-item-hover" bindtap="redo"
            aria-role="button" aria-label="换一版 AI 文案">
        <text class="cd-link-t">{{redoing ? 'AI 重写中…' : '换一版文案'}}</text>
      </view>
      <view class="cd-link-line"></view>
      <view class="cd-link pressable" hover-class="press-item-hover" bindtap="onStyle"
            aria-role="button" aria-label="切换卡片风格">
        <text class="cd-link-t">卡片风格</text>
      </view>
      <view class="cd-link-line"></view>
      <view class="cd-link pressable" hover-class="press-item-hover" bindtap="saveXHS"
            aria-role="button" aria-label="存小红书素材图，可选成品图、封面图、步骤图">
        <text class="cd-link-t">存小红书素材</text>
      </view>
    </view>

  </view>
  <view class="safe-bottom"></view>
</view>

<!-- 4.19.1 空态：票根未命中（过期 id / 云库异常 / 分享落地）。
     此前整页挂在 wx:if="{{t}}" 下，未命中时只剩导航栏——四个卡片风格「消失」即此 bug 的真机表现。
     给明确出路而非白屏。 -->
<view class="page theme-{{theme}} cd-page" wx:elif="{{notFound}}">
  <view class="empty">
    <image class="cd-empty-ic" src="{{ic.empty}}" mode="aspectFit" aria-hidden="true" />
    <view class="e-title">这张时光券不在你的册子里</view>
    <view class="e-sub">它可能正在别人的回忆里 · 收好自己的第一张，让时光有迹可循</view>
    <view class="btn-main pressable" hover-class="press-hover" bindtap="goScan"
          aria-role="button" aria-label="去收第一张票">去收第一张票</view>
    <view class="btn-sub pressable" hover-class="press-item-hover" bindtap="goBack"
          aria-role="button" aria-label="返回">返回看看</view>
  </view>
</view>

<!-- M5 隐私授权弹窗（saveImageToPhotosAlbum 相册写入） -->
<privacy-sheet />
