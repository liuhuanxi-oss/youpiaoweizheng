/* pages/card/card.wxss —— 纪念卡片（品牌全案 · 稿屏6 一比一）
   卡面本体由 card.js 的 Canvas 绘制（要导出、要当分享卡图），颜色不随 CSS 变量走；
   本文件只管卡面舞台、两枚按钮与那行低频入口。
   六主题变量化：颜色一律读 --*；写死的十六进制只允许出现在 var(--x, #兜底) 里。 */
page { background: var(--bg, #F4EFE6); }
.cd-page {
  min-height: 100vh;
  background: var(--bg, #F4EFE6);
  color: var(--text);
  padding-top: 30rpx;
}

/* ═══ ① 卡面舞台 ═══
   画布 600×960rpx = card.js 里 W×H 的 1:1 等比（差一点就会把明信片拉扁），
   后面垫一张玫瑰卡、整体各歪一点 —— 稿里那叠「手边一摞明信片」的观感。
   歪的只是这层 CSS：canvasToTempFilePath 取的是画布位图，导出的卡片是正的。 */
.cd-stage {
  position: relative;
  width: 600rpx;
  height: 960rpx;
  margin: 24rpx auto 0;
}
.cd-behind {
  position: absolute;
  left: -18rpx; top: 14rpx; right: -18rpx; bottom: -14rpx;
  border-radius: 18rpx;
  background: var(--rose, #D9A0A6);
  opacity: 0.5;
  transform: rotate(4.6deg);
}
/* 加载态文案：卡片正下方一行，重量与 .cd-link 齐平，不喧宾夺主 */
.cd-sk-t {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--text2, #8A7B66);
}

.card-canvas {
  position: relative;
  width: 600rpx;
  height: 960rpx;
  display: block;
  border-radius: 12rpx;
  transform: rotate(-1.4deg);
  box-shadow: 0 26rpx 60rpx rgba(var(--text-rgb, 107, 91, 80), 0.24);
}
/* 卡外点缀：花枝 / 四角星 / 小粉心，撒在舞台四周（颜色由 buildArt 编译，取品牌固定色） */
.cd-deco { position: absolute; }
.cd-deco.is-sprig-l { left: -66rpx; top: 118rpx; width: 96rpx; height: 64rpx; transform: rotate(-14deg); }
.cd-deco.is-sprig-r { right: -60rpx; bottom: 74rpx; width: 92rpx; height: 61rpx; transform: scaleX(-1) rotate(-8deg); }
.cd-deco.is-star-t { right: -44rpx; top: -34rpx; width: 36rpx; height: 27rpx; }
.cd-deco.is-heart-r { left: -54rpx; bottom: 286rpx; width: 30rpx; height: 30rpx; transform: rotate(9deg); }

/* 画布初始化失败时的兜底卡：盖住整个卡位（与画布同尺寸、同圆角，不跳版）。
   7.4.0 之前这里只在控制台 warn —— 用户看到的是一个空框，还以为是「还在生成」 */
.cd-fail {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  border-radius: 12rpx;
  background: var(--card-bg, var(--card, #FBF7F0));
  border: 2rpx dashed var(--border, #D8CDBA);
  box-sizing: border-box;
}
.cd-fail-t { font-size: 28rpx; color: var(--text, #6B5B50); letter-spacing: 2rpx; }
.cd-fail-s { margin-top: 14rpx; font-size: 22rpx; color: var(--text2, #8A7B66); letter-spacing: 2rpx; }

/* ═══ ② 两枚按钮（稿里那对胶囊：左描边、右玫瑰实底） ═══ */
.cd-acts {
  display: flex;
  gap: 40rpx;
  margin: 58rpx 100rpx 0;
}
.cd-act {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  line-height: 1;
  box-sizing: border-box;
}
.cd-act-ic { width: 32rpx; height: 32rpx; }
.cd-act.is-save {
  background: transparent;
  border: 2rpx solid var(--border, #E2D9C7);
  color: var(--text);
}
.cd-act.is-share {
  background: var(--rose, #D9A0A6);
  border: 2rpx solid var(--rose, #D9A0A6);
  color: var(--on-primary, #F5F0E6);
  box-shadow: 0 12rpx 30rpx rgba(var(--text-rgb, 107, 91, 80), 0.22);
}
/* 原生 button 自带外边距、内边距、行高与一圈 ::after 边框，这里清干净只留胶囊 */
.cd-act.is-share {
  margin: 0;
  padding: 0;
  line-height: 1;
  font-weight: 600;
}
.cd-act.is-share::after { border: none; }

/* ═══ ③ 低频入口（换文案 / 卡片风格 / 存小红书） ═══
   稿屏6 没有这一行 —— 但这三件事也不常用，藏进长按或手势等于砍掉功能，
   故留一行轻量文字入口：字号压到 23rpx、只用次级文字色，与主按钮拉开两级。 */
.cd-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 12rpx 40rpx;
}
.cd-link { padding: 10rpx 6rpx; }
.cd-link-t { font-size: 23rpx; color: var(--text2); letter-spacing: 1rpx; }
.cd-link-line { width: 2rpx; height: 20rpx; background: var(--border, #E2D9C7); }

/* ═══ ④ 空态（t 未命中，配合全局 .empty） ═══ */
.cd-empty-ic { display: block; width: 96rpx; height: 96rpx; margin: 0 auto 22rpx; }
.e-title { font-size: 30rpx; font-weight: 700; color: var(--text); letter-spacing: 2rpx; }
.e-sub { margin-top: 14rpx; font-size: 24rpx; color: var(--text2); line-height: 1.7; }
.empty .btn-main { margin-top: 44rpx; }
.btn-sub { margin-top: 24rpx; text-align: center; font-size: 25rpx; color: var(--text2); padding: 12rpx 0; }
