<!-- pages/discover/discover.wxml —— 回忆地图（品牌全案 · 稿屏7 一比一）
     结构：标题（星点 + 手写体 + 玫瑰笔触）→ 水彩地图卡（邮票/花枝/星点 + 城市气泡）→ 已走过 N 城
     所有图形一律走 <image src="data:image/svg+xml;base64,...">：小程序 wxml 不渲染内联 <svg>，
     且 SVG 是独立文档、不认 CSS 变量，故颜色由 discover.js 按当前主题编译成实色。
     8.1.0 拉新 3/6：本页开始对外分享（map 场景，落点就是本页），故补了单页模式落地卡。 -->
<import src="/templates/sp.wxml" />

<!-- 朋友圈单页模式：这里读不到云库，地图必然是一座空城 —— 换成品牌落地卡，
     别让好友看见一个空地图配一个点了没反应的「去收第一张」（switchTab 在该模式下会被拒） -->
<block wx:if="{{sp}}"><template is="spGate" data="{{theme: theme, tip: '好友的回忆地图在这里，你的从第一张票根开始'}}" /></block>

<scroll-view wx:if="{{!sp}}" class="tk-page theme-{{theme}} dc-page {{enter ? 'fade-up' : ''}} {{filmOn ? 'dc-filming' : ''}}" scroll-y enhanced show-scrollbar="{{false}}"
             scroll-top="{{scrollTop}}"
             refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">

  <!-- ① 标题行：左侧星点 + 「回忆地图」手写体 + 玫瑰笔触，右侧品牌标 -->
  <view class="dc-head">
    <view class="dc-title-wrap">
      <image class="dc-title-spark" src="{{ic.spark}}" mode="aspectFit" aria-hidden="true" />
      <text class="dc-title serif">回忆地图</text>
      <view class="dc-title-brush"></view>
      <image class="dc-title-spark dc-title-spark-r" src="{{ic.spark}}" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="dc-brand">
      <image class="dc-brand-logo" src="/images/brand-logo.png" mode="aspectFit" aria-hidden="true" />
      <text class="dc-brand-name">有票为证</text>
    </view>
  </view>

  <!-- ①' 云故障 / 超上限横幅（同 album 的 tm-net）。
       失败时地图上画的会是演示城市，不说明白等于替用户编了一段没走过的旅程 -->
  <view wx:if="{{netBar}}" class="dc-net pressable" hover-class="press-item-hover" bindtap="onNetBarTap"
        aria-role="button" aria-label="{{netBar.text}}">
    <text class="dc-net-t">{{netBar.text}}</text>
  </view>

  <!-- ② 地图卡：虚线内框的水彩纸，四角点缀邮票与花枝 -->
  <view class="dc-card">
    <view class="dc-card-inner">

      <!-- 看法切换：真地图（微信原生地图，能缩放拖动 —— 默认看这张）/ 水彩中国（稿屏7 的手绘那张） -->
      <view class="dc-view">
        <view class="dc-view-b {{view === 'art' ? 'on' : ''}} pressable" hover-class="press-item-hover"
              data-view="art" bindtap="setView" aria-role="button" aria-label="看水彩地图">水彩</view>
        <view class="dc-view-b {{view === 'real' ? 'on' : ''}} pressable" hover-class="press-item-hover"
              data-view="real" bindtap="setView" aria-role="button" aria-label="看真实地图">真地图</view>
      </view>

      <!-- 左上：斜贴的邮票 + 波浪排线 -->
      <image class="dc-stamp dc-stamp-l" src="{{stampL}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-wave dc-wave-l" src="{{deco.wave}}" mode="aspectFit" aria-hidden="true" />

      <!-- 右下：另一枚 + 波浪排线；位置按稿子压在卡角上 -->
      <image class="dc-stamp dc-stamp-r" src="{{stampR}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-wave dc-wave-r" src="{{deco.wave}}" mode="aspectFit" aria-hidden="true" />

      <!-- 花枝与心形点缀（稿子里成组散落，位置固定，不随数据变） -->
      <image class="dc-sprig dc-sprig-a" src="{{deco.sprig}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-sprig dc-sprig-b" src="{{deco.sprig}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-heart dc-heart-a" src="{{deco.heart}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-heart dc-heart-b" src="{{deco.heart}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-star dc-star-a" src="{{ic.sparkSm}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-star dc-star-b" src="{{ic.sparkSm}}" mode="aspectFit" aria-hidden="true" />
      <image class="dc-star dc-star-c" src="{{ic.sparkSm}}" mode="aspectFit" aria-hidden="true" />

      <!-- 地图舞台：水彩陆地 → 时光路线 → 城市气泡，三层严格同尺寸同投影。
           宽高由 JS 下发（mapArt.STAGE_W/H）—— 气泡避让算法用的就是这两个数，
           写死在 WXSS 里迟早和算法对不上，气泡就会飘出色块。 -->
      <!-- 换层（水彩 ↔ 真地图）时加 .is-swapping：整块先淡出、换完再淡回。
           地图是原生组件，能不能吃 opacity 各机型不一致 —— 吃就得到一次交叉淡变，
           不吃也就是「原地换一张」，与改动前一样，不会更糟。 -->
      <view class="dc-stage {{swapping ? 'is-swapping' : ''}}" style="width:{{stageW}}rpx; height:{{stageH}}rpx;">
        <!-- 真地图：坐标还是那份真经纬度（城市字典 + 腾讯 LBS 算出来的），
             只是不自己画、交给微信原生地图去投影，点图钉弹的还是同一个城市面板 -->
        <map wx:if="{{view === 'real'}}" class="dc-map" latitude="{{mapLat}}" longitude="{{mapLng}}"
             scale="4" markers="{{markers}}" include-points="{{mapPts}}" bindmarkertap="onMarkerTap"
             enable-zoom enable-scroll show-location="{{false}}" aria-label="足迹地图" />

        <image wx:else class="dc-layer" src="{{land}}" mode="scaleToFill" aria-hidden="true" />
        <image wx:if="{{view !== 'real' && route}}" class="dc-layer" src="{{route}}" mode="scaleToFill" aria-hidden="true" />

        <!-- 加载中：气泡位置的呼吸骨料（300ms 后才会亮，见 utils/skeleton.js）。
             水彩陆地是装饰、立即就绪，照常显示；只有「数据算出来的点」需要占位 -->
        <view wx:if="{{skeleton}}" class="dc-sk" aria-hidden="true">
          <view class="dc-sk-b" style="left:58%; top:26%;"></view>
          <view class="dc-sk-b" style="left:36%; top:44%;"></view>
          <view class="dc-sk-b" style="left:70%; top:56%;"></view>
          <view class="dc-sk-b" style="left:48%; top:68%;"></view>
        </view>

        <!-- 8.1.0「一键成片」：播放时只画**已经亮起来**的那几个 ——
             filmLit 就是 cities 的子集（字段原样带着，见 discover.js 的 _filmTick），
             所以两种状态共用这一份气泡结构，不另造一套。 -->
        <view wx:if="{{view !== 'real'}}" wx:for="{{filmOn ? filmLit : cities}}" wx:key="city" class="dc-city" style="left:{{item.x}}rpx; top:{{item.y}}rpx;">

          <!-- 连接杆：气泡被顶开时才有长度，平时被尾巴盖住看不见 -->
          <view class="dc-stem" style="background:{{item.color}}; {{item.stemPos}};"></view>

          <!-- 气泡：贴 bottom = 在落点上方（尾巴朝下），贴 top = 在下方（尾巴朝上）。
               按下态用本页自己的 dc-bubble-hover，不能用全局 press-item-hover ——
               后者只写 scale，会把气泡的 translateX(-50%) 居中量整个盖掉，
               手一按气泡就横跳半个身位（tests/press_feedback.test.js ⑥ 钉着这条）。
               错开延迟由 JS 下发（item.d）：气泡是绝对定位的兄弟节点，
               前面还夹着图层与骨架层，:nth-child 的下标靠不住。 -->
          <view class="dc-bubble {{item.below ? 'down' : 'up'}} pressable {{enter ? 'dc-rise' : ''}}"
                hover-class="dc-bubble-hover"
                style="background:{{item.color}}; color:{{item.fg}}; {{item.bubblePos}}; width:{{item.w}}rpx; animation-delay:{{item.d}}ms;"
                data-city="{{item.city}}" bindtap="onCityTap"
                aria-role="button" aria-label="{{item.city}}，{{item.count}} 张票根">
            <text class="dc-bubble-n">{{item.city}}</text>
            <text class="dc-bubble-c">{{item.count}}</text>
          </view>

          <!-- 落点：白芯 + 主题色圆环，严格压在真实经纬度上。
               旁边的小字只在城市不多时才画（见 discover.js 的 PIN_LABEL_MAX）——
               气泡上已经写着城市名了，城市一多，这行小字就是压住气泡的碎字 -->
          <view class="dc-pin" style="border-color:{{item.color}};"></view>
          <text wx:if="{{pinLabels}}" class="dc-pin-name">{{item.city}}</text>
        </view>
      </view>

      <!-- 底部署名：已走过 N 座城市 · M 段时光。
           加载中/失败时不显示——「已走过 0 座城市」是一句数据断言，此刻并不成立。
           两个数字接数字滚动（与时光机/我的页同一套语言）；<text> 里塞不下组件，故换 <view> 承载 -->
      <view class="dc-foot" wx:if="{{!loading && !error}}">
        <view class="dc-foot-rule"></view>
        <image class="dc-foot-spark" src="{{ic.sparkSm}}" mode="aspectFit" aria-hidden="true" />
        <view class="dc-foot-txt">
          <text>已走过 </text>
          <animated-number value="{{cityCount}}" />
          <text> 座城市 · </text>
          <animated-number value="{{total}}" />
          <text> 段时光</text>
        </view>
        <image class="dc-foot-spark" src="{{ic.sparkSm}}" mode="aspectFit" aria-hidden="true" />
        <view class="dc-foot-rule"></view>
      </view>
    </view>
  </view>

  <!-- ②' 一键成片（8.1.0 拉新 3/6）：把走过的这些年一站一站演一遍，末尾可以存成一张长图。
       只在「至少两座有坐标的城、且不是云兜底的演示城市」时出现（见 utils/mapFilm.js 的 canPlay）——
       一座城播不出旅程，而演示城市不是你去过的，拿它请他回忆是骗人。 -->
  <view wx:if="{{canFilm && !loading && !error}}" class="dc-film pressable" hover-class="press-hover"
        bindtap="startFilm" aria-role="button" aria-label="一键成片：把这些年走过的路演一遍">
    <view class="dc-film-ic">
      <image class="dc-film-ic-img" src="{{ic.play}}" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="dc-film-tx">
      <text class="dc-film-t">一键成片</text>
      <text class="dc-film-s">把这些年走过的路，一站一站演一遍</text>
    </view>
    <image class="dc-film-go" src="{{ic.chevron}}" mode="aspectFit" aria-hidden="true" />
  </view>

  <!-- ③ 空态：确实一张票都没有时才说这句话（loading 期间与失败时都不许落到这里） -->
  <view wx:if="{{!loading && !error && !total}}" class="dc-empty pressable" hover-class="press-item-hover" bindtap="goHome"
        aria-role="button" aria-label="去收第一张票根">
    <image class="dc-empty-ic" src="{{ic.empty}}" mode="aspectFit" aria-hidden="true" />
    <text class="dc-empty-t">还没有足迹</text>
    <text class="dc-empty-s">收进第一张票根，地图就开始点亮</text>
    <!-- 按钮只是把出路画出来（整块本就可点，点击在这里冒泡到外层 goHome），
         故标 aria-hidden：读屏已经在外层念过同一件事，别念两遍 -->
    <view class="dc-empty-btn" aria-hidden="true">收进第一张</view>
  </view>

  <!-- ③' 失败态：长得像空态是这里最要命的错——用户会以为自己攒的票根没了。
       空态说「你没有」，失败态必须说「我们没取到」（重试写法同 annual.wxml） -->
  <view wx:elif="{{error}}" class="dc-empty">
    <image class="dc-empty-ic" src="{{ic.refresh}}" mode="aspectFit" aria-hidden="true" />
    <text class="dc-empty-t">地图没取回来</text>
    <text class="dc-empty-s">网络好像不太顺，点下面重试</text>
    <view class="dc-empty-btn pressable" hover-class="press-hover" bindtap="refresh"
          aria-role="button" aria-label="重新拉取">重试</view>
  </view>

  <!-- ④ 图下方的实话（缺坐标 / 城太多画不下）：说清楚，别让票根凭空消失 -->
  <view wx:if="{{mapTip}}" class="dc-tip">{{mapTip}}</view>

  <view class="tk-safe-bottom"></view>
</scroll-view>

<!-- ============================================================
     ⑧ 播放态（8.1.0 一键成片）：固定底条 + 一张屏幕外的长图画布
     播放**不换页、不换地图**：演的就是上面那张水彩卡，只是气泡按到访先后一个个亮起
     （见 discover.js 的 _filmTick）。这里只负责报「走到哪了」和给出口。
     ============================================================ -->
<view wx:if="{{filmOn}}" class="fl-hud" aria-role="presentation">
  <!-- 演完之前：报当前这一站的年份与城市。点一下可以直接跳到结局（有人不想等） -->
  <view wx:if="{{!filmDone}}" class="fl-head pressable" hover-class="press-item-hover" bindtap="skipFilm"
        aria-role="button" aria-label="跳过播放">
    <text wx:if="{{filmNow.year}}" class="fl-year">{{filmNow.year}}</text>
    <text class="fl-city">{{filmNow.city || '正在出发'}}</text>
    <text class="fl-n">第 {{filmIdx}} / {{filmTotal}} 站 · 点一下跳过</text>
  </view>
  <!-- 演完之后：把话收成一句，出口摆上来 -->
  <view wx:else class="fl-head">
    <text class="fl-city">这些年，你走过 {{cityCount}} 座城</text>
    <text class="fl-n">都在这一张图上</text>
  </view>

  <view class="fl-bar"><view class="fl-bar-in" style="width:{{filmPct}}%;"></view></view>

  <view class="fl-acts">
    <block wx:if="{{filmDone}}">
      <view class="fl-btn is-main pressable {{saving ? 'is-busy' : ''}}" hover-class="press-hover" bindtap="saveFilm"
            aria-role="button" aria-label="把这段旅程存成长图">
        <image class="fl-btn-ic" src="{{ic.download}}" mode="aspectFit" aria-hidden="true" />
        <text>存成长图</text>
      </view>
      <!-- open-type="share" 才会走页面的 onShareAppMessage（map 场景），文案见 utils/share.js -->
      <button class="fl-btn is-ghost pressable" hover-class="press-hover" open-type="share"
              aria-label="把这段旅程发给朋友">发给朋友</button>
    </block>
    <view wx:else class="fl-btn is-ghost pressable" hover-class="press-hover" bindtap="stopFilm"
          aria-role="button" aria-label="退出播放">先不看了</view>
  </view>
</view>

<!-- 长图画布：跟着播放态建/销（省一份常驻的位图内存），位置甩到屏幕外。
     尺寸由 JS 按 dpr 与版面算好写进 node.width/height，这里的 CSS 盒子只是占位。 -->
<canvas wx:if="{{filmOn}}" type="2d" id="filmCanvas" class="fl-cv" aria-hidden="true"></canvas>

<!-- ⑤ 城市票根面板：点气泡从底部升起（稿屏7 已删掉时间轴列表，改由这里看某座城的票）。
     动效与防穿透走全局 bottom-sheet（遮罩 200ms / 面板 300ms 滑入）——
     本页原先自己写了一套（0.28s + 自己画的遮罩），与别的页口径不一致 -->
<bottom-sheet show="{{!!picked}}" bind:close="closeSheet">
  <view class="dc-sheet-head">
    <image class="dc-sheet-pin" src="{{ic.pin}}" mode="aspectFit" aria-hidden="true" />
    <text class="dc-sheet-city">{{picked}}</text>
    <text class="dc-sheet-n">· {{sheet.length}} 张</text>
    <view class="dc-sheet-x pressable" hover-class="press-item-hover" bindtap="closeSheet"
          aria-role="button" aria-label="收起">
      <image class="dc-sheet-x-ic" src="{{ic.close}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>
  <scroll-view class="dc-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{sheet}}" wx:key="id" class="dc-row pressable" hover-class="press-item-hover"
          bindtap="goDetail" data-id="{{item.id}}">
      <view class="dc-row-ic" style="background:{{item.tint}};">
        <image class="dc-row-ic-img" src="{{item.ic}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="dc-row-main">
        <text class="dc-row-title">{{item.title}}</text>
        <text class="dc-row-meta">{{item.date}}{{item.venue ? ' · ' + item.venue : ''}}</text>
      </view>
      <image class="dc-row-go" src="{{ic.chevron}}" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="tk-safe-bottom"></view>
  </scroll-view>
</bottom-sheet>

<!-- M5 隐私授权弹窗：8.1.0 起本页要调 saveImageToPhotosAlbum（存长图），同 card / art / annual 挂一份 -->
<privacy-sheet />
