/* pages/discover/discover.wxss —— 回忆地图（品牌全案 · 稿屏7 一比一）
   六主题变量化：颜色一律读 --*，写死的只有「品牌固定色」——
   那些色在六套主题下都不变（气泡五色 / 票根行四色 / 陆地三色），
   且都从 JS 下发（见 discover.js 的 BUBBLE、ROW_TINT），WXSS 里不该出现十六进制。 */
.dc-page { min-height: 100vh; }

/* ═══ ① 标题行 ═══ */
.dc-head {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  padding: 26rpx 28rpx 10rpx;
}
.dc-title-wrap { position: relative; display: flex; align-items: center; gap: 14rpx; }
.dc-title {
  font-size: 48rpx; font-weight: 900; color: var(--text);
  letter-spacing: 8rpx; line-height: 1.15;
}
.dc-title-spark { width: 30rpx; height: 30rpx; }
.dc-title-spark-r { transform: scale(0.8); opacity: 0.8; }
/* 手写标题下的玫瑰笔触 */
.dc-title-brush {
  position: absolute; left: 50%; bottom: -8rpx;
  width: 200rpx; height: 10rpx; border-radius: 999rpx;
  transform: translateX(-50%) rotate(-1.2deg);
  background: var(--stamp, #C26B5E); opacity: 0.32;
}
.dc-brand {
  position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%);
  display: flex; align-items: center; gap: 8rpx;
}
.dc-brand-logo { width: 44rpx; height: 44rpx; border-radius: 12rpx; }
.dc-brand-name { font-size: 24rpx; font-weight: 700; color: var(--text); letter-spacing: 1rpx; }

/* ═══ ② 地图卡 ═══ */
.dc-card {
  margin: 20rpx 24rpx 0;
  padding: 16rpx;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, 32rpx);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb, 107, 91, 80), 0.06));
}
/* 稿子里卡片内还套了一圈虚线内框 —— 手账贴纸的「边界线」 */
.dc-card-inner {
  position: relative;
  padding: 18rpx 0 0;
  border: 2rpx dashed var(--border, #E2D9C7);
  border-radius: 22rpx;
}

/* —— 卡面装饰：邮票 / 波浪 / 花枝 / 心 / 星点（纯装饰，位置固定，不随数据变） —— */
.dc-stamp { position: absolute; }
.dc-stamp-l { left: 22rpx; top: 22rpx; width: 128rpx; height: 150rpx; transform: rotate(-7deg); }
.dc-stamp-r { right: 20rpx; bottom: 74rpx; width: 116rpx; height: 136rpx; transform: rotate(6deg); }
.dc-wave { position: absolute; opacity: 0.55; }
.dc-wave-l { left: 164rpx; top: 34rpx; width: 126rpx; height: 56rpx; }
.dc-wave-r { right: 146rpx; bottom: 96rpx; width: 116rpx; height: 52rpx; }

.dc-sprig { position: absolute; width: 118rpx; height: 80rpx; opacity: 0.9; }
.dc-sprig-a { left: 8rpx; top: 46%; }
.dc-sprig-b { right: 6rpx; top: 58%; transform: scaleX(-1); }

.dc-heart { position: absolute; width: 34rpx; height: 34rpx; opacity: 0.85; }
.dc-heart-a { left: 170rpx; top: 112rpx; }
.dc-heart-b { right: 36rpx; top: 39%; width: 40rpx; height: 40rpx; }

.dc-star { position: absolute; width: 26rpx; height: 26rpx; opacity: 0.75; }
.dc-star-a { left: 40rpx; top: 30%; }
.dc-star-b { left: 68rpx; top: 70%; }
.dc-star-c { right: 54rpx; top: 22%; }

/* —— 看法切换：水彩 / 真地图。靠右放，避开左上角那枚斜贴的邮票 —— */
.dc-view { display: flex; justify-content: flex-end; gap: 8rpx; padding: 0 24rpx; margin-bottom: 12rpx; }
.dc-view-b {
  padding: 6rpx 24rpx;
  border: 2rpx solid var(--border, #E2D9C7);
  border-radius: 999rpx;
  font-size: 22rpx; letter-spacing: 1rpx;
  color: var(--text2, #8A7E6E);
}
.dc-view-b.on { background: var(--primary, #2B2420); border-color: var(--primary, #2B2420); color: var(--on-primary, #FFFFFF); }

/* —— 地图舞台：三层严格同尺寸、同投影 —— */
.dc-stage { position: relative; margin: 8rpx auto 0; }
/* 原生地图铺满舞台，尺寸跟着 JS 下发的 stageW/H 走（和水彩图一样大，切换不跳版） */
.dc-map { width: 100%; height: 100%; border-radius: 18rpx; }
.dc-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* 城市单元：0 尺寸锚点，子元素各自相对「落点」定位 —— 落点即真实经纬度 */
.dc-city { position: absolute; width: 0; height: 0; }

/* 连接杆：气泡被避让顶开时，用它牵回落点 */
.dc-stem {
  position: absolute; left: 0; width: 3rpx; margin-left: -1.5rpx;
  border-radius: 2rpx; opacity: 0.65;
}

/* 落点：白芯 + 气泡同色圆环 */
.dc-pin {
  position: absolute; left: 0; top: 0;
  width: 22rpx; height: 22rpx; margin: -11rpx 0 0 -11rpx;
  box-sizing: border-box;
  border: 5rpx solid;
  border-radius: 50%;
  background: var(--card-bg, var(--card));
  box-shadow: 0 2rpx 6rpx rgba(var(--text-rgb, 107, 91, 80), 0.2);
}
.dc-pin-name {
  position: absolute; left: 0; top: 16rpx;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 20rpx; color: var(--text); letter-spacing: 1rpx;
}

/* 气泡：水彩实底 + 白字，尾巴用旋转方块（background: inherit 直接吃内联色） */
.dc-bubble {
  position: absolute; left: 0;
  transform: translateX(-50%);
  min-width: 96rpx;
  padding: 10rpx 18rpx 12rpx;
  border-radius: 26rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(var(--text-rgb, 107, 91, 80), 0.22);
}
.dc-bubble::after {
  content: '';
  position: absolute; left: 50%;
  width: 15rpx; height: 15rpx; margin-left: -7.5rpx;
  background: inherit;
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.dc-bubble.up::after { bottom: -6rpx; }
.dc-bubble.down::after { top: -6rpx; }
/* 气泡文字恒为白色（压在水彩实底上）。白色是品牌常量、不是主题色，
   和气泡底色一样由 JS 下发 —— WXSS 里只留字号字重，不出现十六进制。 */
.dc-bubble-n { font-size: 26rpx; font-weight: 700; line-height: 1.2; }
.dc-bubble-c { font-size: 21rpx; opacity: 0.85; line-height: 1.2; }

/* —— 底部署名 —— */
.dc-foot {
  display: flex; align-items: center; gap: 10rpx;
  padding: 14rpx 26rpx 20rpx;
}
.dc-foot-rule {
  flex: 1; height: 2rpx; border-radius: 2rpx;
  background: var(--border, #E2D9C7);
}
.dc-foot-spark { width: 20rpx; height: 20rpx; opacity: 0.7; }
.dc-foot-txt {
  font-size: 22rpx; color: var(--text2); letter-spacing: 1rpx;
  white-space: nowrap;
}

/* ═══ ③ 空态 ═══ */
.dc-empty {
  display: flex; flex-direction: column; align-items: center;
  margin: 24rpx 24rpx 0; padding: 40rpx 24rpx;
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, 32rpx);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb, 107, 91, 80), 0.06));
}
.dc-empty-ic { width: 96rpx; height: 96rpx; margin-bottom: 16rpx; }
.dc-empty-t { font-size: 30rpx; font-weight: 700; color: var(--text); }
.dc-empty-s { margin-top: 8rpx; font-size: 23rpx; color: var(--text2); }

/* ═══ ④ 缺坐标提示 ═══ */
.dc-tip {
  margin: 16rpx 40rpx 0; text-align: center;
  font-size: 21rpx; color: var(--text2); opacity: 0.8; line-height: 1.5;
}

/* ═══ ⑤ 城市票根面板 ═══ */
.dc-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.34);
  z-index: 20;
  animation: dc-fade 0.22s ease both;
}
@keyframes dc-fade { from { opacity: 0; } to { opacity: 1; } }

.dc-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: 21;
  max-height: 68vh;
  display: flex; flex-direction: column;
  background: var(--card-bg, var(--card));
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(var(--text-rgb, 107, 91, 80), 0.18);
  transform: translateY(110%);
  transition: transform 0.28s cubic-bezier(0.22, 0.9, 0.3, 1);
}
.dc-sheet.on { transform: translateY(0); }
.dc-sheet-bar {
  width: 68rpx; height: 8rpx; border-radius: 999rpx; margin: 14rpx auto 4rpx;
  background: var(--border, #E2D9C7);
}
.dc-sheet-head {
  display: flex; align-items: center; gap: 8rpx;
  padding: 14rpx 28rpx 16rpx;
  border-bottom: 2rpx solid var(--border, #E2D9C7);
}
.dc-sheet-pin { width: 30rpx; height: 30rpx; }
.dc-sheet-city { font-size: 34rpx; font-weight: 900; color: var(--text); letter-spacing: 2rpx; }
.dc-sheet-n { font-size: 22rpx; color: var(--text2); }
.dc-sheet-x {
  margin-left: auto; width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--soft, #E9E2D4);
}
.dc-sheet-x-ic { width: 26rpx; height: 26rpx; }

.dc-sheet-body { flex: 1; min-height: 0; padding: 12rpx 24rpx 0; }
.dc-row {
  display: flex; align-items: center; gap: 18rpx;
  padding: 16rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
  background: var(--soft, #E9E2D4);
}
.dc-row-ic {
  flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.dc-row-ic-img { width: 38rpx; height: 38rpx; }
.dc-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.dc-row-title {
  font-size: 27rpx; font-weight: 600; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dc-row-meta {
  font-size: 21rpx; color: var(--text2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dc-row-go { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; }
