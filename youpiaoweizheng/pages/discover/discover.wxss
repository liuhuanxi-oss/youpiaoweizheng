/* pages/discover/discover.wxss —— v6.5 发现·时光地图（六主题变量化） */
.dc-scroll { min-height: 100vh; }

/* —— 顶部 hero —— */
.dc-hero { padding: 40rpx 28rpx 24rpx; }
.dc-top-title {
  font-size: 52rpx; font-weight: 900; color: var(--text);
  letter-spacing: 6rpx; line-height: 1.1;
}
.dc-slogan {
  margin-top: 12rpx; font-size: 24rpx; color: var(--text2);
  letter-spacing: 1rpx;
}

/* —— 地图占位（主题色渐变 + 装饰） —— */
.dc-map {
  position: relative; margin-top: 24rpx; height: 380rpx;
  border-radius: var(--card-r, 36rpx);
  background: linear-gradient(160deg, var(--soft) 0%, var(--chip) 60%, var(--bg) 100%);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
  overflow: hidden;
}
.dc-map-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(40% 30% at 30% 40%, rgba(255, 255, 255, 0.45), transparent 70%),
    radial-gradient(35% 30% at 70% 70%, rgba(255, 255, 255, 0.30), transparent 70%);
}
.dc-map-pin {
  position: absolute; font-size: 28rpx; line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.20));
}
/* 纸飞机装饰（内联 SVG 读变量） */
.dc-map-plane {
  position: absolute; top: 24rpx; right: 32rpx;
  width: 88rpx; height: 60rpx;
  transform: rotate(-14deg);
}
.dc-map-emoji {
  position: absolute; right: 18rpx; bottom: 16rpx;
  font-size: 40rpx; opacity: 0.7;
}

/* —— 地图统计行 —— */
.dc-map-stats {
  display: flex; align-items: center; gap: 24rpx;
  margin-top: 20rpx;
  background: var(--card-bg, var(--card)); border-radius: var(--card-r, 32rpx);
  padding: 22rpx 28rpx;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
}
.dc-stat { display: flex; align-items: baseline; gap: 8rpx; }
.dc-stat-n { font-size: 44rpx; font-weight: 900; color: var(--primary); }
.dc-stat-k { font-size: 22rpx; color: var(--text2); }
.dc-stat-go { margin-left: auto; font-size: 22rpx; color: var(--primary); }

/* —— 时间轴小标题 —— */
.dc-time-head {
  display: flex; align-items: baseline; gap: 16rpx;
  padding: 32rpx 32rpx 16rpx;
}
.dc-time-head .dc-t { font-size: 30rpx; font-weight: 700; color: var(--text); }
.dc-time-head .dc-s { font-size: 22rpx; color: var(--text2); }

/* —— 时间轴分组（左小圆点 + 右内容） —— */
.dc-time-grp {
  display: flex; gap: 18rpx;
  padding: 8rpx 32rpx 16rpx;
}
.dc-time-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--primary);
  margin-top: 14rpx;
  box-shadow: 0 0 0 6rpx var(--soft);
  flex: 0 0 16rpx;
}
.dc-time-body { flex: 1; min-width: 0; }
.dc-time-label {
  font-size: 26rpx; font-weight: 700; color: var(--text);
  letter-spacing: 1rpx; margin-bottom: 12rpx;
}
.dc-time-card {
  display: flex; align-items: center; gap: 18rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  background: var(--card-bg, var(--card)); border-radius: var(--card-r, 28rpx);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
}
.dc-time-thumb {
  width: 84rpx; height: 84rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx;
  flex: 0 0 84rpx;
  background: var(--chip);
}
.dc-time-info { flex: 1; min-width: 0; }
.dc-time-title { font-size: 26rpx; font-weight: 600; color: var(--text); }
.dc-time-meta { margin-top: 4rpx; font-size: 20rpx; color: var(--text2); }

.dc-time-more {
  margin: 24rpx 32rpx 0; padding: 22rpx 0;
  text-align: center; color: var(--primary);
  background: var(--card-bg, var(--card)); border-radius: 999rpx;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
  font-size: 24rpx; letter-spacing: 1rpx;
}

/* —— 0 票根空态 —— */
.dc-empty-emoji { font-size: 96rpx; line-height: 1; }

/* 票根类型缩略底色 + 类型标签（分类辅助色） */
.dc-tag-show    { background: var(--soft); }
.dc-tag-movie   { background: var(--cat-movie, var(--chip)); }
.dc-tag-traffic { background: var(--cat-transport, var(--chip)); }
