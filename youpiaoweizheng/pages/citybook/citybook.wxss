/* pages/citybook/citybook.wxss —— 城市集章册（8.1.6）
   六主题变量化：颜色一律走 var(--*)，唯一写死的色是每枚章的**识别色** ——
   它由 JS 下发到行内 style 的 color 上，与回忆地图的气泡同源（同一个 bubbleColor），
   同一座城在两页里永远是同一个颜色。 */
.cb-page {
  padding: 30rpx 40rpx 90rpx;
  box-sizing: border-box;
}

/* ===== 标题行 ===== */
.cb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}
.cb-title-wrap {
  display: flex;
  align-items: center;
}
.cb-title-ic {
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
}
.cb-title {
  font-size: 46rpx;
  letter-spacing: 6rpx;
  color: var(--text);
}
.cb-head-sprig {
  width: 108rpx;
  height: 72rpx;
  opacity: 0.5;
}

/* ===== 统计条 ===== */
.cb-stat {
  display: flex;
  align-items: baseline;
  padding: 4rpx 0 2rpx;
}
.cb-stat-n {
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: var(--text);
}
.cb-stat-y {
  margin-left: 16rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--text2);
}

/* ===== 云故障横幅（同 album / discover 的实话条口径） ===== */
.cb-net {
  margin-top: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: var(--soft);
}
.cb-net-t {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text2);
}

/* ===== 册子：一枚一枚的章 =====
   尺寸按 750rpx 稿算：可用宽 670，3 列各 200 + 两处 22 的间距 = 644，居中留白。
   圆形里的字只放在中间那条横带上（圆的可用宽度在中线处最宽），所以城市名限宽 152。 */
.cb-book {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  margin-top: 30rpx;
}
.cb-ch {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border: 3rpx solid currentColor;   /* 色由行内 style 的 color 带下来 */
  border-radius: 50%;
  box-sizing: border-box;
}
/* 内虚线圈：真印章的那道里圈。用伪元素而不是真节点 —— 省一层盒子，也省一次渲染 */
.cb-ch::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 13rpx;
  right: 13rpx;
  bottom: 13rpx;
  border: 2rpx dashed currentColor;
  border-radius: 50%;
  opacity: 0.45;
}
.cb-ch-n {
  max-width: 152rpx;
  font-size: 30rpx;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cb-ch-d {
  margin-top: 8rpx;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--text2);
}
.cb-ch-x {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--text2);
}

/* ===== 实话条：没填城市的票根 ===== */
.cb-tip {
  margin-top: 30rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text2);
}

/* ===== 骨架：与真章同尺寸，替上去时不跳版 ===== */
.cb-sk {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
}
