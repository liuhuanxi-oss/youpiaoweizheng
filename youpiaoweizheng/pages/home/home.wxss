/* pages/home/home.wxss —— 票根墙（品牌全案 · 稿屏2，六主题变量化）
   颜色一律读 --*；写死的十六进制只允许出现在 var(--x, #兜底) 里。
   齿边卡片的 viewBox 尺寸由 home.js 编译，与这里的盒子必须一致：
   .hc-card 310×256（8.1.1 起是 256，原先 240 —— 多出来的 16 全给了照片）。

   8.1.1 排版收口：字号只剩五档（40 品牌 / 34 问候 / 30 区块标题 / 26 正文 / 22 辅助），
   块与块之间一律 20rpx。原先这里混着 20 / 22 / 26 / 30 四种外边距、七种字号，
   光「问候语到搜索框」之间就三套间距 —— 每多一档就多一次「这个该用哪个」。
   间距、字号各只留一档，看完这行就不用再往下猜了。 */

/* —— 品牌行 —— */
/* 品牌行：往下滚吸顶。
   · position 必须是 sticky 不是 fixed —— 根节点的 .fade-up 会留下 transform，
     fixed 后代会被它当成包含块（跟着页面滚）；sticky 不受影响（已实测）。
   · 吸顶这里**只改底色与描边，不改内边距**：它在文档流里，一改高度整页就跳一下。
   · 底色只在吸住时给：平时透明，页面底纹（--page-deco）能连成一片；
     吸住时它压着下面的卡片，必须有实底才读得清。 */
.hc-head {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  padding: 20rpx 48rpx 0;
  transition: background-color 200ms ease-out, box-shadow 200ms ease-out;
}
.hc-head.is-stuck {
  background-color: var(--bg, #FBF2EC);
  box-shadow: 0 1rpx 0 var(--line, #E8DCCB), 0 8rpx 20rpx rgba(var(--shadow-rgb, 44, 44, 44), 0.07);
}
.hc-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--rose, #D9A0A6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hc-logo-img { width: 100%; height: 100%; display: block; }
/* 52 → 40：它是个品牌标，不是标题。52rpx 时它比整页任何东西都抢眼，
   而用户每次进首页第一眼该落在自己的票上 */
.hc-brand {
  margin-left: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--brown, #6B5B50);
}
.hc-user {
  margin-left: auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hc-user-ic { width: 38rpx; height: 38rpx; }

/* —— 问候语：左边一枝白花、右上金星、右下波浪 —— */
/* 那句招呼 42 → 34，两行照旧。
   原方案打算压成一行，做的时候发现压不动：这一行 16 个字按 34rpx 排要 544rpx，
   而左边要让出花枝（88）、右边压着波浪（108），一行排下来句尾会钻到波浪底下。
   两行是这枝花、这颗星、这道波的落位依据，动它仨不如留着第二行 ——
   何况这一版省下来的高度已经够把票根墙提到首屏第二行了。 */
.hc-greet {
  position: relative;
  margin: 20rpx 48rpx 0;
  min-height: 96rpx;
}
.hc-greet-daisy { position: absolute; left: -18rpx; top: -6rpx; width: 84rpx; height: 109rpx; z-index: 1; }
.hc-greet-txt { position: relative; z-index: 2; padding-left: 88rpx; }
.hc-greet-l1 {
  display: block;
  font-size: var(--fs-xl, 34rpx);
  line-height: 1.42;
  color: var(--brown, #6B5B50);
}
.hc-greet-l2 { display: flex; align-items: center; }
.hc-greet-t {
  font-size: var(--fs-xl, 34rpx);
  line-height: 1.42;
  color: var(--brown, #6B5B50);
}
/* 星抬到字的上沿（稿里它挂在句尾右上角）。抬多高是跟着字号走的：42 那会儿是 26，
   按同比例缩到 34 就是 21 —— 写死 26 的话字小了、星还挂在老地方。 */
.hc-greet-star { width: 32rpx; height: 24rpx; margin-left: 12rpx; margin-bottom: 22rpx; flex-shrink: 0; }
.hc-greet-wave { position: absolute; right: -10rpx; top: 8rpx; width: 108rpx; height: 47rpx; z-index: 1; }

/* ===== 8.1.1「今天」卡：今日时光签 / 那年今天 / 老票根专场三行并一张 =====
   三行原本各是一块，各带各的底色与边距（一共 280rpx）。合成一张卡之后：
   · 只有一个外边距、一个底色，行与行之间用细描边分开；
   · 行高统一 64rpx —— 三行各自「自然高」会排出参差的节奏，
     统一行高之后不管今天露几行，这张卡的高度都是整齐的。 */
.hc-today {
  margin: 20rpx 48rpx 0;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: var(--soft, #F4EFE7);
  border: 2rpx solid var(--border, #E2D9C7);
  box-sizing: border-box;
}
/* 今天还没收下时是虚线齿孔边 = 一张待撕的签；收下了就是实线，这件事今天已了结。
   （原先这条规矩在「时光签」那一块上，并成一张卡之后挪到整张卡上） */
.hc-today.is-pending { border-style: dashed; }
.hc-td { display: flex; align-items: center; min-height: 64rpx; }
.hc-td + .hc-td { border-top: 2rpx solid var(--border, #E2D9C7); }
.hc-td-ic { width: 32rpx; height: 32rpx; margin-right: 16rpx; flex-shrink: 0; }
.hc-td-body { flex: 1; min-width: 0; }
.hc-td-t { display: block; font-size: var(--fs-md, 26rpx); font-weight: 600; color: var(--brown, #6B5B50); }
.hc-td-s {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-sm, 22rpx);
  color: var(--text2, #8A7B66);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 那年今天：左一句戳红引子、右一句票名，中间不隔开是因为它就是一整句话 */
.hc-td-k { flex-shrink: 0; font-size: var(--fs-md, 26rpx); color: var(--stamp, #C26B5E); }
.hc-td-v {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: var(--fs-md, 26rpx);
  color: var(--brown, #6B5B50);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hc-td-go { width: 24rpx; height: 24rpx; margin-left: 10rpx; flex-shrink: 0; }
.hc-td-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 0 26rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: var(--fs-md, 26rpx);
  color: var(--on-primary, #FFF8F2);
  background: var(--stamp, #C26B5E);
}

/* —— 找票：搜索框 + 筛选按钮同一行 —— */
.hc-find { display: flex; align-items: center; margin: 20rpx 48rpx 0; }
.hc-search {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 34rpx;
  background: var(--soft, #E8DFD0);
  box-sizing: border-box;
}
.hc-search-ic { width: 34rpx; height: 34rpx; margin-right: 14rpx; flex-shrink: 0; }
.hc-search-ph { font-size: var(--fs-md, 26rpx); letter-spacing: 1rpx; color: var(--text2, #8A7B66); }
/* 筛选按钮。选中态只改字色与字重、不给玫瑰实底 —— 实底就得连箭头图标一起反白，
   而这个箭头是 data-uri、颜色编译时写死（做胶囊那版为此备了两套图标地址）。
   按钮上本来就写着「全部 / 演出 / 电影」，谁是当前分类一眼看得见，不值当再备一套图。 */
.hc-filter {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-left: 16rpx;
  padding: 0 22rpx;
  border-radius: 34rpx;
  background: var(--soft, #E8DFD0);
  box-sizing: border-box;
}
.hc-filter-t { font-size: var(--fs-md, 26rpx); letter-spacing: 1rpx; color: var(--text2, #8A7B66); }
.hc-filter.on .hc-filter-t { color: var(--stamp, #C26B5E); font-weight: 600; }
/* 列表那个右箭头转 90 度当「点开」用（省一个只为它画的雪佛龙图标） */
.hc-filter-ic { width: 24rpx; height: 24rpx; margin-left: 8rpx; flex-shrink: 0; transform: rotate(90deg); }

/* —— 云故障 / 超上限横幅（视觉同 album 的 .tm-net，左右边距跟本页的 48rpx） ——
   本类不写 transition：让全局 .pressable 的按压回弹原样生效（页面级同名属性会盖掉它） */
.hc-net { margin: 20rpx 48rpx 0; padding: 16rpx 24rpx; background: var(--soft, #E9E2D4); border-radius: 18rpx; }
.hc-net-t { font-size: var(--fs-sm, 22rpx); color: var(--text2, #8A7B66); line-height: 1.5; }

/* —— 票根墙：左右两列等高卡（不是瀑布流，见 home.js 文件头） —— */
.hc-grid {
  display: flex;
  justify-content: space-between;
  margin: 20rpx 48rpx 0;
}
.hc-col { width: 310rpx; }

.hc-card {
  position: relative;
  width: 310rpx;
  height: 256rpx;
  margin-bottom: 28rpx;
  padding: 28rpx 10rpx 8rpx;
  box-sizing: border-box;
}
.hc-card-bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
/* 卡顶那排小圆点 */
.hc-card-dots { position: absolute; left: 20rpx; top: 12rpx; display: flex; z-index: 3; }
.hc-card-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 7rpx;
  background: var(--border, #E2D9C7);
}
.hc-card-dot.is-on { background: var(--rose, #D9A0A6); }

/* 邮戳：圆心落在卡的右上角，压在照片上、且探出卡边（所以卡不能 overflow:hidden） */
.hc-pm { position: absolute; right: 28rpx; top: -14rpx; width: 96rpx; height: 96rpx; z-index: 4; }
.hc-pm-ring { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hc-pm-wave { position: absolute; left: 92%; top: 10%; width: 77rpx; height: 84rpx; }
.hc-pm-in {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 戳压在照片上，字要压得住任何底图 */
.hc-pm-city, .hc-pm-year {
  max-width: 74rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
  color: var(--brown, #6B5B50);
  text-shadow: 0 0 8rpx rgba(var(--text-rgb, 107, 91, 80), 0.45);
}
/* 17/15 → 18/16：这枚戳压在照片上、还带一层阴影，原尺寸在深色照片上基本糊成一团 */
.hc-pm-city { font-size: 18rpx; font-weight: 600; letter-spacing: 1rpx; }
.hc-pm-year { font-size: 16rpx; margin-top: 2rpx; opacity: 0.85; }

/* 照片：本身裁圆角，角上的花与叶要探出去，所以裁的是内层 */
.hc-shot { position: relative; width: 290rpx; height: 144rpx; z-index: 2; }
.hc-shot-frame {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  border-radius: 10rpx;
  overflow: hidden;
  background: var(--soft, #E8DFD0);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 照片解码完成才淡入落位（.is-loaded 由 bindload/binderror 挂上）。
   不等解码的话，图片会在解码完的某一帧「蹦」出来 —— 照片一多，整面墙都在蹦。 */
.hc-shot-img {
  width: 100%; height: 100%; display: block;
  opacity: 0;
  transition: opacity 200ms ease-out;
}
.hc-shot-img.is-loaded { opacity: 1; }

/* A1 近似共享元素：点卡后照片在框内「推近」并淡出（框是 overflow:hidden，放大被裁在框里），
   150ms 后跳详情；详情页那侧由 .fade-up 接住落位 */
.hc-shot-img.fly { animation: hc-fly 150ms ease-out forwards; }
@keyframes hc-fly {
  to { transform: scale(1.14); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .hc-shot-img.fly { animation: none; }   /* 前庭敏感：不推近，跳转照旧 */
}
.hc-shot-fb { width: 56rpx; height: 56rpx; }
.hc-shot-bloom { position: absolute; left: -16rpx; bottom: -14rpx; width: 46rpx; height: 54rpx; z-index: 2; }
.hc-shot-sprig { position: absolute; right: -14rpx; bottom: 4rpx; width: 52rpx; height: 35rpx; z-index: 2; }

.hc-title {
  display: block;
  margin-top: 10rpx;
  height: 34rpx;
  padding-left: 4rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--brown, #6B5B50);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 行高给到 26：字号从 20 提到 22 之后，22rpx 的行高连笔画的下缘都容不下 */
.hc-meta { display: flex; align-items: center; margin-top: 6rpx; height: 26rpx; padding-left: 4rpx; }
.hc-meta-ic { width: 22rpx; height: 22rpx; margin-right: 6rpx; flex-shrink: 0; }
.hc-meta-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sm, 22rpx);
  line-height: 26rpx;
  color: var(--text2, #8A7B66);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 心要够大才好点（视觉 30rpx，热区 44rpx） */
.hc-fav {
  width: 44rpx;
  height: 44rpx;
  margin: -11rpx -11rpx -11rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hc-fav-ic { width: 30rpx; height: 30rpx; }

/* —— 骨架屏 —— */
/* 骨架块的盒子与 .hc-card 一一对应（shot 144 / title 34 / meta 26）——
   对不上的话，真数据一进来整面墙会跳一下 */
.hc-sk-card {
  height: 256rpx;
  margin-bottom: 28rpx;
  padding: 28rpx 10rpx 8rpx;
  border-radius: var(--card-r, 28rpx);
  box-sizing: border-box;
}
.hc-sk-shot { width: 290rpx; height: 144rpx; border-radius: 10rpx; }
.hc-sk-title { width: 180rpx; height: 24rpx; margin-top: 16rpx; border-radius: 12rpx; }
.hc-sk-meta { width: 240rpx; height: 18rpx; margin-top: 12rpx; border-radius: 9rpx; }

/* —— 空态 —— */
.hc-empty { padding: 60rpx 48rpx 0; }
.hc-empty-ic { display: block; width: 96rpx; height: 96rpx; margin: 0 auto 22rpx; opacity: 0.75; }
.hc-empty-t { font-size: var(--fs-lg, 30rpx); font-weight: 700; letter-spacing: 2rpx; color: var(--text, #2B2420); }
.hc-empty-s { margin-top: 12rpx; font-size: var(--fs-sm, 22rpx); letter-spacing: 1rpx; color: var(--text2, #8A7B66); }
.hc-empty-btn {
  margin: 36rpx auto 0;
  width: 320rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--rose, #D9A0A6);
  color: var(--on-primary, #FFF8F2);
  font-size: var(--fs-md, 26rpx);
  letter-spacing: 2rpx;
  text-align: center;
}

/* 悬浮 tab 栏（custom:true）压着内容，底部留出它的位置 */
.hc-foot-space { height: 220rpx; }

/* ============ A8 新用户三步引导 ============ */
.guide-mask {
  position: fixed;
  inset: 0;
  z-index: 1500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: rgba(44, 44, 44, 0.42);
  animation: guide-in 200ms ease-out both;
}
@keyframes guide-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.guide-card {
  width: 100%;
  box-sizing: border-box;
  padding: 56rpx 44rpx 36rpx;
  border-radius: 28rpx;
  background: var(--card, #FFFEFB);
  border: 2rpx solid var(--border, #E8E4DD);
  box-shadow: 0 24rpx 64rpx rgba(44, 44, 44, 0.18);
  text-align: center;
  animation: guide-pop 260ms var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1)) both;
}
@keyframes guide-pop {
  from { opacity: 0; transform: translateY(24rpx) scale(0.94); }
  to   { opacity: 1; transform: none; }
}
.guide-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--soft, #F4EFE7);
  color: var(--brown, #6B5B50);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.guide-ic {
  display: block;
  width: 132rpx;
  height: 132rpx;
  margin: 32rpx auto 0;
}
.guide-t {
  margin-top: 20rpx;
  font-size: 36rpx;
  color: var(--text, #2B2420);
  letter-spacing: 2rpx;
}
.guide-s {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text, #2B2420);
  opacity: 0.6;
}
.guide-dots {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  margin-top: 34rpx;
}
.guide-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border, #E2D9C7);
}
.guide-dot.on { background: var(--rose, #D9A0A6); }
.guide-btn {
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: var(--rose, #D9A0A6);
  color: var(--on-primary, #FFFFFF);
  font-size: 29rpx;
  letter-spacing: 3rpx;
}
.guide-skip {
  margin-top: 12rpx;
  padding: 18rpx 0;
  font-size: 25rpx;
  color: var(--brown, #6B5B50);
  opacity: 0.7;
}
@media (prefers-reduced-motion: reduce) {
  .guide-mask, .guide-card { animation: none; }
}
