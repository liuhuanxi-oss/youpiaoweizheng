<!-- 票根卡：左右两列共用同一段模板（旧版把这段抄了两遍，改一处必漏一处） -->
<template name="hcTicket">
  <view
    class="hc-card pressable {{enter ? 'stagger' : ''}}"
    hover-class="press-item-hover"
    data-id="{{item.id}}"
    data-title="{{item.title}}"
    bindtap="goDetail"
    bindlongpress="onCardLong"
    aria-role="button"
    aria-label="查看票根 {{item.title}}"
  >
    <image class="hc-card-bg" src="{{art.card}}" mode="aspectFit" aria-hidden="true" />

    <!-- 右上角邮戳：圆环与注销线是图形，城市与年月是真文本叠上去的
         （弧排文字在小程序里做不到，硬塞进 SVG 又会遇到中文字形回落，见 utils/deco.js） -->
    <view class="hc-pm">
      <image class="hc-pm-ring" src="{{art.pmRing}}" mode="aspectFit" aria-hidden="true" />
      <image class="hc-pm-wave" src="{{art.pmWave}}" mode="aspectFit" aria-hidden="true" />
      <view class="hc-pm-in">
        <text class="hc-pm-city">{{item.stampCity}}</text>
        <text class="hc-pm-year">{{item.stampYear}}</text>
      </view>
    </view>

    <!-- 卡顶那排小圆点：稿里的印刷装饰，不承载数据 -->
    <view class="hc-card-dots" aria-hidden="true">
      <view class="hc-card-dot is-on"></view>
      <view class="hc-card-dot"></view>
      <view class="hc-card-dot is-on"></view>
      <view class="hc-card-dot"></view>
      <view class="hc-card-dot"></view>
    </view>

    <view class="hc-shot">
      <view class="hc-shot-frame">
        <!-- A1 近似共享元素：被点的那张照片放大淡出（.fly），详情页接住落位。
             照片解码完成才淡入落位（is-loaded）：不等解码的话，图片会在某一帧「蹦」出来。
             bindload 与 binderror 同一个处理函数：加载失败也要放行，否则照片永久停在透明态，
             比「加载失败」本身更像坏了。 -->
        <image wx:if="{{item.img}}"
               class="hc-shot-img {{item.loaded ? 'is-loaded' : ''}} {{flyingId === item.id ? 'fly' : ''}}"
               src="{{item.img}}" mode="aspectFill" lazy-load
               bindload="onShotReady" binderror="onShotReady" data-id="{{item.id}}" />
        <image wx:else class="hc-shot-fb" src="{{typeIc[item.type] || typeIc._}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <!-- 照片角上那朵小白花与支出来的一枝绿叶（探出照片外，所以裁圆角的是内层 frame） -->
      <image class="hc-shot-bloom" src="{{art.bloom}}" mode="aspectFit" aria-hidden="true" />
      <image class="hc-shot-sprig" src="{{art.sprig}}" mode="aspectFit" aria-hidden="true" />
    </view>

    <view class="hc-title serif">{{item.title}}</view>

    <view class="hc-meta">
      <image class="hc-meta-ic" src="{{ic.pin}}" mode="aspectFit" aria-hidden="true" />
      <text class="hc-meta-t">{{item.city || '未记地点'}} · {{item.dateText}}</text>
      <view
        class="hc-fav pressable"
        catchtap="toggleFav"
        data-id="{{item.id}}"
        hover-class="press-hover"
        aria-role="button"
        aria-label="{{item.fav ? '取消收藏' : '收藏这张票根'}}"
      >
        <image class="hc-fav-ic" src="{{item.fav ? ic.heartOn : ic.heartOff}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>
  </view>
</template>

<!-- A8 新用户三步引导（拍一张 → AI 认字 → 上墙）。
     挂在根节点外：根节点带 .fade-up，它的 transform 会让 fixed 后代跟着页面滚（见 app.wxss）。 -->
<view class="guide-mask" wx:if="{{guide}}" catchtouchmove="noop" aria-role="dialog" aria-label="新手指引">
  <view class="guide-card">
    <view class="guide-badge">第 {{guide}} / 3 步</view>
    <image class="guide-ic" src="{{guideIc}}" mode="aspectFit" aria-hidden="true" />
    <view class="guide-t">{{guideTitle}}</view>
    <view class="guide-s">{{guideDesc}}</view>
    <view class="guide-dots">
      <view class="guide-dot {{guide === item ? 'on' : ''}}" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>
    <view class="guide-btn pressable" hover-class="press-hover" bindtap="guideNext"
          aria-role="button" aria-label="{{guide >= 3 ? '去拍第一张' : '下一步'}}">{{guide >= 3 ? '去拍第一张' : '下一步'}}</view>
    <view class="guide-skip pressable" hover-class="press-item-hover" bindtap="guideClose"
          aria-role="button" aria-label="跳过引导">跳过</view>
  </view>
</view>

<!-- edgeStyle：稿屏 2 的页边装饰底图（整屏一张 SVG，由 deco.homeEdges 编译，颜色编译期写死）。
     铺成页面背景而不是加一层 view —— 背景永远在内容之下，不必跟卡片的 z-index 打架。 -->
<view class="tk-page theme-{{theme}} {{enter ? 'fade-up' : ''}}" style="{{edgeStyle}}">
  <!-- 4.10.1 重装饰层：纸面噪点 -->
  <view class="grain"></view>

  <!-- ============ 品牌行：logo + 有票为证 + 个人中心 ============
       往下滚会吸顶（.is-stuck 时浮出纸色实底与细描边）。用 position: sticky，
       没用 fixed —— 根节点的 .fade-up 会留下 transform，fixed 后代会被它拽着走，
       sticky 不受影响（已实测：动画播完后根节点留着 translateY(0)，吸顶照常）。 -->
  <view class="hc-head {{stuck ? 'is-stuck' : ''}}">
    <view class="hc-logo">
      <image class="hc-logo-img" src="/images/brand-logo.png" mode="aspectFit" aria-hidden="true" />
    </view>
    <text class="hc-brand serif">有票为证</text>
    <view class="hc-user pressable" bindtap="goProfile" hover-class="press-item-hover" aria-role="button" aria-label="个人中心">
      <image class="hc-user-ic" src="{{ic.brand}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <!-- ============ 问候语：左侧花枝、右侧金星与波浪 ============ -->
  <view class="hc-greet">
    <image class="hc-greet-daisy" src="{{art.daisy}}" mode="aspectFit" aria-hidden="true" />
    <view class="hc-greet-txt hand">
      <text class="hc-greet-l1">愿这些票根，</text>
      <view class="hc-greet-l2">
        <text class="hc-greet-t">都是你热爱生活的证据</text>
        <image class="hc-greet-star" src="{{art.star}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>
    <image class="hc-greet-wave" src="{{art.wave}}" mode="aspectFit" aria-hidden="true" />
  </view>

  <!-- 「今天」那三行（今日时光签 / 那年今天 / 老票根专场）已挪到票根墙**下面**，见文件末尾。
       8.2.0 实测：它在墙上头时占 215rpx，票根墙得从第 626rpx 才开始画，首屏只看得到 2.3 行卡；
       稿子同一位置是 384rpx、首屏 3 行整。品牌行 94 / 问候 96 / 搜索 + 胶囊 165 —— 这几块
       跟稿子几乎逐项相同，差的这 242rpx 全是这一块。这一页的主角是墙，它得先让出来。 -->

  <!-- ============ 找票：搜索框 ============
       8.2.0 按品牌稿改回通栏（稿子里这一行没有右侧按钮，搜索框独占一行）。 -->
  <view class="hc-find">
    <view class="hc-search pressable" bindtap="goSearch" hover-class="press-hover" aria-role="searchbox" aria-label="搜索票根">
      <image class="hc-search-ic" src="{{ic.search}}" mode="aspectFit" aria-hidden="true" />
      <text class="hc-search-ph">搜索演出、电影、城市...</text>
    </view>
  </view>

  <!-- ============ 分类胶囊 ============
       8.2.0 按品牌稿复原成常驻四枚（8.1.1 曾把它们收进一个「全部 ∨」下拉，省 90rpx 给墙 ——
       稿子要的是这一行，视觉优先，那 90rpx 还回去）。
       稿子里只有这四个分类、没有「全部」胶囊，所以「全部」改由「再点一次已选中的那枚」回到：
       少了这条路，点进一个空分类就再也回不到全部票根（见 home.js onTabTap）。 -->
  <view class="hc-tabs">
    <view wx:for="{{tabs}}" wx:key="key"
          class="hc-tab pressable {{active === item.key ? 'is-on' : ''}}"
          data-key="{{item.key}}" bindtap="onTabTap" hover-class="press-hover"
          aria-role="button"
          aria-label="{{item.name}}{{active === item.key ? '，已筛选，再点一次看全部' : '分类'}}">
      <!-- 选中态要连图标一起反白，而 iconSrc 生成的是 data-uri、颜色编译期写死，只能备两套地址 -->
      <image class="hc-tab-ic" src="{{active === item.key ? tabIc.on[item.key] : tabIc.off[item.key]}}"
             mode="aspectFit" aria-hidden="true" />
      <text class="hc-tab-t">{{item.name}}</text>
    </view>
  </view>

  <!-- ============ 云故障 / 超上限横幅（同 album 的 tm-net） ============ -->
  <view wx:if="{{netBar}}" class="hc-net pressable" hover-class="press-item-hover" bindtap="onNetBarTap"
        aria-role="button" aria-label="{{netBar.text}}">
    <text class="hc-net-t">{{netBar.text}}</text>
  </view>

  <!-- ============ 票根墙：两列 ============ -->
  <!-- 骨架替成真数据、以及切换分类时，整批走一次 200ms 淡入，不再「唰」地硬切 -->
  <view class="hc-grid {{listIn ? 'fade-in-200' : ''}}" wx:if="{{!loading && (colA.length || colB.length)}}">
    <view class="hc-col">
      <block wx:for="{{colA}}" wx:key="id">
        <template is="hcTicket" data="{{item: item, art: art, ic: ic}}" />
      </block>
    </view>
    <view class="hc-col">
      <block wx:for="{{colB}}" wx:key="id">
        <template is="hcTicket" data="{{item: item, art: art, ic: ic}}" />
      </block>
    </view>
  </view>

  <!-- ============ 骨架屏 ============ -->
  <view class="hc-grid" wx:if="{{loading}}">
    <view class="hc-col">
      <view class="hc-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="hc-sk-shot tk-skeleton"></view>
        <view class="hc-sk-title tk-skeleton"></view>
        <view class="hc-sk-meta tk-skeleton"></view>
      </view>
    </view>
    <view class="hc-col">
      <view class="hc-sk-card" wx:for="{{[4,5,6]}}" wx:key="*this">
        <view class="hc-sk-shot tk-skeleton"></view>
        <view class="hc-sk-title tk-skeleton"></view>
        <view class="hc-sk-meta tk-skeleton"></view>
      </view>
    </view>
  </view>

  <!-- ============ 空态：分两种，「有票但这一分类没有」不能写成「你还没有票」============ -->
  <view class="tk-empty hc-empty" wx:if="{{!loading && !colA.length && !colB.length}}">
    <image class="hc-empty-ic" src="{{ic.emptyIc}}" mode="aspectFit" aria-hidden="true" />
    <view class="hc-empty-t">{{hasAny ? '这个分类还没有票根' : '这里还没贴上票根'}}</view>
    <view class="hc-empty-s">{{hasAny ? '再点一下亮着的分类，就能看全部' : '拍一张，让它成为这一页的第一张'}}</view>
    <view class="hc-empty-btn pressable" hover-class="press-hover" bindtap="goScan" aria-role="button" aria-label="拍一张票根">拍一张票根</view>
  </view>

  <!-- ============「今天」两条：那年今天 / 老票根专场 ============
       8.2.0 从墙上头挪到这里。它在墙上头要占 215rpx，票根墙就得从第 626rpx 才开始画，
       首屏只剩 2.3 行卡 —— 而稿子同一位置是 384rpx、首屏 3 行整。
       两条原本各是一块、各写各的外边距（26 / 20 / 22）；合成一块、行间用细描边分开，
       谁该显示谁显示（本来就有各自的出现条件），一眼还看得出这是「今天这一组事」。
       8.2.0 第二版：签到那一行**整个搬去「我的」页**了 —— 我的页本来就有一张完整的
       时光签卡（含连签天数、积分余额、积分怎么来），首页这一行是它的副本，
       每天要点的那一下摆在个人中心，才是用户找它的地方。这里只剩两条回忆类入口。 -->
  <view class="hc-today" wx:if="{{mem || legacy}}">
    <!-- 7.4.0 R4 / 8.1.5 那年今天：三档都落空才整行不显示（新用户常态）。
         档①「去年今天」、档②「去年这个月」是日期上的真命中；档③「重温这一张」不是，
         所以它的文案里一个日期都没有 —— 编一句「去年的今天你在……」是假的，一眼看得出来。
         三档共用这一行、共用同两个槽位（引子 + 票名），见 utils/memory.js -->
    <view class="hc-td pressable" wx:if="{{mem}}" hover-class="press-hover" bindtap="goMemory"
          aria-role="button" aria-label="{{mem.text}} {{mem.title}}">
      <image class="hc-td-ic" src="{{ic.memIc}}" mode="aspectFit" aria-hidden="true" />
      <text class="hc-td-k">{{mem.text}}</text>
      <text class="hc-td-v">{{mem.title}}</text>
      <image class="hc-td-go" src="{{ic.goIc}}" mode="aspectFit" aria-hidden="true" />
    </view>

    <!-- 8.1.0 老票根专场：只在「已经有票、但一张五年前的都没有」时出现
           （规则在 utils/legacy.js）—— 新用户该先拍第一张，有老票的人该看回忆，
           这行对他们是多余的。翻出来一张之后它自己就收了，不需要用户手动关。 -->
    <view class="hc-td pressable" wx:if="{{legacy}}" hover-class="press-hover" bindtap="goLegacy"
          aria-role="button" aria-label="老票根专场：抽屉里那些也值得留下来">
      <image class="hc-td-ic" src="{{ic.legacyIc}}" mode="aspectFit" aria-hidden="true" />
      <view class="hc-td-body">
        <text class="hc-td-t">老票根专场</text>
        <text class="hc-td-s">抽屉里那些，也值得留下来</text>
      </view>
      <image class="hc-td-go" src="{{ic.goIc}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <view class="hc-foot-space"></view>
</view>

<!-- ============ A6 长按快捷菜单（7.3.0）============
     长按任意票根卡 → 生成纪念卡片 / 分享给好友 / 删除。
     show 由页面控制，删除成功后组件回抛 deleted，页面重取列表。 -->
<ticket-menu show="{{menu}}" id="{{menuId}}" title="{{menuTitle}}"
             bind:close="closeMenu" bind:deleted="onMenuDeleted" />
