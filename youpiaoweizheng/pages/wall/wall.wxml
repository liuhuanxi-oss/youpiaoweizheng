<scroll-view
  class="page-scroll theme-{{theme}}"
  scroll-y="{{!reorderMode}}"
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
  refresher-enabled="{{!skeleton && !reorderMode}}"
  refresher-default-style="none"
  refresher-background="transparent"
  refresher-threshold="{{60}}"
  refresher-max-drag-rate="{{0.5}}"
  refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh"
  bindrefresherpulling="onPulling"
  bindrefresherrestore="onRestore"
>


  <!-- 4.10.1 重装饰层：纸面噪点（全主题）/ C 水彩晕染头 -->
  <view class="wash-layer"></view>
  <view class="grain"></view>
  <!-- ===== 品牌头部（4.22.1 升级：名称放大 + 右上角时令签，像日记落款；静态常驻不参与骨架切换） ===== -->
  <view class="brand">
    <view class="brand-row">
      <view class="brand-stamp serif">有票</view>
      <text class="brand-name serif">有票为证</text>
      <view class="brand-meta" wx:if="{{nowLabel}}">
        <text class="bm-date">{{nowLabel}}</text>
        <text class="bm-sub serif">时光收藏册</text>
      </view>
    </view>
    <!-- 4.10：诗意引言（大留白后的第一行呼吸） -->
    <view class="brand-quote serif">每一张票，都是回得去的时光</view>
    <!-- 4.10.1：手写批注（像日记落款） -->
    <view class="brand-note">—— 收好它们，日子就有了形状</view>
  </view>

  <!-- ===== 4.17.0 T5「我的小程序」软引导（最多出现 2 次；出现/点击都有埋点） ===== -->
  <view class="t5-bar" wx:if="{{t5Show}}">
    <view class="t5-star serif">✦</view>
    <view class="t5-txt">收进「我的小程序」，下次下拉直达票根墙</view>
    <view class="t5-go" hover-class="t5-press" bindtap="t5Go">去添加</view>
    <view class="t5-x" catchtap="t5Close">✕</view>
  </view>

  <!-- ===== 4.18.0 云故障/超限横幅（兜底演示数据→点我重试；超 200 张→截断提示） ===== -->
  <view class="net-bar" wx:if="{{netBar}}" bindtap="onNetBarTap" hover-class="{{netBar.retry ? 'net-bar-press' : ''}}">
    <text class="net-dot"></text>
    <text class="net-txt">{{netBar.text}}</text>
    <text class="net-go" wx:if="{{netBar.retry}}">重试 ›</text>
  </view>

  <!-- ===== M4.5 骨架屏：加载超 300ms 才出现（防闪烁），与真实内容结构对应
       4.22.0 扩充：时光机 / 金刚区 ×4 / 问候 / 搜索 / 胶囊 / 双格内容卡 / 票根卡 ×2 ===== -->
  <view class="sk" wx:if="{{skeleton}}">
    <view class="sk-tm skeleton-bone"></view>
    <view class="sk-greet skeleton-bone"></view>
    <view class="sk-quick">
      <view class="sk-q skeleton-bone" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"></view>
    </view>
    <view class="sk-search skeleton-bone"></view>
    <view class="sk-chips">
      <view class="sk-chip skeleton-bone" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"></view>
    </view>
    <view class="sk-duo skeleton-bone"></view>
    <view class="sk-card skeleton-bone" wx:for="{{[1, 2]}}" wx:key="*this"></view>
  </view>

  <!-- ===== 真实内容（骨架让位后 200ms 淡入） ===== -->
  <view class="fade-in" wx:else>

    <!-- ===== 那年今日 · 时光机（命中往年今天→票根卡；未命中→今日时光签，永不空转） ===== -->
    <view class="tm pressable" hover-class="press-item-hover" wx:if="{{timeMachine}}" bindtap="goTimeMachine">
      <view class="tm-badge serif">忆</view>
      <view class="tm-body">
        <view class="tm-date">{{timeMachine.label}}</view>
        <view class="tm-title serif">{{timeMachine.title}}</view>
        <view class="tm-sub">{{timeMachine.sub}}</view>
      </view>
      <view class="tm-go">›</view>
    </view>

    <!-- ===== 问候行（按月口径；数字 M4.5 起滚动入场） ===== -->
    <view class="greet" wx:if="{{greet}}">
      <block wx:if="{{greet.num > 0}}">{{greet.label}}，你收藏了 <animated-number class="num" value="{{greet.num}}" /> 张时光</block>
      <block wx:else>{{greet.label}}还没收成，翻翻下面的旧票根吧</block>
    </view>

    <!-- ===== 4.22.0 金刚区（常用功能入口）：扫一扫收藏 / 双人空间 / 足迹地图 / 时光美术馆
         整理模式下隐藏；美术馆入口仅在有票根时出现（需带最新票进页） ===== -->
    <view class="quick {{reorderMode ? 'hide' : ''}}">
      <view
        class="q-item pressable"
        hover-class="press-hover"
        data-k="scan"
        bindtap="goQuick"
        aria-role="button"
        aria-label="扫一扫，收藏票根"
      >
        <view class="q-ico scan-ico">⌕</view>
        <view class="q-name">扫一扫</view>
      </view>
      <view
        class="q-item pressable"
        hover-class="press-hover"
        data-k="duo"
        bindtap="goQuick"
        aria-role="button"
        aria-label="进入双人空间"
      >
        <view class="q-ico duo-ico">♡</view>
        <view class="q-name">双人空间</view>
      </view>
      <view
        class="q-item pressable"
        hover-class="press-hover"
        data-k="map"
        bindtap="goQuick"
        aria-role="button"
        aria-label="打开足迹地图"
      >
        <view class="q-ico map-ico">✈</view>
        <view class="q-name">足迹地图</view>
      </view>
      <view
        class="q-item pressable"
        hover-class="press-hover"
        wx:if="{{hasTickets}}"
        data-k="art"
        bindtap="goQuick"
        aria-role="button"
        aria-label="进入时光美术馆"
      >
        <view class="q-ico art-ico">◈</view>
        <view class="q-name">时光美术馆</view>
      </view>
    </view>

    <!-- ===== 4.11.0 搜索（PRD：票根墙支持搜索，与类型筛选叠加；整理模式内隐藏） ===== -->
    <view class="search" wx:if="{{!reorderMode}}">
      <text class="s-icon">⌕</text>
      <input
        class="s-input"
        placeholder="搜票名 / 场馆 / 城市 / 座位"
        placeholder-class="s-ph"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onSearch"
      />
      <text class="s-clear pressable" wx:if="{{kw}}" catchtap="onSearchClear" aria-role="button" aria-label="清空搜索">✕</text>
    </view>

    <!-- ===== 类型筛选胶囊（整理模式内隐藏） ===== -->
    <view class="chips" wx:if="{{!reorderMode}}">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="chip pressable {{activeFilter === item.key ? 'on' : ''}}"
        hover-class="press-hover"
        data-key="{{item.key}}"
        bindtap="onFilterTap"
      >{{item.label}}</view>
      <!-- 4.14.0 整理模式入口 -->
      <view
        class="chip chip-reorder pressable"
        hover-class="press-hover"
        bindtap="enterReorder"
        aria-role="button"
        aria-label="进入整理模式，调整票根顺序"
      >⠿ 整理</view>
    </view>

    <!-- ===== 4.22.0 内容展示区·时光小记 + 运营位·美术馆 CTA（双格卡；有票根才渲染）
         左格：本月/总量/城市/最早年份——把「空旷」换成可读的时光厚度；
         右格：把一张票变成版画（art 页转化，me 页次数包的前置触点） ===== -->
    <view class="duo-card" wx:if="{{summary && !reorderMode}}">
      <view class="dc-note">
        <view class="dc-cap serif">时光小记</view>
        <view class="dc-big">
          <text class="dc-num serif">{{summary.month}}</text>
          <text class="dc-unit">张 · 本月收进</text>
        </view>
        <view class="dc-line2">已攒 {{summary.total}} 张 · 点亮 {{summary.cities}} 座城市</view>
        <view class="dc-line3" wx:if="{{summary.firstYear}}">最早一张，来自 {{summary.firstYear}} 年</view>
      </view>
      <view class="dc-cta pressable" hover-class="press-hover" data-k="art" bindtap="goQuick" aria-role="button" aria-label="去时光美术馆生成版画">
        <view class="cta-pic serif">◈</view>
        <view class="cta-cap serif">时光美术馆</view>
        <view class="cta-t serif">把一张票，变成画</view>
        <view class="cta-go">去画画 ›</view>
      </view>
    </view>

    <!-- ===== 4.14.0 整理模式条（4.16.0：文案覆盖组内+组间） ===== -->
    <view class="reorder-bar" wx:if="{{reorderMode}}">
      <text class="rb-t">拖票卡调组内顺序 · 拖月份标题调章节顺序</text>
      <view class="rb-done pressable" hover-class="press-hover" bindtap="exitReorder" aria-role="button">完成</view>
    </view>

    <!-- ===== 月分组票根流（4.16.0：整理模式下整组可拖动换章节位次） ===== -->
    <view
      wx:for="{{groups}}"
      wx:key="label"
      wx:for-item="group"
      class="group {{groupLift === index ? 'g-lift' : ''}} {{groupOffsets[index] ? 'g-shift' : ''}}"
      style="{{reorderMode ? 'transform: translateY(' + (groupLift === index ? groupDy : (groupOffsets[index] || 0)) + 'px);' : ''}}"
    >
      <view class="sec-title">
        <text class="t serif">{{group.label}}</text>
        <view class="sec-r">
          <text class="s">共 {{group.list.length}} 张</text>
          <view
            class="gh-handle"
            wx:if="{{reorderMode}}"
            data-gi="{{index}}"
            catchtouchstart="onGroupTS"
            catchtouchmove="onGroupTM"
            catchtouchend="onGroupTE"
            catchtouchcancel="onGroupTE"
            aria-role="button"
            aria-label="拖动调整{{group.label}}的章节顺序"
          >⠿</view>
        </view>
      </view>
      <!-- 4.21.0 流内原生模板广告位（首屏后、第二个月份组开头；纸卡容器装裱——
           平台 ad 组件样式不可改，theme-b 深色下自带白底，用「装裱画框」语义包裹避免裸贴补丁；
           广告位 ID 未配置时整块不渲染，流量主开通回填 utils/ads.js 即生效） -->
      <view class="ad-wrap card" wx:if="{{index === 1 && adsNativeId && !reorderMode}}">
        <view class="ad-cap">时光 · 赞助内容</view>
        <ad unit-id="{{adsNativeId}}" type="native" binderror="onAdError"></ad>
      </view>
      <ticket-card
        wx:for="{{group.list}}"
        wx:key="id"
        ticket="{{item}}"
        theme="{{theme}}"
        tape="{{index === 0}}"
        stagger="{{reorderMode ? 0 : (index < 8 ? index * 40 : 0)}}ms"
        reorder="{{reorderMode}}"
        lifted="{{dragId === item.id}}"
        offset="{{offsets[item.id] || 0}}"
        bindtap="goDetail"
        bindcard="goTicketCard"
        binddel="onTicketDel"
        binddragstart="onDragStart"
        binddragmove="onDragMove"
        binddragend="onDragEnd"
      />
      <!-- 半张预览（peek）：超 3 张的组折叠，点开展开（预览卡不启用左滑） -->
      <view class="peek pressable" hover-class="press-item-hover" wx:if="{{group.peekTicket}}" bindtap="onPeekTap" data-label="{{group.label}}">
        <view class="peek-card">
          <ticket-card ticket="{{group.peekTicket}}" swipe="{{false}}" />
        </view>
        <view class="peek-mask"></view>
        <view class="peek-more">还有 {{group.more}} 张 · 点开展开</view>
      </view>
    </view>

    <!-- 空态（4.11.0：区分「搜索无结果」与「该类还没有票根」） -->
    <view wx:if="{{!groups.length}}" class="empty pressable" hover-class="press-item-hover" bindtap="{{kw ? 'onSearchClear' : 'goScan'}}">
      <view class="big">🎫</view>
      <block wx:if="{{kw}}">
        <view>没找到与「{{kw}}」相关的票根</view>
        <view class="kai">点这里清空搜索，回到全部 →</view>
      </block>
      <block wx:else>
        <view>这一类还没有票根</view>
        <view class="kai">从这里开始，收进第一张 →</view>
      </block>
    </view>

  </view>

  <!-- ICP 备案展示（工信部要求：小程序首页底部标注备案号；小程序内无法直跳工信部站点，点击复制） -->
  <view class="icp-row" bindtap="copyIcp" aria-role="button" aria-label="复制ICP备案号">
    <text class="icp-txt">粤ICP备20010271号-11X</text>
  </view>

  <!-- 底部留白（避开 tabBar） -->
  <view class="safe-bottom"></view>

  <!-- ===== M4.5 自定义下拉头：票根图标随手势旋转 + 状态文案 ===== -->
  <view slot="refresher" class="refresher">
    <view class="rf-ticket" style="transform: rotate({{pullDeg}}deg)">🎫</view>
    <text class="rf-text">{{refreshText}}</text>
  </view>
</scroll-view>
