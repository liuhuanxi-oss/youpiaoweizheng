/* pages/album/album.wxss —— v6.5 票夹（六主题变量化，禁止写死色值） */
.ab-scroll { height: 100vh; }

/* —— 顶部 hero —— */
.ab-hero { padding: 32rpx 28rpx 16rpx; }
.ab-hero-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.ab-title { display: flex; align-items: baseline; gap: 12rpx; }
.ab-title-t { font-size: 48rpx; color: var(--text); }
.ab-icon-btn {
  width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center;
  font-size: 32rpx;
  background: var(--card-bg, var(--card)); border-radius: 50%;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
}
.ab-search {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--card-bg, var(--card)); border-radius: 999rpx; padding: 12rpx 24rpx;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
}
.ab-search-ico { font-size: 30rpx; color: var(--text2); }
.ab-search-input { flex: 1; font-size: 26rpx; color: var(--text); }
.ab-search-ph { color: var(--text2); }
.ab-search-clear { font-size: 28rpx; color: var(--text2); padding: 4rpx 8rpx; }

/* —— 分类 Tabs 横向滚动 —— */
.ab-tabs {
  white-space: nowrap;
  padding: 8rpx 20rpx 20rpx;
}
.ab-tab {
  display: inline-flex; align-items: center;
  padding: 16rpx 32rpx;
  font-size: 26rpx; color: var(--text2);
  background: var(--card-bg, var(--card)); border-radius: 999rpx;
  margin-right: 16rpx;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
  transition: all 200ms ease;
}
.ab-tab.on {
  background: var(--primary);
  color: var(--on-primary); font-weight: 700;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.10));
}

/* —— 那年今日·时光机（票根造型） —— */
.ab-tm {
  margin: 16rpx 28rpx;
  background: linear-gradient(135deg, var(--soft) 0%, var(--chip) 100%);
  border-radius: var(--card-r, 32rpx);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.06));
}
.ab-tm-inner {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 28rpx;
}
.ab-tm-badge {
  width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  font-size: 34rpx; font-weight: 700;
  color: var(--on-primary); background: var(--primary);
  border-radius: 50%;
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb), 0.10));
  flex: 0 0 72rpx;
}
.ab-tm-body { flex: 1; min-width: 0; }
.ab-tm-date { font-size: 22rpx; color: var(--text2); }
.ab-tm-title { font-size: 28rpx; font-weight: 700; color: var(--text); margin-top: 4rpx; }
.ab-tm-sub { font-size: 22rpx; color: var(--text2); margin-top: 4rpx; }
.ab-tm-go { font-size: 48rpx; color: var(--text2); line-height: 1; flex: 0 0 auto; }

/* —— 月分组小标题 —— */
.ab-sec-title {
  display: flex; align-items: baseline; gap: 16rpx;
  padding: 32rpx 28rpx 16rpx;
}
.ab-sec-title .ab-t { font-size: 32rpx; font-weight: 700; color: var(--text); letter-spacing: 2rpx; }
.ab-sec-title .ab-s { font-size: 22rpx; color: var(--text2); }

/* —— 列表卡（票根缩略 tk-stub 带侧齿孔） —— */
.ab-list-card {
  display: flex; align-items: center; gap: 22rpx;
  margin: 0 28rpx 18rpx;
  padding: 22rpx;
}
.ab-list-thumb { font-size: 52rpx; }
.ab-tag-show    { background: var(--soft); }
.ab-tag-movie   { background: var(--cat-movie, var(--chip)); }
.ab-tag-traffic { background: var(--cat-transport, var(--chip)); }
.ab-list-body { flex: 1; min-width: 0; }
.ab-list-title { font-size: 28rpx; font-weight: 700; color: var(--text); line-height: 1.3; }
.ab-list-meta { margin-top: 6rpx; font-size: 22rpx; color: var(--text2); }
.ab-list-tags { margin-top: 10rpx; }
.ab-chip-show    { background: var(--soft); color: var(--primary); }
.ab-chip-movie   { background: var(--chip); color: var(--text2); }
.ab-chip-traffic { background: var(--chip); color: var(--text2); }
.ab-list-date { flex: 0 0 auto; text-align: center; }
.ab-date-d { display: block; font-size: 40rpx; font-weight: 700; color: var(--primary); line-height: 1.1; }
.ab-date-m { display: block; font-size: 20rpx; color: var(--text2); margin-top: 4rpx; }

/* —— 折叠/展开行（v6.6.1：修复「每月第 4 张起不可见」，统一用主题变量） —— */
.ab-fold {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  margin: 0 28rpx 26rpx;
  padding: 18rpx 24rpx;
  background: var(--card-bg, var(--card));
  border-radius: 999rpx;
  box-shadow: var(--card-shadow, none);
}
.ab-fold-t { font-size: 24rpx; color: var(--text2); }
.ab-fold-a { font-size: 24rpx; font-weight: 700; color: var(--primary); }

/* —— 加载态骨架 ——
   v6.6.0 动效3：与 ab-list-card 像素级一致（thumb 116rpx / 标题 28rpx / 地点 22rpx /
   标签行 36rpx / 右侧日期列 56rpx 宽），呼吸用 tk-skeleton（奶油灰块 opacity 口径） */
.ab-sk-item {
  display: flex; align-items: center; gap: 22rpx;
  margin: 0 28rpx 18rpx; padding: 22rpx;
  background: var(--card-bg, var(--card)); border-radius: var(--card-r, 32rpx);
  box-shadow: var(--card-shadow, none);
}
.ab-sk-thumb { width: 116rpx; height: 116rpx; flex: 0 0 116rpx; border-radius: 16rpx; }
.ab-sk-body { flex: 1; }
.ab-sk-line { height: 28rpx; border-radius: 14rpx; }
.ab-sk-line.short { width: 45%; margin-top: 14rpx; height: 22rpx; }
.ab-sk-chip { width: 96rpx; height: 36rpx; margin-top: 14rpx; border-radius: 18rpx; }
.ab-sk-date { width: 56rpx; flex: 0 0 56rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.ab-sk-date-d { width: 44rpx; height: 34rpx; border-radius: 8rpx; }
.ab-sk-date-m { width: 32rpx; height: 20rpx; border-radius: 6rpx; }

/* —— 空态 —— */
.ab-empty-emoji { font-size: 96rpx; line-height: 1; }

