/* pages/album/album.wxss —— 时光机（品牌全案 · 稿屏8 一比一）
   六主题变量化：颜色一律读 --*；写死的十六进制只允许出现在 var(--x, #兜底) 里。
   品牌固定色（胶带三色）不在这里，由 album.js 一并下发。 */
.tm-page { min-height: 100vh; }
.tm-scroll { height: 100vh; }

/* ═══ ① 标题行 ═══ */
.tm-head {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  padding: 26rpx 28rpx 8rpx;
}
.tm-title-wrap { position: relative; display: flex; align-items: center; gap: 14rpx; }
.tm-title {
  font-size: 46rpx; font-weight: 900; color: var(--text);
  letter-spacing: 8rpx; line-height: 1.25;
}
.tm-spark { width: 30rpx; height: 30rpx; }
.tm-spark-r { transform: scale(0.8); opacity: 0.8; }
/* 手写标题下的玫瑰笔触 */
.tm-brush {
  position: absolute; left: 50%; bottom: 0;
  width: 210rpx; height: 9rpx; border-radius: 999rpx;
  transform: translateX(-50%) rotate(-1.2deg);
  background: var(--stamp, #C26B5E); opacity: 0.32;
}
.tm-brand {
  position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%);
  display: flex; align-items: center; gap: 8rpx;
}
.tm-brand-logo { width: 44rpx; height: 44rpx; border-radius: 12rpx; }
.tm-brand-name { font-size: 24rpx; font-weight: 700; color: var(--text); letter-spacing: 1rpx; }

/* ═══ ② 搜索 ═══ */
.tm-search {
  display: flex; align-items: center; gap: 12rpx;
  margin: 18rpx 28rpx 0; padding: 14rpx 24rpx;
  background: var(--card-bg, var(--card));
  border: 2rpx dashed var(--border, #E2D9C7);
  border-radius: 999rpx;
}
.tm-search-ic { width: 30rpx; height: 30rpx; flex: 0 0 30rpx; }
.tm-search-input { flex: 1; font-size: 26rpx; color: var(--text); }
.tm-search-ph { color: var(--text2); }
.tm-search-clear { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.tm-search-clear-ic { width: 24rpx; height: 24rpx; }

/* ═══ ③ 类型筛选 ═══ */
.tm-tabs { white-space: nowrap; padding: 18rpx 28rpx 6rpx; }
.tm-tab {
  display: inline-flex; align-items: center;
  padding: 12rpx 28rpx; margin-right: 14rpx;
  font-size: 24rpx; color: var(--text2);
  background: var(--chip, #EFE8DA); border-radius: 999rpx;
  transition: background 200ms ease, color 200ms ease;
}
.tm-tab.on {
  background: var(--primary); color: var(--on-primary); font-weight: 700;
}
/* 类名与首页分类胶囊复用同一视觉规则，但作用域留在本页 */

/* ═══ ④ 云故障横幅 ═══ */
.tm-net {
  margin: 14rpx 28rpx 0; padding: 16rpx 24rpx;
  background: var(--soft, #E9E2D4); border-radius: 18rpx;
}
.tm-net-t { font-size: 23rpx; color: var(--text2); line-height: 1.5; }

/* ═══ ⑤ 骨架 ═══ */
.tm-sk-item { padding: 24rpx 28rpx 0 55rpx; }
.tm-sk-node { display: flex; align-items: center; gap: 18rpx; padding-left: 46rpx; }
.tm-sk-dot { width: 22rpx; height: 22rpx; border-radius: 50%; }
.tm-sk-year { width: 150rpx; height: 44rpx; border-radius: 12rpx; }
.tm-sk-card {
  height: 430rpx; margin: 26rpx 0 34rpx 118rpx;
  border-radius: 12rpx;
}

/* ═══ ⑥ 那年今日（稿外保留：本页的招牌功能，稿子里没画） ═══ */
.tm-today {
  position: relative;
  margin: 24rpx 28rpx 4rpx; padding: 34rpx 26rpx 24rpx;
  background: linear-gradient(140deg, var(--soft, #E9E2D4) 0%, var(--chip, #EFE8DA) 100%);
  border-radius: var(--card-r, 28rpx);
  box-shadow: var(--card-shadow, 0 8rpx 24rpx rgba(var(--text-rgb, 107, 91, 80), 0.06));
}
.tm-today-ribbon {
  position: absolute; left: 26rpx; top: -16rpx;
  padding: 6rpx 20rpx; border-radius: 999rpx;
  font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx;
  color: var(--on-primary); background: var(--stamp, #C26B5E);
}
.tm-today-body { display: flex; align-items: center; gap: 18rpx; }
.tm-today-ic { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; }
.tm-today-txt { flex: 1; min-width: 0; }
.tm-today-title { font-size: 30rpx; font-weight: 700; color: var(--text); line-height: 1.35; }
.tm-today-sub { margin-top: 6rpx; font-size: 22rpx; color: var(--text2); line-height: 1.5; }
.tm-today-go { width: 26rpx; height: 26rpx; flex: 0 0 26rpx; }

/* ═══ ⑦ 时间轴 ═══
   轴在左：.tm-tl 的 padding-left 55rpx 就是轴的位置，年份圆点用负外边距压回轴上，
   明信片再往右让 118rpx，空出来的右侧留给卡外点缀。 */
.tm-tl { position: relative; padding: 20rpx 20rpx 10rpx 55rpx; }
.tm-rail {
  position: absolute; left: 55rpx; top: 34rpx; bottom: 60rpx;
  border-left: 3rpx dashed var(--border, #E2D9C7);
}
.tm-node {
  display: flex; flex-direction: column; align-items: flex-start;
  padding: 22rpx 0 6rpx 46rpx;
}
.tm-node-row { display: flex; align-items: center; gap: 16rpx; }
/* 圆点靠负外边距「退回」轴上：46 − 57 + 22/2 = 0，正好落在 padding-left 55rpx 的虚线上，
   且跟着行高自动垂直居中，不依赖绝对定位的魔法数字 */
.tm-node-dot {
  flex: 0 0 22rpx; width: 22rpx; height: 22rpx; margin-left: -57rpx;
  border-radius: 50%; background: var(--stamp, #C26B5E);
}
.tm-node-dash { flex: 0 0 30rpx; width: 30rpx; height: 4rpx; border-radius: 4rpx; background: var(--stamp, #C26B5E); }
.tm-node-y { font-size: 54rpx; font-weight: 900; color: var(--text); letter-spacing: 2rpx; line-height: 1.1; }
.tm-node-wave { margin-left: 73rpx; width: 132rpx; height: 48rpx; opacity: 0.75; }

/* ═══ ⑧ 明信片 ═══
   卡片宽 440rpx：右侧留出 137rpx 的装饰带，邮戳的注销线才有地方伸出去而不出屏。
   （稿内的卡片只占屏宽 41%，是按 1152 宽的品牌册画的；真机上照片要看得清，
   故卡面放大到 59%，邮戳、胶带、点缀的相对位置与稿一致。） */
.tm-post { position: relative; margin: 0 0 26rpx 118rpx; }
.tm-post-card {
  position: relative; width: 440rpx;
  padding: 18rpx 18rpx 16rpx;
  background: var(--card-bg, var(--card));
  border-radius: 12rpx;
  box-shadow: 0 14rpx 34rpx rgba(var(--text-rgb, 107, 91, 80), 0.16);
}
.tm-post-tape {
  position: absolute; left: -26rpx; top: -18rpx;
  width: 132rpx; height: 37rpx; transform: rotate(-14deg); z-index: 3;
}
.tm-post-photo {
  position: relative; height: 300rpx; margin: 14rpx 12rpx 0;
  border-radius: 6rpx; overflow: hidden;
  background: var(--soft, #E9E2D4);
  transform: rotate(1.6deg);
}
.tm-post-img { width: 100%; height: 100%; }
.tm-post-fb { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; }
.tm-post-fb-ic { width: 62rpx; height: 62rpx; }
.tm-post-fb-t { font-size: 22rpx; color: var(--text2); letter-spacing: 2rpx; }

/* —— 邮戳：图形（圈 + 注销线）+ 真文本（弧形城市名 + 三行日期）—— */
/* 邮戳框 140rpx。圆环 viewBox 60 → 外圈半径 63.9rpx、内圈虚线 39.7rpx；
   城市名的弧半径 51rpx（album.js 的 PM_R），字盒 20rpx 高 → 占 41~61rpx，正好卡在环带里。
   改这三个数中任意一个，都要同步跑 tests/album_timemachine.test.js 里的环带断言。 */
.tm-pm {
  position: absolute; right: -18rpx; top: -26rpx;
  width: 140rpx; height: 140rpx; z-index: 4;
  transform: rotate(-9deg);
}
.tm-pm-ring { width: 100%; height: 100%; }
/* 注销线从圆环右沿起笔往外拉：left 95% 就是圆环右沿（圆心 50% + 半径 45.7%），
   太靠左会横穿圆圈、压到中间的日期。 */
.tm-pm-wave {
  position: absolute; left: 95%; top: 12%;
  width: 98rpx; height: 106rpx;
}
/* 圆心：宽高都为 0 的锚点，逐字 rotate 再沿半径推出 */
.tm-pm-city { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.tm-pm-ch {
  position: absolute; left: -9rpx; top: -10rpx;
  width: 18rpx; line-height: 20rpx; text-align: center;
  font-size: 17rpx; font-weight: 700; color: var(--text);
}
.tm-pm-date {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -46%);
  display: flex; flex-direction: column; align-items: center;
}
.tm-pm-l { font-size: 15rpx; line-height: 1.35; color: var(--text); opacity: 0.85; }

/* —— 卡面下方：票名 + 日期 —— */
.tm-post-b { padding: 16rpx 12rpx 6rpx; }
.tm-post-t {
  font-size: 30rpx; font-weight: 700; color: var(--text); line-height: 1.35;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.tm-post-row { display: flex; align-items: center; gap: 8rpx; margin-top: 10rpx; }
.tm-post-cal { width: 24rpx; height: 24rpx; flex: 0 0 24rpx; }
.tm-post-d { font-size: 23rpx; color: var(--text2); letter-spacing: 1rpx; }

/* —— 卡外点缀：一卡一个，偶数在右、奇数在左 —— */
.tm-post-spot { position: absolute; width: 112rpx; height: 78rpx; opacity: 0.9; }
.tm-post-spot.is-r { right: -66rpx; top: 46%; }
.tm-post-spot.is-l { left: -112rpx; bottom: 18rpx; transform: scaleX(-1); }

/* ═══ ⑨ 折叠 / 展开 ═══ */
.tm-fold {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin: 0 0 26rpx 118rpx; padding: 16rpx 0;
  border: 2rpx dashed var(--border, #E2D9C7); border-radius: 999rpx;
}
.tm-fold-t { font-size: 23rpx; color: var(--text2); }
.tm-fold-ic { width: 22rpx; height: 22rpx; transform: rotate(90deg); }
.tm-fold-ic.is-up { transform: rotate(-90deg); }

/* ═══ ⑩ 空态 ═══ */
.tm-empty-ic { width: 96rpx; height: 96rpx; }
