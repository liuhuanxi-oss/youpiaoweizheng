<!-- pages/me/me.wxml —— 我的（品牌全案 · 稿屏11 一比一）
     结构：品牌行 → hero（水彩头像 + 手写标题 + 波浪下划线）→ 票根造型统计卡 → 5 张独立功能卡
     所有图形一律走 <image src="data:image/svg+xml,...">：小程序 wxml 不渲染内联 <svg>，
     且 SVG 是独立文档、不认 CSS 变量，故颜色由 me.js 按当前主题编译成实色。 -->
<scroll-view class="tk-page theme-{{theme}} me-page" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- ① 顶部品牌行：logo + 名称 + 齿轮（齿轮 = 设置页入口，稿屏11 右上角） -->
  <view class="me-brand">
    <image class="me-brand-logo" src="/images/brand-logo.png" mode="aspectFit" aria-hidden="true" />
    <text class="me-brand-name">有票为证</text>
    <view class="me-brand-gear pressable" hover-class="press-item-hover" bindtap="goSetting"
          aria-role="button" aria-label="设置">
      <image class="me-brand-gear-ic" src="{{ic.gear}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <!-- ② Hero：左侧水彩头像（可授权更换），右侧手写标题 + slogan + 波浪下划线 -->
  <view class="me-hero">
    <view class="me-avatar-wrap">
      <view class="me-ray me-ray-l1"></view>
      <view class="me-ray me-ray-l2"></view>
      <view class="me-ray me-ray-r1"></view>
      <view class="me-ray me-ray-r2"></view>
      <button class="me-avatar-btn pressable" hover-class="press-item-hover" open-type="chooseAvatar"
              bindchooseavatar="onChooseAvatar" aria-label="选择头像">
        <image wx:if="{{profile.avatar}}" class="me-avatar" src="{{profile.avatar}}" mode="aspectFill" />
        <image wx:else class="me-avatar" src="{{ic.avatar}}" mode="aspectFill" />
      </button>
    </view>

    <view class="me-hero-body">
      <view class="me-nick-row">
        <input
          id="nickInput"
          type="nickname"
          class="me-nick"
          placeholder="票根收藏家"
          placeholder-class="me-nick-ph"
          value="{{profile.nickname}}"
          focus="{{nickFocus}}"
          maxlength="24"
          bindinput="onNickInput"
          bindfocus="onNickFocus"
          bindblur="onNickBlur"
          bindconfirm="onNickBlur"
          aria-label="昵称输入框"
        />
        <image class="me-hero-star" src="{{ic.star}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="me-sub-row">
        <text class="me-sub">时光不回头，票根存温柔</text>
        <image class="me-hero-heart" src="{{ic.heart}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="me-underline"></view>
      <!-- 4.22.0 兜底胶囊：原生 input 偶尔机型点击不响应时，胶囊编程聚焦（catchtap 防冒泡） -->
      <view class="me-nick-go pressable" wx:if="{{!profile.nickname}}" catchtap="onNickAssist"
            hover-class="press-item-hover" aria-role="button" aria-label="设置昵称">设置昵称</view>
    </view>

    <!-- 右侧花枝（溢出到页面右缘，稿屏11） -->
    <image class="me-hero-sprig" src="{{deco.sprig}}" mode="aspectFit" aria-hidden="true" />
  </view>

  <!-- ③ 统计卡：票根造型（左右齿孔 + 米白纸面），三列各是 图标+标签 / 大数字 / 单位 -->
  <view class="me-stat-card">
    <view class="me-stat">
      <view class="me-stat-h">
        <image class="me-stat-ic" src="{{ic.bookmark}}" mode="aspectFit" aria-hidden="true" />
        <text class="me-stat-l">已收藏</text>
      </view>
      <view class="me-stat-figure">
        <view class="me-blob me-blob-rose"></view>
        <text class="me-stat-n">{{stats.total}}</text>
      </view>
      <text class="me-stat-u">张</text>
    </view>

    <view class="me-stat">
      <view class="me-stat-h">
        <image class="me-stat-ic" src="{{ic.pin}}" mode="aspectFit" aria-hidden="true" />
        <text class="me-stat-l">城市足迹</text>
      </view>
      <view class="me-stat-figure">
        <view class="me-blob me-blob-sage"></view>
        <text class="me-stat-n">{{stats.cities}}</text>
      </view>
      <text class="me-stat-u">座</text>
    </view>

    <view class="me-stat">
      <view class="me-stat-h">
        <image class="me-stat-ic" src="{{ic.sprig}}" mode="aspectFit" aria-hidden="true" />
        <text class="me-stat-l">美好回忆</text>
      </view>
      <view class="me-stat-figure">
        <view class="me-blob me-blob-butter"></view>
        <text class="me-stat-n">{{stats.shows}}</text>
      </view>
      <text class="me-stat-u">段</text>
    </view>
  </view>

  <!-- ④ 5 张独立功能卡（稿屏11）：水彩圆底图标 + 名称 + 手绘装饰 + 细线箭头 -->
  <view class="me-entries">
    <view
      class="me-entry pressable"
      hover-class="press-item-hover"
      wx:for="{{entries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onEntry"
      aria-role="button"
      aria-label="{{item.name}}"
    >
      <image class="me-entry-deco-l" src="{{item.decoL}}" mode="aspectFit" aria-hidden="true" />
      <image class="me-entry-deco-r" src="{{item.decoR}}" mode="aspectFit" aria-hidden="true" />
      <view class="me-entry-ico" style="background: {{item.tint}};">
        <image class="me-entry-ico-img" src="{{item.ico}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <text class="me-entry-name">{{item.name}}</text>
      <image class="me-entry-go" src="{{ic.chevron}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <view class="me-icp" bindtap="copyIcp" aria-role="button" aria-label="复制ICP备案号">粤ICP备20010271号-11X</view>
  <view class="tk-safe-bottom"></view>
</scroll-view>

<!-- M5 隐私授权弹窗（me 页 chooseAvatar/nickname 走官方授权弹层） -->
<privacy-sheet />
