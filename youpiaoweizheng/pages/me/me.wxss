/* pages/me/me.wxss —— 品牌全案 · 稿屏11 个人中心
   结构：品牌行 → hero → 票根造型统计卡 → 5 张独立功能卡
   注：本页所有色值一律走主题令牌（app.wxss 的六套 .theme-*）；
   稿内手绘装饰是 <image> 直出的 SVG data-uri，颜色由 me.js 按主题编译成实色。 */

/* 固定高（不是 min-height）：内容撑高的话 scroll-view 内部不会滚，
   下拉刷新永远触发不了 —— 与 album 的 .tm-scroll、duo 的 .page-scroll 同一口径。
   底部留白靠页面末尾的 .tk-safe-bottom 撑，和那两页一样。 */
.me-page { height: 100vh; }

/* 本页卡片统一走稿内圆角（--card-r 在 paper 主题只有 4px，直接吃会变直角） */
.me-page { --me-r: 28rpx; }

/* ===== ① 顶部品牌行（右对齐） ===== */
.me-brand {
  display: flex; align-items: center; justify-content: flex-end;
  gap: 14rpx;
  padding: 20rpx 44rpx 0;
}
.me-brand-logo {
  width: 56rpx; height: 56rpx;
  border-radius: 16rpx;
}
.me-brand-name {
  font-size: 32rpx; font-weight: 700;
  color: var(--brown, #6B5B50);
  letter-spacing: 1rpx;
}
.me-brand-gear { padding: 6rpx; margin-left: 8rpx; }
.me-brand-gear-ic { width: 40rpx; height: 40rpx; display: block; }

/* ===== ①′ 云故障 / 超上限横幅（视觉同 album 的 .tm-net） =====
   本类不写 transition：让全局 .pressable 的按压回弹原样生效（页面级同名属性会盖掉它） */
.me-net { margin: 12rpx 44rpx 0; padding: 16rpx 24rpx; background: var(--soft, #E9E2D4); border-radius: 18rpx; }
.me-net-t { font-size: 23rpx; color: var(--text2, #8A7B66); line-height: 1.5; }

/* ===== ② Hero ===== */
.me-hero {
  position: relative;
  display: flex; align-items: center;
  gap: 30rpx;
  padding: 26rpx 44rpx 0;
}

/* 头像：水彩圆底 + 左右各两道放射短线 */
.me-avatar-wrap { position: relative; flex: 0 0 152rpx; width: 152rpx; height: 152rpx; }
.me-avatar-btn {
  width: 152rpx; height: 152rpx;
  padding: 0; margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  line-height: normal;
}
.me-avatar-btn::after { border: none; display: none; }
.me-avatar { width: 152rpx; height: 152rpx; border-radius: 50%; display: block; }

.me-ray {
  position: absolute;
  width: 18rpx; height: 4rpx;
  border-radius: 2rpx;
  background: var(--brown, #6B5B50);
  opacity: 0.45;
}
.me-ray-l1 { left: -14rpx; top: 56rpx;  transform: rotate(-16deg); }
.me-ray-l2 { left: -22rpx; top: 84rpx;  transform: rotate(14deg); width: 24rpx; }
.me-ray-r1 { right: -14rpx; top: 56rpx; transform: rotate(16deg); }
.me-ray-r2 { right: -22rpx; top: 84rpx; transform: rotate(-14deg); width: 24rpx; }

/* 右侧：手写标题 + slogan + 手绘下划线 */
.me-hero-body { position: relative; flex: 1; min-width: 0; }
.me-nick-row { display: flex; align-items: center; gap: 10rpx; }
.me-nick {
  flex: 0 1 auto; min-width: 0;
  font-family: var(--font-title, inherit);
  font-size: 50rpx; font-weight: 700;
  color: var(--brown, #6B5B50);
  letter-spacing: 1rpx;
  line-height: 1.2;
}
.me-nick-ph { color: var(--text2, #A5968A); font-weight: 700; }
.me-hero-star { flex: 0 0 30rpx; width: 30rpx; height: 30rpx; }

.me-sub-row { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; }
.me-sub { font-size: 28rpx; color: var(--text2, #A5968A); }
.me-hero-heart { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; }

/* 手绘下划线：压在 slogan 下方，两端渐隐 */
.me-underline {
  width: 260rpx; height: 6rpx;
  margin-top: 8rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, transparent, var(--rose, #D9A0A6) 18%, var(--brown, #6B5B50) 82%, transparent);
  opacity: 0.5;
  transform: rotate(-1.2deg);
}

.me-nick-go {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx dashed var(--rose, #D9A0A6);
  color: var(--rose, #D9A0A6);
  font-size: 22rpx;
}

/* 花枝：溢出到页面右缘（稿内压在屏幕边上） */
.me-hero-sprig {
  position: absolute;
  right: -18rpx; top: -6rpx;
  width: 150rpx; height: 100rpx;
  pointer-events: none;
}

/* ===== ③ 统计卡（票根造型：左右齿孔 + 米白纸面） =====
   齿孔用 radial-gradient 挖出页面底色，做在左右两条伪元素上 */
.me-stat-card {
  position: relative;
  display: flex; align-items: stretch;
  margin: 40rpx 44rpx 0;
  padding: 26rpx 8rpx 22rpx;
  background: var(--cream, #FAF5EE);
  border: 1rpx solid var(--border, #EFE5D8);
  border-radius: 4rpx;
}
.me-stat-card::before,
.me-stat-card::after {
  content: '';
  position: absolute; top: -1rpx; bottom: -1rpx;
  width: 15rpx;
  background-image: radial-gradient(circle at 50% 50%, var(--bg, #FAF5EE) 7rpx, transparent 7rpx);
  background-size: 15rpx 24rpx;
  background-repeat: repeat-y;
  pointer-events: none;
}
.me-stat-card::before { left: -1rpx; }
.me-stat-card::after { right: -1rpx; }

.me-stat {
  position: relative;
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; align-items: center;
}
/* 列间竖虚线（除第一列外） */
.me-stat + .me-stat::before {
  content: '';
  position: absolute; left: 0; top: 10rpx; bottom: 10rpx;
  width: 2rpx;
  background-image: linear-gradient(180deg, var(--border, #EFE5D8) 60%, transparent 0);
  background-size: 2rpx 12rpx;
  background-repeat: repeat-y;
}

.me-stat-h { display: flex; align-items: center; gap: 8rpx; }
.me-stat-ic { flex: 0 0 32rpx; width: 32rpx; height: 32rpx; }
.me-stat-l { font-size: 24rpx; color: var(--brown, #6B5B50); }

/* 大数字压在水彩椭圆色块上，两侧各一道放射短线 */
.me-stat-figure {
  position: relative;
  width: 100%; height: 96rpx;
  margin-top: 10rpx;
  display: flex; align-items: center; justify-content: center;
}
.me-blob {
  position: absolute;
  left: 50%; top: 50%;
  width: 130rpx; height: 74rpx;
  margin: -37rpx 0 0 -65rpx;
  border-radius: 50%;
  opacity: 0.55;
}
.me-blob-rose   { background: radial-gradient(ellipse at 50% 50%, var(--rose, #D9A0A6) 0%, transparent 72%); }
.me-blob-sage   { background: radial-gradient(ellipse at 50% 50%, var(--sage, #A9C3A6) 0%, transparent 72%); }
.me-blob-butter { background: radial-gradient(ellipse at 50% 50%, var(--butter, #F6DFA8) 0%, transparent 72%); }
.me-stat-n {
  position: relative;
  font-size: 54rpx; font-weight: 700;
  color: var(--brown, #6B5B50);
  line-height: 1;
}
.me-stat-figure::before,
.me-stat-figure::after {
  content: '';
  position: absolute; top: 50%;
  width: 16rpx; height: 4rpx;
  margin-top: -2rpx;
  border-radius: 2rpx;
  background: rgba(var(--text-rgb, 107, 91, 80), 0.3);
}
/* 每侧两道短线：box-shadow 无位移偏移伪造第二道（两线同色同形，只是下移） */
.me-stat-figure::before {
  left: 12rpx; transform: rotate(-14deg);
  box-shadow: 0 16rpx 0 rgba(var(--text-rgb, 107, 91, 80), 0.3);
}
.me-stat-figure::after {
  right: 12rpx; transform: rotate(14deg);
  box-shadow: 0 16rpx 0 rgba(var(--text-rgb, 107, 91, 80), 0.3);
}

.me-stat-u {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text2, #A5968A);
}

/* ===== ④ 5 张独立功能卡 ===== */
.me-entries { margin-top: 40rpx; }
.me-entry {
  position: relative;
  display: flex; align-items: center;
  gap: 24rpx;
  height: 104rpx;
  margin: 0 44rpx 18rpx;
  padding: 0 26rpx 0 22rpx;
  background: var(--card, #FFFFFF);
  border: 1rpx solid var(--border, #EFE5D8);
  border-radius: var(--me-r);
  box-shadow: 0 6rpx 20rpx rgba(var(--text-rgb, 107, 91, 80), 0.05);
}
/* 卡两侧手绘装饰：压在卡缘上、小幅溢出（稿屏11 的手账感），一律不吃点击 */
.me-entry-deco-l,
.me-entry-deco-r {
  position: absolute;
  top: 50%;
  pointer-events: none;
  opacity: 0.9;
}
.me-entry-deco-l { left: -22rpx;  width: 78rpx;  height: 56rpx; margin-top: -28rpx; }
.me-entry-deco-r { right: 76rpx;  width: 84rpx;  height: 40rpx; margin-top: -20rpx; }

/* 圆形水彩底 + 白色线性图标 */
.me-entry-ico {
  flex: 0 0 94rpx; width: 94rpx; height: 94rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.me-entry-ico-img { width: 44rpx; height: 44rpx; display: block; }

.me-entry-name {
  flex: 1; min-width: 0;
  font-size: 34rpx; font-weight: 600;
  color: var(--brown, #6B5B50);
  letter-spacing: 1rpx;
}
.me-entry-go { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; opacity: 0.55; }

/* ===== ICP 备案（工信部要求，点击复制） ===== */
.me-icp {
  margin: 40rpx 44rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text2, #A5968A);
}

/* ===== 7.2.0 L1：AI 重绘额度（从设置页迁来） ===== */
/* ===== 7.4.0 R1 时光签 + 积分 ===== */
.me-sign { margin: 24rpx 44rpx 0; padding: 28rpx 32rpx; }
.me-sign-head { display: flex; align-items: baseline; justify-content: space-between; }
.me-sign-t { font-size: 29rpx; font-weight: 600; color: var(--brown, #6B5B50); }
.me-sign-streak { font-size: 23rpx; color: var(--text2, #A5968A); }
.me-sign-sub { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--text2, #A5968A); }
.me-sign-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.me-sign-points { font-size: 24rpx; color: var(--brown, #6B5B50); }
.me-sign-num { font-size: 34rpx; font-weight: 700; }
.me-sign-btn {
  padding: 0 34rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 31rpx;
  font-size: 25rpx;
  color: var(--on-primary, #FFF8F2);
  background: var(--stamp, #C26B5E);
}
.me-sign-done { font-size: 24rpx; color: var(--sage, #A9C3A6); }
/* 8.0.5 积分怎么来：积分行下方一行小字入口（低频动作，视觉重量压到最低） */
.me-sign-rule { display: flex; margin-top: 12rpx; }
.me-sign-rule-t { font-size: 22rpx; color: var(--text2, #A5968A); }
.me-sign-exchange-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 14rpx; }
.me-sign-hint { flex: 1; min-width: 0; font-size: 22rpx; color: var(--text2, #A5968A); }
.me-sign-exchange {
  flex: 0 0 auto;
  padding: 0 28rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  font-size: 23rpx;
  color: var(--on-primary, #FFF8F2);
  background: var(--stamp, #C26B5E);
}

.me-quota { margin: 24rpx 44rpx 0; padding: 28rpx 32rpx; }
.me-quota-head { display: flex; align-items: baseline; justify-content: space-between; }
.me-quota-t { font-size: 29rpx; font-weight: 600; color: var(--brown, #6B5B50); }
.me-quota-n { font-size: 23rpx; color: var(--text2, #A5968A); }
.me-quota-num { font-size: 40rpx; font-weight: 700; color: var(--brown, #6B5B50); }
.me-quota-bar {
  margin-top: 18rpx;
  height: 12rpx; border-radius: 6rpx;
  background: var(--soft, #F5EDE2);
  overflow: hidden;
}
/* 额度条：进页从 0 涨到自己的宽度，之后换数据（重绘一次少一次）走 transition 平滑回落，
   不再是一格一格地「跳」。@keyframes 只写 from（0），to 交给行内 width ——
   关键帧缺省的那一端取元素的当前值。填充只许用 backwards：
   both/forwards 会把动画终值留在元素上，把行内 width 盖死，
   之后再换数据就永远不涨了（同 .stagger / report 的 .bar-fill 那条坑）。 */
.me-quota-fill {
  height: 12rpx; border-radius: 6rpx; background: var(--sage, #A9C3A6);
  transition: width 900ms var(--ease-smooth);
  animation: me-quota-grow 900ms var(--ease-smooth) backwards;
}
@keyframes me-quota-grow { from { width: 0; } }
.me-quota-label { margin-top: 12rpx; font-size: 23rpx; color: var(--text2, #A5968A); }

/* ===== 7.2.0 L1：勋章横滑（从设置页搬来） ===== */
.me-badges { margin-top: 32rpx; }
.me-badges-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 44rpx; }
.me-badges-t { font-size: 29rpx; font-weight: 600; color: var(--brown, #6B5B50); }
.me-badges-c { font-size: 23rpx; color: var(--text2, #A5968A); }
.me-badges-scroll {
  margin-top: 20rpx;
  padding-left: 44rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.me-badge {
  display: inline-block;
  width: 128rpx; margin-right: 16rpx;
  vertical-align: top;
  text-align: center;
  white-space: normal;
}
.me-badge-ic {
  width: 72rpx; height: 72rpx;
  padding: 14rpx;
  border-radius: 50%;
  background: var(--soft, #F5EDE2);
  box-sizing: content-box;
}
.me-badge.on .me-badge-ic { background: var(--sage-soft, #E9F0E6); }
/* 点亮：原先只是底色直接换过去，看着像「刷」地闪一下；现在是弹一下再落定。
   @keyframes 只写 from，to 交给元素自身（scale 1 / opacity 1），
   --ease-spring 自带过冲，0.72 → 越过 1 一点 → 停住。
   backwards：延迟期间先按住 from（缩着、透明），否则会先以原大小闪一帧再弹。 */
.me-badge.on .me-badge-ic { animation: badge-pop 420ms var(--ease-spring) backwards; }
@keyframes badge-pop { from { transform: scale(0.72); opacity: 0; } }
/* 一次点亮多枚时像一串灯依次亮起 —— 85ms 一档，同 app.wxss 的 .stagger。
   只错前 6 枚（一屏横滑也就露出 5 枚），第 7 枚起与第 6 枚同时。
   延迟按 DOM 位次给：锁着的勋章照样占位，所以「第几枚」是稳的。 */
.me-badge.on:nth-child(2) .me-badge-ic { animation-delay: 85ms; }
.me-badge.on:nth-child(3) .me-badge-ic { animation-delay: 170ms; }
.me-badge.on:nth-child(4) .me-badge-ic { animation-delay: 255ms; }
.me-badge.on:nth-child(5) .me-badge-ic { animation-delay: 340ms; }
.me-badge.on:nth-child(n+6) .me-badge-ic { animation-delay: 425ms; }
.me-badge-name {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx; line-height: 1.35;
  color: var(--text2, #A5968A);
}
.me-badge.on .me-badge-name { color: var(--brown, #6B5B50); font-weight: 600; }

/* ===== 4.20.3 清除署名资料（隐私政策承诺的入口） ===== */
.me-clear {
  margin: 20rpx 44rpx 0;
  text-align: right;
  font-size: 23rpx;
  color: var(--text2, #A5968A);
  text-decoration: underline;
}

/* ===== 7.4.0 B 段 R2：积分兑换确认弹层 ===== */
.redeem { padding: 8rpx 8rpx 20rpx; }
.redeem-main {
  border: 2rpx dashed var(--border, #E2D9C7);
  border-radius: var(--card-r, 20rpx);
  background: var(--soft, #E9E2D4);
  padding: 32rpx 30rpx;
  text-align: center;
}
.redeem-t { display: block; font-size: 32rpx; font-weight: 700; color: var(--text); letter-spacing: 4rpx; }
.redeem-s { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--text2); line-height: 1.7; }
.redeem-lines { margin-top: 24rpx; }
.redeem-line { display: flex; align-items: baseline; justify-content: space-between; padding: 14rpx 4rpx; }
.redeem-k { font-size: 24rpx; color: var(--text2); }
.redeem-v { font-size: 27rpx; font-weight: 600; color: var(--brown, #6B5B50); }
.redeem-btn {
  margin-top: 26rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 28rpx;
  color: var(--on-primary, #FFF8F2);
  background: var(--stamp, #C26B5E);
}
.redeem-btn.disabled { opacity: 0.6; }
.redeem-note { display: block; margin-top: 18rpx; text-align: center; font-size: 20rpx; color: var(--text2); letter-spacing: 1rpx; }

/* ===== 7.4.0 动效降级（docs/MOTION.md §5）=====
   本页新增的三处动效：额度条涨、勋章弹。降级后条子直接落到最终宽度、
   勋章直接亮 —— 与改动前的行为一致。卡片错开登场由 app.wxss 的 .stagger 统一收掉。 */
@media (prefers-reduced-motion: reduce) {
  .me-quota-fill { animation: none; transition: none; }
  .me-badge.on .me-badge-ic { animation: none; }
}
