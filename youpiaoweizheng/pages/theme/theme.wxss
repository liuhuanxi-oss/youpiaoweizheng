/* pages/theme/theme.wxss —— 六主题选择页（统一版式卡片） */

/* —— 页头 —— */
.th-head { padding: 56rpx 36rpx 28rpx; }
.th-title { color: var(--text); font-family: "PingFang SC", sans-serif; }
.th-sub { margin-top: 12rpx; color: var(--text2); }
.th-hint { margin-top: 18rpx; font-size: 23rpx; color: var(--text2); letter-spacing: 1rpx; }

/* —— 卡片列表 —— */
.th-list { padding: 0 28rpx; }
.th-card {
  margin-bottom: 32rpx;
  border: 4rpx solid transparent;
  border-radius: 32rpx;
  transition: border-color 200ms ease, transform 200ms ease;
}
.th-card.on { border-color: var(--primary); }
.th-card-hover { transform: scale(0.985); }
/* 7.4.0：按下的缩放也要降级。描边变色是「状态」，缩放是「动」——
   开着系统「减弱动态效果」的用户只该看到前者（口径同 app.wxss 的 .pressable 降级）。 */
@media (prefers-reduced-motion: reduce) {
  .th-card { transition: border-color 200ms ease; }
  .th-card-hover { transform: none; }
}

/* ① 主题预览区：一张微缩票根卡
      图本身是 320×176 的 SVG（data-uri），比例由 padding-bottom 撑出来 ——
      写死高度的话，不同机型宽度一变，票根就会被拉扁。 */
.th-preview {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 55%;        /* 176 / 320 */
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.th-preview-img {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
}

/* ② 主题名 */
.th-name-row { display: flex; align-items: center; gap: 14rpx; }
.th-name { font-weight: 800; }
.th-check {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  padding: 7rpx; box-sizing: border-box;
  flex: 0 0 34rpx;
}
.th-tagline { margin-top: 8rpx; letter-spacing: 1rpx; }
.th-desc { margin-top: 6rpx; line-height: 1.55; }

/* ③ 色板 */
.th-swatch-title {
  margin: 26rpx 0 14rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
}
.th-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.th-sw {
  width: 148rpx;
  border-radius: 20rpx;
  background: var(--bg);
  padding: 10rpx 10rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.th-sw-dot {
  width: 100%; height: 56rpx; border-radius: 14rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.th-sw-name { font-size: 20rpx; color: var(--text2); }
.th-sw-hex {
  font-size: 18rpx; color: var(--text2);
  font-family: "SF Mono", Menlo, Consolas, monospace;
  letter-spacing: 0.5rpx; opacity: 0.85;
}

/* ④ 字体层级样例 */
.th-type {
  border-radius: 20rpx;
  background: var(--bg);
  padding: 18rpx 20rpx;
}
.th-type-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.th-type-row:last-child { border-bottom: none; }
.th-type-label {
  flex: 0 0 128rpx;
  font-size: 20rpx; color: var(--text2);
}
.th-type-sample {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.th-type-spec {
  flex: 0 0 auto;
  font-size: 18rpx; color: var(--text2); opacity: 0.8;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

/* ⑤ 4 个装饰元素图形（image 直出 SVG，尺寸须给 image 而非 svg） */
.th-decos {
  display: flex;
  gap: 14rpx;
}
.th-deco {
  flex: 1;
  min-width: 0;
  border-radius: 20rpx;
  background: var(--bg);
  padding: 14rpx 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.th-deco-img { width: 72rpx; height: 52rpx; }
.th-deco-label {
  font-size: 18rpx; color: var(--text2);
  white-space: nowrap;
  transform: scale(0.92);
}

/* —— 底部固定操作条 —— */
.th-safe { height: 40rpx; }
.th-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}
.th-bar-reset {
  flex: 0 0 auto;
  border: 2rpx solid var(--border);
  color: var(--text2);
  font-size: 26rpx;
  padding: 20rpx 36rpx;
}
.th-bar-apply { flex: 1; height: 88rpx; line-height: 88rpx; }
.th-bar-apply.is-cur {
  background: var(--soft);
  color: var(--primary);
  box-shadow: none;
}
.tk-btn-hover { transform: scale(0.97); opacity: 0.9; }
