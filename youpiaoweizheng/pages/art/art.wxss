/* pages/art/art.wxss —— AI 艺术重绘（品牌全案 · 稿屏5 一比一）
   六主题变量化：颜色一律读 --*；写死的十六进制只允许出现在 var(--x, #兜底) 里。
   品牌固定色（金星 / 玫瑰星 / 齿边墨 / 花邮票）不在这里，由 art.js 随图形一起下发。 */
.ar-page { min-height: 100vh; }
.ar-scroll { height: 100vh; }
.ar-wrap { position: relative; padding: 0 60rpx 20rpx; }

/* ═══ ① 题头 ═══ */
.ar-head { position: relative; padding: 30rpx 0 0; }
.ar-title-wrap { position: relative; display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.ar-title {
  font-size: 46rpx; font-weight: 900; color: var(--text);
  letter-spacing: 6rpx; line-height: 1.25;
}
/* 四角星（deco.star4 的 viewBox 是 32×24，宽高比 4:3） */
.ar-spark { width: 28rpx; height: 21rpx; }
.ar-spark.is-r { transform: scale(0.86); }
.ar-brush {
  position: absolute; left: 50%; bottom: -4rpx;
  width: 150rpx; height: 9rpx; border-radius: 999rpx;
  background: var(--stamp, #C26B5E); opacity: 0.35;
  transform: translateX(-50%) rotate(-1.4deg);
}
/* 题头两侧的手绘点缀：左上花枝、右上注销波浪，各探出内边距一点，贴着屏幕边 */
.ar-deco-sprig { position: absolute; left: -40rpx; bottom: -36rpx; width: 96rpx; height: 64rpx; }
.ar-deco-wave { position: absolute; right: -34rpx; bottom: -32rpx; width: 98rpx; height: 43rpx; transform: rotate(-8deg); opacity: 0.7; }

/* ═══ ② 卡片公共：白卡 + 从顶边探出的玫瑰标签 ═══ */
.ar-card {
  position: relative;
  padding: 34rpx 22rpx 26rpx;
  background: var(--card-bg, var(--card));
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(var(--text-rgb, 107, 91, 80), 0.14);
}
.ar-card-src { margin-top: 52rpx; }
.ar-card-art { margin-top: 0; padding: 22rpx; }
.ar-tab {
  position: absolute; left: 18rpx; top: -22rpx;
  padding: 10rpx 26rpx; border-radius: 16rpx;
  background: var(--rose, #D9A0A6); color: var(--on-primary, #F5F0E6);
  font-size: 28rpx; font-weight: 700; letter-spacing: 3rpx; line-height: 1.2;
  box-shadow: 0 6rpx 16rpx rgba(var(--text-rgb, 107, 91, 80), 0.18);
}

/* 原票根照片：contain 完整呈现（与「图归图」导出口径一致，不裁切票根） */
.ar-photo {
  height: 300rpx; border-radius: 14rpx; overflow: hidden;
  background: var(--soft, #E9E2D4);
}
.ar-photo-img { width: 100%; height: 100%; }

/* ═══ ③ 前后分隔：奶油圆 + 金星 + 笑弧，两侧各两道短光线 ═══ */
.ar-sep { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 28rpx 0 34rpx; }
.ar-sep-ball {
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: var(--soft, #E9E2D4);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
}
.ar-sep-star { width: 46rpx; height: 35rpx; }
/* 笑弧：只留底边框 + 底角圆化，一条向下鼓的弧（上边框不画，所以上半截是空的） */
.ar-sep-smile {
  width: 26rpx; height: 12rpx;
  border-bottom: 4rpx solid var(--stamp, #C26B5E);
  border-radius: 0 0 999rpx 999rpx;
  opacity: 0.7;
}
.ar-rays { display: flex; flex-direction: column; align-items: flex-end; gap: 14rpx; }
.ar-rays.is-r { align-items: flex-start; }
.ar-ray { width: 34rpx; height: 5rpx; border-radius: 5rpx; background: var(--stamp, #C26B5E); opacity: 0.5; transform: rotate(-14deg); }
.ar-ray.is-b { width: 24rpx; opacity: 0.38; transform: rotate(14deg); }

/* ═══ ④ 艺术重绘：齿边画框 ═══
   框 586×330rpx 与 art.js 的 FRAME_W / FRAME_H 同源：齿孔是贴着框边跑的闭合线，
   两边对不上时齿边会缩在中间（image 的 aspectFit 先等比缩放再居中）。
   tests/art_repaint.test.js 有断言盯着这两个数。 */
.ar-frame { position: relative; width: 586rpx; height: 330rpx; }
.ar-frame-line { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* 画芯：让开齿孔（齿边 path 内缩 5 单位），底色用卡片色，contain 留白读作「装裱边」 */
.ar-art-img {
  position: absolute; left: 16rpx; top: 16rpx; width: 554rpx; height: 298rpx;
  border-radius: 8rpx; background: var(--card-bg, var(--card));
}

/* —— 画框上的点缀（与阶段无关，三种状态都在） —— */
.ar-stamp { position: absolute; right: 30rpx; top: 34rpx; width: 66rpx; height: 66rpx; transform: rotate(5deg); }
/* 注销线与邮票同一条水平中心（邮票 34 + 66/2 = 67 → 波浪 67 − 46/2 = 44） */
.ar-stamp-wave { position: absolute; right: 92rpx; top: 44rpx; width: 104rpx; height: 46rpx; opacity: 0.65; }
.ar-star { position: absolute; width: 34rpx; height: 26rpx; opacity: 0.9; }
.ar-star.is-a { left: 34rpx; top: 58rpx; }
.ar-star.is-b { right: 46rpx; bottom: 48rpx; transform: scale(0.8); }
.ar-frame-sprig { position: absolute; width: 92rpx; height: 61rpx; }
.ar-frame-sprig.is-l { left: -22rpx; bottom: -26rpx; }
/* 右侧那枝要压在画框右沿的中段：再往上会和右上角的花邮票叠在一起 */
.ar-frame-sprig.is-r { right: -18rpx; top: 150rpx; transform: scaleX(-1) scale(0.84); }

/* —— running：作画中（晕染呼吸 + 转星） —— */
.ar-busy {
  position: absolute; left: 16rpx; top: 16rpx; width: 554rpx; height: 298rpx;
  border-radius: 8rpx; overflow: hidden; background: var(--card-bg, var(--card));
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ar-halo {
  position: absolute; width: 240rpx; height: 240rpx; border-radius: 50%;
  /* 暖光晕随主题反色（浅底=暖褐柔光，film 暗底=暖白柔光） */
  background: radial-gradient(circle, rgba(var(--text-rgb, 107, 91, 80), 0.18), rgba(var(--text-rgb, 107, 91, 80), 0) 70%);
  animation: ar-halo 2.4s ease-in-out infinite;
}
.ar-halo.h2 { width: 340rpx; height: 340rpx; animation-delay: 1.2s; opacity: 0.6; }
@keyframes ar-halo {
  0%, 100% { transform: scale(0.82); opacity: 0.55; }
  50%      { transform: scale(1.12); opacity: 1; }
}
.ar-busy-star { width: 58rpx; height: 44rpx; animation: ar-spin 3.2s linear infinite; }
@keyframes ar-spin { to { transform: rotate(360deg); } }
.ar-busy-t { margin-top: 20rpx; font-size: 30rpx; font-weight: 700; color: var(--text); letter-spacing: 3rpx; }
.ar-busy-d { margin-top: 8rpx; font-size: 22rpx; color: var(--text2); }
/* 转的是星、呼吸的是光，都属于装饰性动效：关闭动效时停住即可，不影响可读性 */
@media (prefers-reduced-motion: reduce) {
  .ar-halo, .ar-busy-star { animation: none; }
}

/* —— idle / failed：空白画框（虚线卡纸感） —— */
.ar-blank {
  position: absolute; left: 16rpx; top: 16rpx; width: 554rpx; height: 298rpx;
  border-radius: 8rpx; background: var(--soft, #E9E2D4);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
}
.ar-blank-star { width: 52rpx; height: 39rpx; }
.ar-blank-t { font-size: 34rpx; font-weight: 700; color: var(--text); letter-spacing: 5rpx; }
.ar-blank-d { font-size: 22rpx; color: var(--text2); }
.ar-blank-no { margin-top: 8rpx; font-size: 20rpx; color: var(--text2); letter-spacing: 3rpx; }

.ar-fail { margin-top: 20rpx; font-size: 23rpx; color: var(--stamp, #C26B5E); line-height: 1.7; text-align: center; }

/* ═══ ⑤ 说明句 + 玫瑰笔触 ═══ */
.ar-cap { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 38rpx; }
.ar-cap-t { font-size: 24rpx; color: var(--text2); letter-spacing: 1rpx; }
.ar-cap-star { width: 24rpx; height: 18rpx; }
/* 笔触是向下鼓的一道浅弧：靠底边框 + 底角圆化，不用图片 */
.ar-cap-brush {
  width: 274rpx; height: 14rpx; margin: 8rpx auto 0;
  border-bottom: 6rpx solid var(--stamp, #C26B5E);
  border-radius: 0 0 999rpx 999rpx;
  opacity: 0.35;
}

/* ═══ ⑥ 额度（只在还会花额度的阶段露脸） ═══ */
.ar-quota {
  display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14rpx;
  margin-top: 24rpx; font-size: 22rpx; color: var(--text2);
}
.ar-pips { display: inline-flex; align-items: center; gap: 8rpx; }
.ar-pip {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  border: 2rpx solid var(--stamp, #C26B5E); /* 空心 = 可用 */
  background: transparent;
}
.ar-pip.used { background: var(--stamp, #C26B5E); } /* 实心 = 已用（印章落下） */
.ar-quota-paid { font-size: 20rpx; color: var(--accent); }

/* ═══ ⑦ 主按钮 + 次按钮 ═══ */
/* 稿里这颗胶囊只占屏宽 54%（约 403rpx），真机上按 420rpx 落——再窄就要靠猜才点得中 */
.ar-cta {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  width: 420rpx; height: 92rpx; margin: 30rpx auto 0;
  border-radius: 999rpx;
  background: var(--stamp, #C26B5E); color: var(--on-primary, #F5F0E6);
  font-size: 30rpx; font-weight: 700; letter-spacing: 6rpx;
  box-shadow: 0 12rpx 30rpx rgba(var(--text-rgb, 107, 91, 80), 0.22);
}
.ar-cta.dis { opacity: 0.55; }
.ar-cta-ic { width: 34rpx; height: 34rpx; }
.ar-cta-t { line-height: 1; }

.ar-again { display: flex; align-items: center; justify-content: center; gap: 22rpx; margin-top: 40rpx; padding: 10rpx 0; }
.ar-again-line { width: 48rpx; height: 3rpx; border-radius: 3rpx; background: var(--border, #E2D9C7); }
.ar-again-t { font-size: 25rpx; color: var(--text2); letter-spacing: 2rpx; }

/* ═══ ⑧ 页脚点缀 ═══ */
.ar-foot { position: relative; height: 130rpx; }
.ar-foot-wave { position: absolute; left: -40rpx; bottom: 6rpx; width: 78rpx; height: 34rpx; opacity: 0.6; }
.ar-foot-sprig { position: absolute; right: -34rpx; bottom: 0; width: 96rpx; height: 64rpx; transform: scaleX(-1); }

/* ═══ ⑨ 加载骨架（与真内容同高同宽，数据替换零跳动） ═══ */
.ar-hold { padding: 30rpx 60rpx 0; }
.ar-hold-title { width: 340rpx; height: 52rpx; margin: 0 auto 56rpx; border-radius: 12rpx; }
.ar-hold-card { height: 386rpx; border-radius: 24rpx; }
.ar-hold-ball { width: 104rpx; height: 104rpx; margin: 28rpx auto; border-radius: 50%; }

/* ═══ ⑩ 空态（lost / empty，配合全局 .empty） ═══ */
.ar-empty-ic { display: block; width: 96rpx; height: 96rpx; margin: 0 auto 22rpx; }
.e-sub { margin-top: 14rpx; font-size: 24rpx; color: var(--text2); line-height: 1.7; }
.empty .btn-main { margin-top: 44rpx; }
.btn-sub { margin-top: 24rpx; text-align: center; font-size: 25rpx; color: var(--text2); padding: 12rpx 0; }

/* ═══ ⑪ 付费墙（bottom-sheet 内容区） ═══ */
.pw { padding: 8rpx 8rpx 20rpx; }
.pw-plate {
  border: 2rpx dashed var(--border, #E2D9C7);
  border-radius: var(--card-r, 20rpx);
  background: var(--soft, #E9E2D4);
  padding: 36rpx 30rpx;
  text-align: center;
}
.pw-plate-star { display: block; width: 44rpx; height: 33rpx; margin: 0 auto 12rpx; }
.pw-plate-t { font-size: 32rpx; font-weight: 700; color: var(--text); letter-spacing: 4rpx; }
.pw-plate-d { margin-top: 10rpx; font-size: 23rpx; color: var(--text2); line-height: 1.7; }
.pw-opt {
  margin-top: 24rpx;
  display: flex; align-items: center; gap: 18rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--card-r, 20rpx);
  background: var(--card-bg, var(--card));
  border: 2rpx solid var(--border, #E2D9C7);
}
.pw-opt.pw-buy { border-color: var(--stamp, #C26B5E); } /* 主推出路：品牌描边 */
.pw-opt-ic { flex: 0 0 36rpx; width: 36rpx; height: 36rpx; }
.pw-opt-l { flex: 1; min-width: 0; }
.pw-opt-t { font-size: 27rpx; font-weight: 600; color: var(--text); }
.pw-opt-s { margin-top: 6rpx; font-size: 21rpx; color: var(--text2); }
.pw-go { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; }
.pw-note { margin-top: 20rpx; text-align: center; font-size: 20rpx; color: var(--text2); letter-spacing: 2rpx; }

/* —— 合成画布：移出可视区（type=2d 只在保存瞬间绘制） —— */
.cv-off {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 360px;
  height: 480px;
}
