/* pages/legacy/legacy.wxss —— 老票根专场（8.1.0 拉新）
   六主题变量化：颜色一律走 var(--*)，不写死色值 */
.page {
  padding: 40rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.serif { font-family: var(--font-title); }

/* ===== 头图区（邮戳与花枝是底纹，压字下面） ===== */
.lg-hero {
  position: relative;
  padding: 30rpx 0 44rpx;
  text-align: center;
}
.lg-hero-pm {
  position: absolute;
  top: 6rpx;
  right: 0;
  width: 150rpx;
  height: 150rpx;
  opacity: 0.5;
}
.lg-hero-sprig {
  position: absolute;
  bottom: 8rpx;
  left: 0;
  width: 110rpx;
  height: 74rpx;
  opacity: 0.55;
}
.lg-title {
  position: relative;
  font-size: 52rpx;
  letter-spacing: 6rpx;
  line-height: 1.3;
}
.lg-sub {
  position: relative;
  margin-top: 16rpx;
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: var(--text2);
}

/* ===== 开场白：卡片外观走全局 .card（六主题分化在那），这里只管内外边距 ===== */
.lg-card {
  margin-top: 8rpx;
  padding: 34rpx 32rpx;
}
.lg-lead {
  font-size: 26rpx;
  line-height: 1.85;
  color: var(--text);
  letter-spacing: 1rpx;
}
.lg-lead-2 { margin-top: 18rpx; color: var(--text2); }

/* ===== 三步 ===== */
.lg-steps { margin-top: 34rpx; }
.lg-step {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
}
.lg-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--stamp);
}
.lg-step-ic { width: 34rpx; height: 34rpx; }
.lg-step-body { margin-left: 22rpx; min-width: 0; }
.lg-step-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}
.lg-step-s {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text2);
}

/* ===== 「认不准是正常的」说明：浅底一张条，别做成警告框 ===== */
.lg-note {
  margin-top: 34rpx;
  padding: 26rpx 26rpx 28rpx;
  border-radius: 24rpx;
  background: var(--soft);
}
.lg-note-t {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text);
}
.lg-note-s {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: var(--text2);
}

/* ===== 页脚 ===== */
.lg-tail {
  margin-top: 56rpx;
  text-align: center;
}
.lg-tail-wave {
  width: 140rpx;
  height: 44rpx;
  opacity: 0.6;
}
.lg-tail-t {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--text2);
}
