<!-- pages/setting/setting.wxml —— 设置（v7.0 新建，7.2.0 L2 精简）
     只放真正的设置：外观主题 / 协议 / 关于 / 清除。
     AI 重绘额度与 13 枚勋章墙 7.2.0 迁去「我的 · 留存中心」——
     荣誉与余额塞在设置里的那两年，等于没人看见过。 -->
<!-- 7.4.0 动效：轻量进场（.fade-up，轻档 280ms / 16rpx，含减弱动态效果降级）。
     设置页没有 fixed 后代（整页就是一个滚动容器），transform 不会把谁拽偏。 -->
<scroll-view class="tk-page theme-{{theme}} st-page fade-up" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- ① 外观主题 -->
  <view class="st-card">
    <view class="st-title">外观主题</view>
    <view class="st-theme pressable" hover-class="press-item-hover" bindtap="goTheme"
          aria-role="button" aria-label="切换外观主题，当前 {{curTheme.name}}">
      <view class="st-theme-pv" style="background: {{curTheme.bg}};">
        <view class="st-theme-pv-card" style="background: {{curTheme.card}};">
          <view class="st-theme-pv-bar" style="background: {{curTheme.primary}};"></view>
          <view class="st-theme-pv-bar thin" style="background: {{curTheme.text}};"></view>
        </view>
      </view>
      <view class="st-theme-body">
        <view class="st-theme-name">{{curTheme.name}}</view>
        <view class="st-theme-desc">{{curTheme.tagline}}</view>
        <view class="st-theme-dots">
          <view class="st-theme-dot" wx:for="{{themeDots}}" wx:key="key"
                style="background: {{item.primary}}; opacity: {{item.key === theme ? 1 : 0.35}};"></view>
        </view>
      </view>
      <image class="st-go" src="{{ic.chevron}}" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <!-- ② 同场印记（隐私选项）
       这一条是协议里对外承诺过的「可随时退出参与」（protocol.js 的「信息的使用」），
       而入口从 me→setting 改版后就没了 —— 承诺了却做不到，比不写更糟。
       开关说的是「参与」、存的是「退出」（同场印记存的是 opt-out），取反只在
       setting.js 的 onSameMark 里做一次。 -->
  <view class="st-card">
    <view class="st-title">同场印记</view>
    <view class="st-switch-row">
      <view class="st-switch-body">
        <view class="st-switch-name">参与同场计数</view>
        <view class="st-switch-desc">按「场馆 + 日期」匿名统计这场演出被收藏了几次，只在详情页与卡片上显示一个数字，不含任何身份信息。关掉后，之后收藏的票根不再计入。</view>
      </view>
      <switch class="st-switch" checked="{{!sameOptOut}}" color="{{primary}}"
              bindchange="onSameMark" aria-label="参与同场印记" />
    </view>
  </view>

  <!-- ③ 协议 / 关于 / 清除 -->
  <view class="st-card">
    <view class="st-list">
      <view class="st-row pressable" hover-class="press-item-hover" wx:for="{{rows}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onRow" aria-role="button" aria-label="{{item.name}}">
        <image class="st-row-ic" src="{{item.ico}}" mode="aspectFit" aria-hidden="true" />
        <text class="st-row-name">{{item.name}}</text>
        <image class="st-go" src="{{ic.chevron}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>
  </view>

  <view class="st-icp pressable" hover-class="press-item-hover" bindtap="copyIcp" aria-role="button" aria-label="复制ICP备案号">粤ICP备20010271号-11X</view>
  <view class="tk-safe-bottom"></view>
</scroll-view>
