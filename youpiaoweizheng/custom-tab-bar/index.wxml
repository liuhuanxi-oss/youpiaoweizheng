<!-- custom-tab-bar/index.wxml —— v6.2 自定义 tabBar
     4 个线性图标 tab + 中央凸起圆形 + 号按钮（主色填充白图标）
     图标为内联 SVG，stroke/fill 直接读组件内声明的主题变量，随主题换色。 -->
<view class="bar theme-{{theme}}">

  <!-- 中央凸起相机钮（规范图：灰玫粉大圆 + 白描线相机，CSS 绘制） -->
  <view class="fab" hover-class="fab-hover" hover-stay-time="120" bindtap="goFab" aria-role="button" aria-label="拍一张新票根">
    <view class="fab-cam"></view>
  </view>

  <view class="row">
    <view
      wx:for="{{list}}"
      wx:key="idx"
      class="item {{selected === item.idx ? 'on' : ''}}"
      hover-class="item-hover" hover-stay-time="120"
      data-idx="{{item.idx}}"
      aria-role="tab"
      aria-label="{{item.text}}{{selected === item.idx ? '，当前所在' : ''}}"
      bindtap="switchTab"
    >
      <view class="ico">
        <!-- 首页 -->
        <svg wx:if="{{item.ico === 'home'}}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M3.5 10.5 L12 3.5 L20.5 10.5 V20 a1.4 1.4 0 0 1 -1.4 1.4 H4.9 A1.4 1.4 0 0 1 3.5 20 Z"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        <!-- 票夹（票根造型：齿孔 + 虚线） -->
        <svg wx:elif="{{item.ico === 'ticket'}}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 7.5 A1.5 1.5 0 0 1 4.5 6 H19.5 A1.5 1.5 0 0 1 21 7.5 V10 a2 2 0 0 0 0 4 V16.5 A1.5 1.5 0 0 1 19.5 18 H4.5 A1.5 1.5 0 0 1 3 16.5 V14 a2 2 0 0 0 0 -4 Z"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M14 8 V16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2 2"/>
        </svg>
        <!-- 发现（指南针） -->
        <svg wx:elif="{{item.ico === 'compass'}}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M15.4 8.6 L13.2 13.2 L8.6 15.4 L10.8 10.8 Z" fill="currentColor"/>
        </svg>
        <!-- 我的 -->
        <svg wx:else viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="8.2" r="3.8" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M4.5 20.4 c0-4 3.4-6.4 7.5-6.4 s7.5 2.4 7.5 6.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </view>
      <text class="txt">{{item.text}}</text>
    </view>
  </view>
</view>
