  --cat-show: #D9A0A6; --cat-movie: #F6DFA8; --cat-transport: #A9C3A6; --cat-travel: #F4C6B4;
  --hero-top: #E8F0E6; --hero-mid: #F6FAF5;
}

/* —— minimal · 极简留白：纯白 + 大字 + 细线 —— */
.theme-minimal {
  --bg: #FFFFFF;
  --card: #FFFFFF;
  --primary: #1A1A1A;     /* 近黑（实底 / 选中） */
  --accent: #D9A0A6;      /* 单点灰玫粉 */
  --soft: #F5F5F5;
  --text: #1A1A1A;
