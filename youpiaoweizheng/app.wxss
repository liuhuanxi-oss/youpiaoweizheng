/* ============================================
   app.wxss —— 全局设计系统「纸质收藏册」
   所有颜色/字体通过 CSS 变量统一管理，
   任何页面想换肤，只需覆盖 page 级变量。
   ============================================ */

page {
  /* —— 色板（默认 = A 纸质收藏册）—— */
  --paper: #FDFBF7;        /* 页面底色：米白纸面 */
  --card: #FFFEFB;         /* 卡片：暖纸白 */
  --ink: #2C2C2C;          /* 主文字：深墨 */
  --ink-soft: #8B7D6B;     /* 次级文字：褐灰 */
  --ink-faint: #B5A99A;    /* 弱文字：浅褐 */
  --line: #E8E4DD;         /* 分割线/描边 */
  --line-strong: #DBD4C8;  /* 较重的描边 */
  --accent: #C4623A;       /* 强调：印章橘红 */
  --accent-deep: #A94F2B;  /* 强调按下/深态 */
  --gold: #B98D52;         /* 点缀：勋章金 */
  --gold-deep: #96713A;    /* 深金（时光机文字） */
  --blue: #4A6A7A;         /* 电影类型标签 */
  --cream: #FDF6EC;        /* 深底按钮上的奶油字 */
  --bright: #FFFEFB;       /* 亮底（tab 栏/输入条） */
  --softbg: #F4EFE7;       /* 浅色次级底 */
  --tag-show-bg: #F4DFD3;  /* 演出标签底 */
  --tag-movie-bg: #DEE6E2; /* 电影标签底 */
  --tag-traffic-bg: #EFE8D8; /* 交通标签底 */
  --shadow-rgb: 44, 44, 44; /* 阴影基色（rgb 三元组） */
  --accent-rgb: 196, 98, 58; /* 强调色 rgb 三元组（半透明阴影/底） */
  --tm1: #F6EFE2;          /* 时光机渐变起 */
  --tm2: #EEDFC6;          /* 时光机渐变止 */

  /* —— 4.9.7 展示台两档渐变（纸票/取景衬底，替代直接引用 --ink 当底色）—— */
  --stage-1: #2C2C2C;      /* 照片/取景衬底渐变起（A 墨色） */
  --stage-2: #1D1713;      /* 衬底渐变止 */

  /* —— 4.12.0 动效曲线 token（全项目统一两族缓动）—— */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1); /* 弹性：FAB 子钮弹出/印章落下等「落定感」动效 */
  --ease-smooth: cubic-bezier(0.32, 0.72, 0, 1);    /* 平滑：页面进场/弹层/展开收起 */

  /* —— 字号 —— */
  --fs-xs: 20rpx;
  --fs-sm: 22rpx;
  --fs-md: 26rpx;
  --fs-lg: 30rpx;
  --fs-xl: 34rpx;
  --stub-bg: #FBF6EB;          /* 票卡副券底（比 card 深一档的米） */
  --tape: rgba(236, 219, 177, 0.55); /* 胶带：米黄半透明 */
  --sk-1: #E9E0D0;  --sk-2: #F6F0E4;  /* 骨架流光 */
  --r-card: 24rpx; --r-item: 16rpx;    /* V2 圆角 token */
  --card-shadow: 0 6rpx 18rpx rgba(44, 44, 44, 0.08); /* 票卡投影 */
  --sheet: #FFFEFB;            /* 弹层面板（需不透明） */
}

/* ============================================
   4.9.0 三主题系统（用户自主切换，utils/theme.js）
   页面根节点挂 theme-b / theme-c 即整页换肤；
   默认（无 class / theme-a）= A 纸质收藏册。
   ============================================ */

/* B · 午夜现场：深色底 + 霓虹粉紫 */
.theme-b {
  --paper: #0F0F1A;
  --card: #1A1A2E;
  --ink: #F0EDE8;
  --ink-soft: #9B95A8;
  --ink-faint: #837C99;    /* 4.9.7 提亮：#6E638E 在深底对比仅 3.8:1，说明文字吃力 */
  --line: rgba(255, 255, 255, 0.08);
  --line-strong: rgba(255, 255, 255, 0.16);
  --accent: #FF6B9D;
  --accent-deep: #E2567F;
  --gold: #B07FE8;
  --gold-deep: #CFB3FF;
  --blue: #8FB4EA;
  --cream: #0F0F1A;
  --bright: #202038;
  --softbg: #22223A;
  --tag-show-bg: rgba(255, 107, 157, 0.16);
  --tag-movie-bg: rgba(143, 180, 234, 0.16);
  --tag-traffic-bg: rgba(176, 127, 232, 0.16);
  --shadow-rgb: 0, 0, 0;
  --accent-rgb: 255, 107, 157;
  --tm1: #262647;
  --tm2: #1F1F3A;
  --stage-1: #1A1A2E;      /* B 衬底：深紫渐变（4.9.7，避免纸票衬底变白） */
  --stage-2: #0A0A16;
  --stub-bg: #23203A;
  --tape: transparent; /* B 不用胶带（霓虹代替） */
  --grad-neon: linear-gradient(135deg, #FF6B9D, #B07FE8); /* 霓虹渐变标题/按钮 */
  --glow: 0 0 24rpx rgba(255, 107, 157, 0.15); /* 卡片霓虹外发光 */
  --sk-1: #23203A;  --sk-2: #2E2A4A;
  --r-card: 18rpx; --r-item: 12rpx;
  --card-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.45), 0 0 24rpx rgba(255, 107, 157, 0.12); /* 霓虹外发光 */
  --sheet: #1A1A2E;
}

/* C · 手账水彩：抹茶绿 + 蜜桃橘 */
.theme-c {
  --paper: #FFF9F0;
  --card: rgba(255, 254, 247, 0.88); /* 半透明：透出水彩晕染 */
  --ink: #5A4E42;
  --ink-soft: #9B8E7E;
  --ink-faint: #B3A79A;
  --line: #EDE5D8;
  --line-strong: #E0D5C2;
  --accent: #95B088;
  --accent-deep: #7E9C73;
  --gold: #F0A888;
  --gold-deep: #D98B68;
  --blue: #8FA8C4;
  --cream: #FFFEF7;
  --bright: #FFFDF4;
  --softbg: rgba(246, 238, 223, 0.8);
  --tag-show-bg: rgba(149, 176, 136, 0.16);
  --tag-movie-bg: rgba(176, 196, 222, 0.20);
  --tag-traffic-bg: rgba(240, 168, 136, 0.18);
  --shadow-rgb: 90, 78, 66;
  --accent-rgb: 149, 176, 136;
  --tm1: rgba(248, 236, 217, 0.78); /* 半透明：水彩渐层透出晕染 */
  --tm2: rgba(242, 223, 199, 0.72);
  --stage-1: #C9D8BE;      /* C 衬底：墨绿渐变 */
  --stage-2: #B7CBA8;
  --stub-bg: #F3EBDC;
  --tape: rgba(240, 168, 136, 0.28); /* 蜜桃胶带 */
  --grad-tea: linear-gradient(135deg, #95B088, #F0A888); /* 抹茶→蜜桃 */
  --sk-1: #EDE3D2;  --sk-2: #F8F1E4;
  --r-card: 40rpx; --r-item: 32rpx;
  --card-shadow: 0 8rpx 20rpx rgba(149, 176, 136, 0.12);
  --sheet: #FFFEF7;
}

/* 页面根容器：铺满 + 随主题底色（盖住 page 级默认背景）；relative 供 wash-layer 定位 */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--bg, var(--paper));
  color: var(--text, var(--ink));
}
.page-scroll { position: relative; }

/* 全局页面底色 */
page {
  background: var(--paper);
  color: var(--ink);
  font-size: var(--fs-md);
  line-height: 1.6;
}

/* 衬线标题字：只在标题/票名/仪式性文字上使用 */
.serif {
  font-family: "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
  font-weight: 700;
}

/* —— 通用卡片（随六主题分化：底/圆角/描边/毛玻璃/投影） —— */
.card {
  background: var(--card-bg, var(--card));
  border-radius: var(--card-r, 28rpx);
  border: var(--card-border, none);
  box-shadow: var(--card-shadow, 0 6rpx 20rpx rgba(var(--shadow-rgb), 0.07));
  backdrop-filter: var(--card-blur, none);
  -webkit-backdrop-filter: var(--card-blur, none);
}

/* —— 类型标签 —— */
.tag {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}
.tag-show   { background: var(--chip, var(--tag-show-bg)); color: var(--primary, var(--accent)); }
.tag-movie  { background: var(--chip, var(--tag-movie-bg)); color: var(--cat-movie, var(--blue)); }
.tag-traffic{ background: var(--chip, var(--tag-traffic-bg)); color: var(--cat-transport, var(--gold-deep)); }

/* —— 主按钮（墨色）/ 强调按钮（橘红） —— */
.btn-main {
  margin: 28rpx 36rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 28rpx;
  background: var(--primary, var(--ink));
  color: var(--on-primary, var(--cream));
  font-size: 30rpx;
  letter-spacing: 6rpx;
}
.btn-main.accent {
  background: var(--accent);
  box-shadow: 0 12rpx 32rpx rgba(var(--accent-rgb), 0.32);
}
.btn-ghost {
  margin: 20rpx 36rpx 0;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 28rpx;
  border: 2rpx solid var(--border, var(--line));
  color: var(--text2, var(--ink-soft));
  font-size: 26rpx;
  letter-spacing: 4rpx;
  background: transparent;
}

/* —— 通用区块标题 —— */
.sec-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 0 4rpx 20rpx;
}
.sec-title .t {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: var(--text, var(--ink));
}
.sec-title .s {
  font-size: 22rpx;
  color: var(--text2, var(--ink-faint));
}

/* 条形码（视觉母题之一） */
.barcode {
  height: 44rpx;
  background: repeating-linear-gradient(
    90deg,
    var(--text, var(--ink)) 0 4rpx, transparent 4rpx 10rpx,
    var(--text, var(--ink)) 10rpx 12rpx, transparent 12rpx 22rpx,
    var(--text, var(--ink)) 22rpx 28rpx, transparent 28rpx 34rpx
  );
  opacity: 0.85;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
  color: var(--text2, var(--ink-faint));
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.empty .big { font-size: 64rpx; margin-bottom: 20rpx; }

/* —— 4.21.0 广告位装裱（全项目统一：平台 ad 组件样式不可改，用纸卡容器 + 眉题「装裱」，
      theme-b 深色主题下广告自带白底时呈现为画框而非裸贴补丁）—— */
.ad-cap {
  font-size: 18rpx;
  color: var(--text2, var(--ink-faint));
  letter-spacing: 3rpx;
  padding: 0 4rpx 8rpx;
}

/* ============================================
   M4.5 交互层（P0 批次）
   ============================================ */

/* —— 通用按压反馈（配合 hover-class 使用）——
   v6.6.0 动效2「按压回弹」物理手感口径：
   · 按下：scale(0.94)，100ms（transition 取自按下态类）
   · 抬起：250ms cubic-bezier(0.34, 1.56, 0.64, 1) 弹性回冲——该曲线 y>1 段
     自带约 1.04 的过冲再落回 1（先过冲 80ms 量级、再回弹 120ms 量级），
     transition 插值天然防「动画叠影」，长按/连点不会重复叠加
   · 按钮/胶囊用 press-hover，列表项/卡片用 press-item-hover（幅度略柔 0.96）
   · prefers-reduced-motion：去掉位移缩放，只保留 opacity 淡变
   禁用态：.disabled（透明度 0.4，无按压） */
.pressable {
  transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 150ms ease-out;
  cursor: pointer; /* 4.12.0 桌面端（PC 微信）手型光标，移动端无影响 */
}
.press-hover {
  transform: scale(0.94);
  opacity: 0.88;
  transition: transform 100ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 100ms ease-out;
}
.press-item-hover {
  transform: scale(0.96);
  opacity: 0.92;
  transition: transform 100ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 100ms ease-out;
}
.disabled { opacity: 0.4; }

/* v6.6.0：reduced-motion 降级——按压只做 opacity 淡变，无缩放位移 */
@media (prefers-reduced-motion: reduce) {
  .pressable { transition: opacity 150ms ease-out; }
  .press-hover, .press-item-hover { transform: none; }
}

/* —— 骨架屏（公共骨料）——
   v6.6.0 动效3口径：奶油灰块 + opacity 1→0.5 呼吸（1.2s 一来回），
   替代旧的位移流光（shimmer）；reduced-motion 下呼吸停在最淡、由数据替换时的
   .fade-in-200 淡入接管 */
.skeleton-bone {
  background: var(--soft, #F5EDE2);
  animation: sk-breath 1.2s ease-in-out infinite;
  border-radius: 12rpx;
}
@keyframes sk-breath {
  0%   { opacity: 1; }
  50%  { opacity: 0.5; }
  100% { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .skeleton-bone { animation: none; opacity: 0.6; }
}

/* —— v6.6.0 公共过渡：真实数据替换骨架时 200ms 淡入（无高度跳动） —— */
.fade-in-200 { animation: fade-in-200 200ms ease-out both; }
@keyframes fade-in-200 {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .fade-in-200 { animation-duration: 120ms; } /* 仍保留 opacity 过渡（允许） */
}

/* —— v6.6.0 公共：失败红抖（一次） —— */
@keyframes shake-err {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(4rpx); }
}
@media (prefers-reduced-motion: reduce) {
  @keyframes shake-err {
    0%, 100% { transform: translateX(0); }
  }
}

/* —— 骨架让位后的内容淡入（200ms）—— */
.fade-in { animation: sk-fadein 200ms ease-out both; }
@keyframes sk-fadein {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* —— 自定义下拉头（album / duo / me 三处共用）——
   配合 scroll-view 的 refresher-default-style="none" 使用：原生转圈关了，这里就是唯一的下拉反馈。
   ⚠️ 想用它，滚动容器必须是**固定高度**（height:100vh）。用 min-height 的话容器被内容撑高、
      内部根本不会滚，refresher 就永远触发不了 —— 下拉会毫无反应。
   只有一行字，不给自己加戏（稿里没有下拉这个动作）。 */
.refresher { display: flex; align-items: center; justify-content: center; height: 150rpx; }
.rf-text { font-size: 20rpx; letter-spacing: 3rpx; color: var(--text2, #8A7E6E); }

/* —— M4.8 二级页统一进场（上滑淡入，与弹出层同一缓动体系）——
   7.2.0 起 tab 页也挂这个类；重播由 utils/enter.js 负责（tab 页常驻内存，动画不会自己重来）。
   ⚠️ fill 是 both，动画结束后 transform 会留在节点上 —— 它会成为后代 position:fixed 的包含块。
      目前各页的 fixed 元素要么在根节点之外（discover 的面板、bottom-sheet），
      要么本来就在屏外（annual 的导出画布），没有可见影响；将来往里塞 fixed 元素时记得先看这条。 */
.fade-up { animation: page-fadeup 280ms var(--ease-smooth) both; }
@keyframes page-fadeup {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  /* 与 .pressable 同一个口径：只留淡变，去掉位移（位移会让前庭敏感的用户不适） */
  @keyframes page-fadeup {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
}

/* ============================================
   4.10.1 重装饰系统（逐页一致）
   .grain      —— 纸面噪点（A/C 灰纸纹；B 反相成星尘）
   .wash-layer —— 水彩晕染头（仅 C，多层低饱和 radial）
   ============================================ */

/* —— 纸面噪点：SVG feTurbulence 细颗粒，盖在内容上层 4~6%，pointer 穿透 —— */
.grain {
  position: fixed;
  inset: 0;
  z-index: 999;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27160%27%20height%3D%27160%27%3E%3Cfilter%20id%3D%27n%27%3E%3CfeTurbulence%20type%3D%27fractalNoise%27%20baseFrequency%3D%270.6%27%20numOctaves%3D%272%27%20stitchTiles%3D%27stitch%27%2F%3E%3CfeColorMatrix%20type%3D%27matrix%27%20values%3D%270%200%200%200%200.55%20%200%200%200%200%200.55%20%200%200%200%200%200.55%20%201%200%200%200%200%27%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%27160%27%20height%3D%27160%27%20filter%3D%27url%28%23n%29%27%20opacity%3D%270.85%27%2F%3E%3C%2Fsvg%3E");
  background-repeat: repeat;
  opacity: 0.05;
}
.theme-b .grain { opacity: 0.06; filter: invert(1); } /* 深色页：噪点反相成微白星尘 */
.theme-c .grain { opacity: 0.05; }
.theme-a .grain { opacity: 0.05; }

/* —— 水彩晕染头（C 专属；抹茶/蜜桃/雾蓝三层透亮）—— */
.wash-layer {
  display: none;
}
.theme-c .wash-layer {
  display: block;
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 420rpx;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(340rpx 240rpx at 12% 6%,  rgba(149, 176, 136, 0.42), transparent 68%),
    radial-gradient(420rpx 260rpx at 86% 14%, rgba(240, 168, 136, 0.34), transparent 66%),
    radial-gradient(300rpx 220rpx at 62% 30%, rgba(176, 196, 222, 0.30), transparent 70%),
    radial-gradient(240rpx 180rpx at 30% 44%, rgba(218, 205, 170, 0.22), transparent 72%);
  filter: blur(1rpx);
}

/* —— 4.10.1：C 主题卡片水彩光斑（通透：叠在卡片底色上的柔光与颜料尾迹）—— */
.theme-c .card {
  background-image:
    radial-gradient(140% 90% at 88% -6%, rgba(255, 255, 255, 0.85), transparent 52%),
    radial-gradient(120% 70% at 4% 108%, rgba(240, 168, 136, 0.20), transparent 58%),
    radial-gradient(90% 60% at 92% 110%, rgba(149, 176, 136, 0.18), transparent 60%);
}

/* =============================================================
   v6.5 六主题系统（8 套风格方案保留 1/2/4/5/6/8）
   paper 纸感杂志 / glass 柔和玻璃 / collage 手账拼贴
   film 胶片电影 / literary 清新文艺 / minimal 极简留白
   页面根节点挂 theme-{{theme}} 即整页换肤；Storage key = app_theme，默认 paper。
   兼容令牌：--bg/--card/--primary/--accent/--soft/--text/--text2/
             --border/--on-primary/--chip/--radius + 分类辅助色
   差异维度（6 套风格分化）：--font-title/--card-bg/--card-blur/
             --card-border/--card-shadow/--card-r/--btn-r/--page-deco/--page-deco-size
   ⚠️ 与上文 theme-a/b/c（纸感三主题）并存：a/b/c 供 detail/card/art/annual
   等深色 Canvas 页继续使用；六主题供 v6 全部新页面使用。
   ============================================================= */

/* —— paper · 纸感杂志：米白纸底 + 衬线刊头 + 墨黑 —— */
.theme-paper {
  --bg: #F5F0E6;
  --card: #FFFFFF;
  --primary: #2B2420;     /* 墨黑（实底按钮 / 选中态） */
  --accent: #C26B5E;      /* 邮政红（点缀） */
  --soft: #E9E2D4;
  --text: #2B2420;
  --text2: #8A7E6E;
  --text-rgb: 43, 36, 32;
  --border: #E2D9C7;
